---

<BaseLayout title="Notes">
  <div class="notes-index">
    <h1>Notes</h1>

    <p>
      Thinking, frameworks, and drafts.
      These notes document how experiments are designed,
      interpreted, and turned into reusable knowledge.
    </p>

    <nav aria-label="Browse note topics">
      <ul class="notes-topics">
        {groups.map(group => (
          <li><a href={`#${group.id}`}>{group.title}</a></li>
        ))}
      </ul>
    </nav>

    {groups.map(group => (
      <section aria-labelledby={group.id}>
        <h2 id={group.id}>{group.title}</h2>
        <p class="group-description">{group.description}</p>
        <ul class="notes-list">
          {notes.filter(note => note.group === group.id).map(note => (
            <li>
              <a href={`/notes/${note.slug}/`}>{note.title}</a>
              <small>{note.status}</small>
              <p>{note.description}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .notes-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 1.5rem 0 2rem;
    padding: 0;
  }

  .notes-topics li {
    margin: 0;
  }

  .notes-topics a {
    display: block;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.9rem;
    text-decoration: none;
  }

  .notes-topics a:hover {
    text-decoration: underline;
  }

  .notes-index a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .notes-index section {
    margin-top: 2.5rem;
  }

  .group-description,
  .notes-list small {
    color: var(--muted);
  }

  .notes-list {
    list-style: none;
    padding: 0;
  }

  .notes-list li {
    border-bottom: 1px solid var(--line);
    margin: 0;
    padding: 1rem 0;
  }

  .notes-list a {
    font-weight: 600;
  }

  .notes-list small {
    display: block;
    margin-top: 0.25rem;
  }

  .notes-list p {
    margin: 0.5rem 0 0;
  }
</style>
