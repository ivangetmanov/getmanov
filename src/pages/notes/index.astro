---
import BaseLayout from "../../layouts/BaseLayout.astro";

// собираем все markdown-файлы в этой папке
const notes = await Astro.glob("./*.md");

// сортировка по дате (новые сверху)
notes.sort(
  (a, b) =>
    new Date(b.frontmatter.pubDate) -
    new Date(a.frontmatter.pubDate)
);
---

<BaseLayout
  title="Notes — getmanov.com"
  description="Notes, drafts, and frameworks. Built to be searchable and citeable."
>
  <section class="container page">
    <h1>Notes</h1>
    <p class="lead">
      Short notes, frameworks, and drafts. Evidence-first. Built for reuse.
    </p>

    <div class="grid">
      {notes.map((note) => (
        <a class="card" href={note.url}>
          <div class="card-title">
            {note.frontmatter.title}
          </div>

          {note.frontmatter.description && (
            <div class="card-desc">
              {note.frontmatter.description}
            </div>
          )}
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
