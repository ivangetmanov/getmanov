---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const storeUrl =
  "https://chromewebstore.google.com/detail/chatgpt-session-saver/negkdfmbiophoipcalliiemalkghlidj/";
const reviewUrl =
  "https://chromewebstore.google.com/detail/chatgpt-session-saver/negkdfmbiophoipcalliiemalkghlidj/reviews";
const title =
  "ChatGPT Session Saver - Save and Export Long ChatGPT Conversations";
const description =
  "Save, search, and export long ChatGPT conversations as clean Q&A pairs and TXT files. Install ChatGPT Session Saver from the Chrome Web Store.";
const canonical = "/tools/session-saver/";

const features = [
  {
    title: "Entire Chat export",
    text: "Save a long conversation as Q&A pairs, including older history that ChatGPT loads as you scroll.",
  },
  {
    title: "Last 10, 20 or 30 pairs",
    text: "Save just the latest Question & Answer pairs when you only need the recent part of a conversation.",
  },
  {
    title: "Current Position Up or Down",
    text: "Start where you are reading. Choose Up for earlier messages or Down for the messages that follow.",
  },
  {
    title: "Save across multiple tabs",
    text: "Start an independent export in each ChatGPT tab. Each conversation keeps its own job and progress.",
  },
  {
    title: "Close the popup, keep saving",
    text: "Keep the original ChatGPT tab open while you work elsewhere. Reopen the popup to see the saved progress.",
  },
  {
    title: "Recover a saved run",
    text: "Restore an available saved run to review its recovered Q&A pairs and export them as TXT.",
  },
  {
    title: "Search Questions & Answers",
    text: "Review separate Questions and Answers columns, search each one, and jump between matching passages.",
  },
  {
    title: "Copy or export TXT",
    text: "Copy Questions or Answers separately, or save the Q&A result as a searchable local TXT file.",
  },
];

const useCases = [
  ["Researchers", "Preserve interviews, literature reviews, and exploratory analysis."],
  ["Developers", "Keep debugging sessions, architecture discussions, and code explanations."],
  ["Students", "Save tutoring sessions, study notes, and detailed explanations."],
  ["AI power users", "Build a searchable archive instead of losing valuable conversations."],
  ["Knowledge workflows", "Move useful Q&A into notes, documentation, or a personal knowledge base."],
  ["Long-term ChatGPT users", "Keep important threads accessible beyond the ChatGPT sidebar."],
];

const faqItems = [
  {
    question: "How do I export a long ChatGPT conversation?",
    answer:
      "Open your conversation and launch ChatGPT Session Saver. Choose Entire Chat, the last 10, 20 or 30 Q&A pairs, or Current Position Up or Down, then start saving. Keep the original ChatGPT tab open, review the extracted pairs, and export them as a TXT file.",
  },
  {
    question: "How do I save an entire ChatGPT chat?",
    answer:
      "Select Entire Chat. Version 2.65 improves extraction of long conversations where ChatGPT loads older history or shows only part of the chat at a time. The result is saved locally as Q&A pairs. Some messages may still be unavailable during extraction, so check the result for completeness before relying on it as an archive.",
  },
  {
    question: "Can I export ChatGPT to TXT?",
    answer:
      "Yes. Export the extracted Question & Answer pairs as a local TXT file that is easy to search, edit, archive, and reuse. You can also copy Questions or Answers separately from their columns.",
  },
  {
    question: "What is the best way to save ChatGPT conversations?",
    answer:
      "For a reusable copy of one active conversation, a structured local text export is usually more practical than screenshots or manual copy-paste because it preserves the Q&A flow and remains searchable.",
  },
  {
    question: "Does ChatGPT support exporting individual chats?",
    answer:
      "ChatGPT provides account-level data export and conversation sharing. Session Saver is designed for saving one active conversation directly as a local, structured TXT file.",
  },
  {
    question: "Can I close the popup while saving?",
    answer:
      "Yes. The extraction job continues when you close the popup or switch tabs, as long as the original ChatGPT tab stays open. Reopen the popup to restore the progress view. Processing pauses while your computer sleeps and resumes after it wakes.",
  },
  {
    question: "Can I save conversations from multiple ChatGPT tabs?",
    answer:
      "Yes. Each ChatGPT tab can run its own independent extraction job. Start saving in each tab and return to that tab's popup to check its progress. Keep the original tabs open while their jobs run.",
  },
  {
    question: "Can I recover a previous run?",
    answer:
      "When a saved run is available, you can select it in the extension to restore its saved Q&A content for review and TXT export. An interrupted run may contain only the pairs saved before the interruption; recovery does not guarantee a complete conversation.",
  },
  {
    question: "Does Session Saver send my conversations to a server?",
    answer:
      "No. Conversation text, questions, answers, titles, conversation URLs and conversation IDs are processed locally and are not sent to the developer's servers. Optional usage and performance analytics are off by default, require your explicit opt-in, and can be disabled at any time. Those events do not include conversation content.",
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      name: "ChatGPT Session Saver",
      applicationCategory: "BrowserApplication",
      operatingSystem: "Chrome",
      description,
      url: "https://getmanov.com/tools/session-saver/",
      installUrl: storeUrl,
      author: {
        "@type": "Person",
        name: "Ivan Getmanov",
        url: "https://getmanov.com",
      },
    },
    {
      "@type": "FAQPage",
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer,
        },
      })),
    },
  ],
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  ></script>

  <section class="session-saver-page">
    <div class="hero-shell">
      <div class="hero-copy">
        <a class="store-status" href={storeUrl} target="_blank" rel="noreferrer" data-cta-location="hero_store_status">
          <span aria-hidden="true">✓</span>
          Available on Chrome Web Store
        </a>
        <h1>Save and Export Long ChatGPT Conversations</h1>
        <p class="lead">
          Turn long ChatGPT chats into clean Question &amp; Answer exports.
          Save the whole chat or just the part you need, then search, copy,
          and export it as a local TXT file.
        </p>
        <div class="hero-actions">
          <a
            class="button button--primary"
            href={storeUrl}
            target="_blank"
            rel="noreferrer"
            data-cta-location="hero_install"
          >
            Install from Chrome Web Store
            <span aria-hidden="true">↗</span>
          </a>
          <a class="button button--secondary" href="#features">View Features</a>
        </div>
        <p class="hero-note">
          Free Chrome extension from the official Chrome Web Store. No ChatGPT API key,
          external account, or manual ZIP setup required.
        </p>
      </div>

      <div class="hero-visual">
        <img
          src="/images/tools/session-saver/session-saver-hero.webp"
          alt="ChatGPT Session Saver turning a long conversation into clean Q&A pairs"
          width="1800"
          height="1132"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>

    <section class="trust-strip" aria-label="Product trust signals">
      <a href={storeUrl} target="_blank" rel="noreferrer" data-cta-location="trust_strip_listing">
        <span>Official listing</span>
        <strong>Available on Chrome Web Store</strong>
      </a>
      <div>
        <span>Privacy-first</span>
        <strong>Chats are processed locally</strong>
      </div>
      <div>
        <span>Simple setup</span>
        <strong>No API key or extra account</strong>
      </div>
    </section>

    <section id="features" class="section features-section">
      <div class="section-heading">
        <p class="eyebrow">What's new · September 2026 · v2.65</p>
        <h2>Save the knowledge hidden inside long ChatGPT chats</h2>
        <p>
          Version 2.65 improves reliability when ChatGPT loads older history or
          shows only part of a long conversation at a time. Choose how much to
          save, work across tabs, and return to your saved progress.
        </p>
      </div>

      <div class="feature-grid">
        {features.map((feature, index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{feature.title}</h3>
            <p>{feature.text}</p>
          </article>
        ))}
      </div>
      <aside class="reliability-note" aria-label="Long conversation test result">
        <p><strong>584 Q&A pairs in a real manual test.</strong></p>
        <p>
          One very long conversation produced an export containing 584 pairs.
          This is a test result, not a guarantee that every historical message
          in every long chat can be extracted. Check your saved result for completeness.
        </p>
      </aside>
    </section>

    <section id="workflow" class="section workflow-section">
      <div class="section-heading">
        <p class="eyebrow">See the workflow</p>
        <h2>From an active ChatGPT thread to a local TXT file</h2>
        <p>
          Choose your export scope, then review Questions and Answers in
          separate columns. Search and navigate between matches, copy either
          column, or export the result as TXT.
        </p>
      </div>
      <div
        class="case-gallery product-workflow-gallery"
        aria-label="ChatGPT Session Saver export workflow"
      >
        <img src="/images/tools/session-saver/workflow/01-choose-export-scope.webp" alt="Export scope menu with Entire Chat, Last 10, 20 or 30 pairs, and Current Position Up or Down" width="1280" height="765" loading="lazy" />
        <img src="/images/tools/session-saver/workflow/02-extraction-in-progress.webp" alt="ChatGPT Session Saver extracting questions and answers from a long conversation" width="1280" height="768" loading="lazy" />
        <img src="/images/tools/session-saver/workflow/03-review-qa-pairs.webp" alt="Search and review extracted ChatGPT questions and answers before export" width="1280" height="768" loading="lazy" />
        <img src="/images/tools/session-saver/workflow/04-export-txt.webp" alt="ChatGPT conversation exported and downloaded as a TXT file" width="1230" height="800" loading="lazy" />
        <img src="/images/tools/session-saver/workflow/05-open-local-txt.webp" alt="A saved ChatGPT conversation opened as a local structured TXT file" width="1280" height="744" loading="lazy" />
      </div>
    </section>

    <section class="section use-cases-section">
      <div class="section-heading">
        <p class="eyebrow">Who it helps</p>
        <h2>Perfect for work that continues beyond one chat</h2>
      </div>
      <div class="use-cases-grid">
        {useCases.map(([title, text]) => (
          <article>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section split-card">
      <div>
        <p class="eyebrow">Privacy-first by design</p>
        <h2>Your conversations stay on your device</h2>
        <p>
          Session Saver processes conversation content locally in your browser.
          It does not send conversation text, questions, answers, titles,
          conversation URLs or conversation IDs to the developer's servers.
        </p>
        <p>
          Optional usage and performance analytics are <strong>off by default</strong>.
          They require your explicit opt-in, can be disabled at any time,
          and do not include conversation content.
        </p>
        <a class="text-link" href="/tools/session-saver/privacy-policy/">
          Read the Privacy Policy
        </a>
      </div>
      <img
        src="/images/tools/session-saver/session-saver-ui.webp"
        alt="ChatGPT Session Saver interface showing export progress and separate Questions and Answers"
        width="1520"
        height="1190"
        loading="lazy"
      />
    </section>

    <section class="section guide-card">
      <p class="eyebrow">Need a method comparison?</p>
      <h2>Choose the right way to save a long ChatGPT conversation</h2>
      <p>
        Compare official account export, shared links, PDF, manual copy-paste,
        and structured local TXT export.
      </p>
      <a class="text-link" href="/notes/export-long-chatgpt-chats/">
        Read the complete ChatGPT export guide
      </a>
      <a class="text-link" href="/notes/export-single-chatgpt-conversation/" data-cta-location="single_chat_export_guide">
        Learn how to export a single ChatGPT conversation
      </a>
    </section>

    <section class="section faq">
      <p class="eyebrow">FAQ</p>
      <h2>Saving and exporting ChatGPT conversations</h2>
      {faqItems.map((item, index) => (
        <details open={index === 0}>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </section>

    <section class="section review-card">
      <div class="review-icon" aria-hidden="true">★</div>
      <div>
        <p class="eyebrow">Enjoying Session Saver?</p>
        <h2>Help other ChatGPT users find it</h2>
        <p>
          If the extension helped you save or export your chats, please leave a
          short review on the Chrome Web Store.
        </p>
      </div>
      <a
        class="button button--primary"
        href={reviewUrl}
        target="_blank"
        rel="noreferrer"
        data-cta-location="review_request"
      >
        Leave a Chrome Web Store Review
      </a>
    </section>

    <section class="section support-card">
      <span class="support-heart" aria-hidden="true">♥</span>
      <div>
        <p class="eyebrow">Support development</p>
        <h2>Want to help the project grow?</h2>
        <p>
          Installing, sharing, and reviewing Session Saver already makes a real
          difference. A direct support option may be added here later.
        </p>
      </div>
      <a class="text-link" href={reviewUrl} target="_blank" rel="noreferrer" data-cta-location="support_review">
        Support with a review
      </a>
    </section>

    <section class="creator-card">
      <p><strong>Built by Ivan Getmanov</strong></p>
      <p>
        Independent product focused on helping people organize and preserve
        ChatGPT conversations.
      </p>
      <a href="https://getmanov.com">getmanov.com</a>
    </section>
  </section>

  <style>
    :global(.prose:has(.session-saver-page)) {
      max-width: none;
      padding: 0;
      font-size: 18px;
      line-height: 1.55;
    }

    .session-saver-page {
      --ink: #091426;
      --muted: #627085;
      --line: #dce7f1;
      --panel: rgba(255, 255, 255, 0.78);
      --green: #36a873;
      --green-dark: #147553;
      --blue: #2f5eea;
      color: var(--ink);
      background:
        radial-gradient(circle at 8% 8%, rgba(54, 168, 115, 0.18), transparent 28%),
        radial-gradient(circle at 90% 0%, rgba(47, 94, 234, 0.13), transparent 26%),
        linear-gradient(180deg, #f7fbff 0%, #eef8f3 52%, #ffffff 100%);
      margin: -34px 0;
      padding: 48px 20px 72px;
    }

    .session-saver-page a {
      color: inherit;
    }

    .hero-shell,
    .trust-strip,
    .section,
    .creator-card {
      max-width: 1180px;
      margin-right: auto;
      margin-left: auto;
    }

    .hero-shell {
      display: grid;
      grid-template-columns: minmax(0, 0.98fr) minmax(420px, 1.02fr);
      gap: 40px;
      align-items: center;
      padding: 34px 0 44px;
    }

    .hero-copy,
    .hero-visual {
      min-width: 0;
    }

    .store-status {
      display: inline-flex;
      gap: 9px;
      align-items: center;
      margin-bottom: 20px;
      color: var(--green-dark);
      font-size: 14px;
      font-weight: 900;
      text-decoration: none;
    }

    .store-status span {
      width: 25px;
      height: 25px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: var(--green-dark);
      color: #fff;
    }

    .eyebrow {
      margin: 0 0 12px;
      color: var(--green-dark);
      font-size: 13px;
      font-weight: 900;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    h1,
    h2,
    h3,
    p {
      margin-top: 0;
    }

    .hero-copy h1 {
      max-width: 650px;
      margin-bottom: 20px;
      font-size: clamp(44px, 4.9vw, 70px);
      line-height: 0.94;
      letter-spacing: -0.06em;
      text-wrap: balance;
    }

    .lead {
      max-width: 720px;
      color: var(--muted);
      font-size: clamp(21px, 2.2vw, 29px);
      line-height: 1.22;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 28px;
    }

    .hero-note {
      max-width: 680px;
      margin: 14px 0 0;
      color: var(--muted);
      font-size: 15px;
      line-height: 1.45;
    }

    .button {
      display: inline-flex;
      gap: 9px;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: #fff;
      color: var(--ink);
      font-weight: 850;
      padding: 13px 19px;
      text-decoration: none;
      transition: transform 150ms ease, box-shadow 150ms ease;
    }

    .button:hover {
      transform: translateY(-2px);
      opacity: 1;
    }

    .session-saver-page .button--primary {
      border-color: var(--green-dark);
      background: var(--green-dark);
      color: #fff;
      box-shadow: 0 14px 34px rgba(20, 117, 83, 0.2);
    }

    .button--secondary {
      border-color: #a9b5c2;
      background: rgba(255, 255, 255, 0.68);
    }

    .hero-visual img,
    .split-card img {
      display: block;
      width: 100%;
      height: auto;
      border-radius: 30px;
      box-shadow: 0 30px 80px rgba(9, 20, 38, 0.15);
    }

    .trust-strip {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1px;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: 28px;
      background: var(--line);
    }

    .trust-strip > * {
      background: var(--panel);
      padding: 22px;
      text-decoration: none;
    }

    .trust-strip a:hover {
      background: #fff;
      opacity: 1;
    }

    .trust-strip span {
      display: block;
      margin-bottom: 6px;
      color: var(--green-dark);
      font-size: 13px;
      font-weight: 900;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .trust-strip strong {
      font-size: 18px;
      line-height: 1.25;
    }

    .section {
      padding-top: 76px;
    }

    .section-heading {
      max-width: 880px;
    }

    .section h2 {
      margin-bottom: 18px;
      font-size: clamp(36px, 5vw, 68px);
      line-height: 0.98;
      letter-spacing: -0.06em;
      text-wrap: balance;
    }

    .section p {
      color: var(--muted);
      font-size: 19px;
    }

    .feature-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 14px;
      margin-top: 32px;
    }

    .feature-grid article,
    .use-cases-grid article,
    .guide-card,
    .split-card,
    .faq details,
    .review-card,
    .support-card {
      border: 1px solid var(--line);
      border-radius: 24px;
      background: var(--panel);
      padding: 22px;
    }

    .feature-grid article > span {
      color: var(--green-dark);
      font-size: 13px;
      font-weight: 900;
      letter-spacing: 0.12em;
    }

    .feature-grid h3,
    .use-cases-grid h3 {
      margin: 16px 0 8px;
      font-size: 22px;
      line-height: 1.12;
    }

    .feature-grid p,
    .use-cases-grid p {
      margin: 0;
      font-size: 16px;
    }

    .reliability-note {
      margin-top: 20px;
      padding: 20px 22px;
      border-left: 3px solid var(--green-dark);
      border-radius: 0 16px 16px 0;
      background: var(--panel);
    }

    .reliability-note p {
      max-width: 880px;
      margin: 0;
      font-size: 16px;
    }

    .reliability-note p + p {
      margin-top: 6px;
    }

    .reliability-note strong {
      color: var(--ink);
    }

    .workflow-section .section-heading {
      margin-bottom: 30px;
    }

    .workflow-section :global(.case-gallery-shell) {
      width: 100%;
      margin: 0;
      transform: none;
    }

    .workflow-section :global(.case-gallery.case-gallery--carousel) {
      background: #0b1019;
      border-color: rgba(255, 255, 255, 0.08);
    }

    .workflow-section :global(.case-gallery.case-gallery--carousel .case-gallery__image) {
      height: min(72vh, 720px);
      min-height: 460px;
      padding: 18px;
      object-fit: contain;
    }

    .use-cases-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
      margin-top: 30px;
    }

    .split-card {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 34px;
      align-items: center;
      padding: 28px;
    }

    .guide-card,
    .faq {
      max-width: 900px;
    }

    .text-link {
      color: var(--green-dark);
      font-weight: 850;
      text-decoration-thickness: 2px;
    }

    .faq details {
      margin-top: 12px;
    }

    .faq summary {
      cursor: pointer;
      font-weight: 850;
    }

    .faq details p {
      margin: 12px 0 0;
      font-size: 17px;
    }

    .review-card {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 22px;
      align-items: center;
      background:
        radial-gradient(circle at 0 0, rgba(54, 168, 115, 0.18), transparent 42%),
        #fff;
    }

    .review-icon {
      width: 58px;
      height: 58px;
      display: grid;
      place-items: center;
      border-radius: 18px;
      background: #e5f3ed;
      color: var(--green-dark);
      font-size: 27px;
    }

    .review-card h2,
    .support-card h2 {
      margin-bottom: 8px;
      font-size: clamp(28px, 3vw, 42px);
      line-height: 1.04;
    }

    .review-card p,
    .support-card p {
      margin-bottom: 0;
      font-size: 17px;
    }

    .support-card {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 18px;
      align-items: center;
      max-width: 940px;
      padding: 20px 22px;
      background: rgba(255, 255, 255, 0.58);
    }

    .support-heart {
      color: #d65b75;
      font-size: 30px;
    }

    .creator-card {
      margin-top: 68px;
      padding-top: 28px;
      border-top: 1px solid var(--line);
      color: var(--muted);
    }

    .creator-card p {
      max-width: 720px;
      margin-bottom: 8px;
    }

    .creator-card strong,
    .creator-card a {
      color: var(--ink);
    }

    @media (max-width: 980px) {
      .feature-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .review-card,
      .support-card {
        grid-template-columns: auto minmax(0, 1fr);
      }

      .review-card .button,
      .support-card .text-link {
        grid-column: 2;
        justify-self: start;
      }
    }

    @media (max-width: 900px) {
      .hero-shell,
      .split-card,
      .trust-strip,
      .use-cases-grid {
        grid-template-columns: 1fr;
      }

      .hero-shell {
        padding-top: 18px;
      }
    }

    @media (max-width: 620px) {
      .session-saver-page {
        padding-inline: 14px;
      }

      .feature-grid {
        grid-template-columns: 1fr;
      }

      .hero-actions {
