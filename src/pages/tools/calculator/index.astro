---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const title = "SEO ROI Calculator - getmanov.com";
const description =
  "An interactive SEO ROI calculator for estimating CAC, LTV, payback, and return on SEO investment.";
const canonical = "https://getmanov.com/tools/calculator/";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <section class="calculator-page">
    <div class="calculator-hero">
      <p class="kicker">Growth tool</p>
      <h1>SEO ROI Calculator</h1>
      <p>
        Estimate whether an SEO program can turn into profitable customer
        acquisition. The model connects SEO spend, customers acquired, gross
        margin, churn, CAC, LTV, payback, and ROI.
      </p>
    </div>

    <div class="calculator-layout">
      <form class="calculator-card" id="seoCalculator" aria-label="SEO ROI inputs">
        <h2>Inputs</h2>

        <label class="field">
          <span>Total SEO investment</span>
          <input id="seoCost" type="number" min="0" step="100" value="6000" />
          <small>Content, technical work, tools, links, agency fees, salaries, and other SEO costs.</small>
        </label>

        <label class="field">
          <span>Customers acquired from SEO</span>
          <input id="customers" type="number" min="0" step="1" value="60" />
          <small>Paying customers attributed to SEO during the same period.</small>
        </label>

        <label class="field">
          <span>Annual revenue per customer</span>
          <input id="annualRevenue" type="number" min="0" step="10" value="300" />
          <small>Average annual revenue generated by one customer.</small>
        </label>

        <label class="field field--range">
          <span>Gross margin <strong id="marginVal">70%</strong></span>
          <input id="margin" type="range" min="0" max="100" step="1" value="70" />
          <small>Only the margin-adjusted revenue should be used for LTV.</small>
        </label>

        <label class="field field--range">
          <span>Annual churn <strong id="churnVal">20%</strong></span>
          <input id="churn" type="range" min="1" max="100" step="1" value="20" />
          <small>Used to estimate expected customer lifetime.</small>
        </label>

        <label class="field field--range">
          <span>Discount rate <strong id="discountVal">5%</strong></span>
          <input id="discount" type="range" min="0" max="30" step="1" value="5" />
          <small>Simple discount applied to future LTV.</small>
        </label>

        <div class="actions">
          <button class="button button--primary" type="button" id="calcBtn">Calculate</button>
          <button class="button" type="button" id="resetBtn">Reset</button>
        </div>
      </form>

      <section class="results-panel" aria-label="SEO ROI results">
        <div class="results-panel__header">
          <p class="kicker">Output</p>
          <h2>Revenue logic</h2>
        </div>

        <div class="kpi-grid">
          <div class="kpi">
            <span>CAC</span>
            <strong id="cac">-</strong>
          </div>
          <div class="kpi">
            <span>LTV</span>
            <strong id="ltv">-</strong>
          </div>
          <div class="kpi">
            <span>LTV:CAC</span>
            <strong id="ltvCac">-</strong>
          </div>
          <div class="kpi">
            <span>ROI</span>
            <strong id="roi">-</strong>
          </div>
          <div class="kpi">
            <span>Payback</span>
            <strong id="payback">-</strong>
          </div>
          <div class="kpi">
            <span>Lifetime</span>
            <strong id="lifetime">-</strong>
          </div>
        </div>

        <div class="formula-box">
          <h3>How the calculator works</h3>
          <p>
            CAC = SEO investment / customers acquired. LTV = annual revenue per
            customer x gross margin x expected lifetime. ROI = (total LTV value
            - SEO investment) / SEO investment.
          </p>
        </div>
      </section>
    </div>
  </section>

  <script>
    const get = (id) => document.getElementById(id);

    const money = (value) =>
      new Intl.NumberFormat("en-US", {
        style: "currency",
        currency: "USD",
        maximumFractionDigits: 0,
      }).format(value);

    const number = (value, digits = 1) =>
      new Intl.NumberFormat("en-US", {
        maximumFractionDigits: digits,
      }).format(value);

    function readInputs() {
      return {
        seoCost: Number(get("seoCost").value || 0),
        customers: Number(get("customers").value || 0),
        annualRevenue: Number(get("annualRevenue").value || 0),
        margin: Number(get("margin").value || 0) / 100,
        churn: Number(get("churn").value || 0) / 100,
        discount: Number(get("discount").value || 0) / 100,
      };
    }

    function updateLabels({ margin, churn, discount }) {
      get("marginVal").textContent = `${Math.round(margin * 100)}%`;
      get("churnVal").textContent = `${Math.round(churn * 100)}%`;
      get("discountVal").textContent = `${Math.round(discount * 100)}%`;
    }

    function calculate() {
      const input = readInputs();
      updateLabels(input);

      if (input.seoCost <= 0 || input.customers <= 0) {
        ["cac", "ltv", "ltvCac", "roi", "payback", "lifetime"].forEach((id) => {
          get(id).textContent = "-";
        });
        return;
      }

      const lifetimeYears = input.churn > 0 ? 1 / input.churn : 0;
      const ltv = input.annualRevenue * input.margin * lifetimeYears;
      const discountedLtv = ltv / (1 + input.discount);
      const cac = input.seoCost / input.customers;
      const ltvCac = cac > 0 ? discountedLtv / cac : 0;
      const totalLtvValue = discountedLtv * input.customers;
      const roi = ((totalLtvValue - input.seoCost) / input.seoCost) * 100;
      const annualMarginRevenue = input.annualRevenue * input.margin;
      const paybackYears = annualMarginRevenue > 0 ? cac / annualMarginRevenue : 0;

      get("cac").textContent = money(cac);
      get("ltv").textContent = money(discountedLtv);
      get("ltvCac").textContent = number(ltvCac, 2);
      get("roi").textContent = `${number(roi, 0)}%`;
      get("payback").textContent = `${number(paybackYears, 1)} years`;
      get("lifetime").textContent = `${number(lifetimeYears, 1)} years`;
    }

    function resetCalculator() {
      get("seoCost").value = 6000;
      get("customers").value = 60;
      get("annualRevenue").value = 300;
      get("margin").value = 70;
      get("churn").value = 20;
      get("discount").value = 5;
      calculate();
    }

    ["seoCost", "customers", "annualRevenue", "margin", "churn", "discount"].forEach((id) => {
      get(id).addEventListener("input", calculate);
    });

    get("calcBtn").addEventListener("click", calculate);
    get("resetBtn").addEventListener("click", resetCalculator);

    calculate();
  </script>

  <style>
    :global(.prose:has(.calculator-page)) {
      max-width: none;
      padding: 0;
    }

    .calculator-page {
      --ink: #121418;
      --muted: #687384;
      --line: #dbe2ea;
      --paper: #fbfaf7;
      --panel: #eff5f1;
      --accent: #0d6b5f;
      --accent-dark: #08483f;
      color: var(--ink);
      background:
        radial-gradient(circle at 12% 12%, rgba(13, 107, 95, 0.14), transparent 28%),
        linear-gradient(180deg, #fbfaf7 0%, #f2f6f3 100%);
      margin: -34px 0;
      padding: 56px 20px 72px;
    }

    .calculator-hero,
    .calculator-layout {
      max-width: 1120px;
      margin: 0 auto;
    }

    .calculator-hero {
      padding: 40px 0 36px;
    }

    .kicker {
      margin: 0 0 12px;
      color: var(--accent);
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .calculator-hero h1 {
      margin: 0;
      font-size: clamp(44px, 8vw, 96px);
      line-height: 0.95;
      letter-spacing: -0.05em;
    }

    .calculator-hero p {
      max-width: 760px;
      margin: 22px 0 0;
      color: var(--muted);
      font-size: clamp(19px, 2.4vw, 28px);
      line-height: 1.25;
    }

    .calculator-layout {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(360px, 1.1fr);
      gap: 22px;
      align-items: start;
    }

    .calculator-card,
    .results-panel {
      border: 1px solid var(--line);
      border-radius: 28px;
      background: rgba(255, 255, 255, 0.72);
      box-shadow: 0 24px 60px rgba(16, 19, 24, 0.08);
    }

    .calculator-card {
      padding: 24px;
    }

    .calculator-card h2,
    .results-panel h2 {
      margin: 0;
      font-size: 28px;
      letter-spacing: -0.03em;
    }

    .field {
      display: grid;
      gap: 8px;
      margin-top: 20px;
    }

    .field span {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      font-weight: 800;
    }

    .field small {
      color: var(--muted);
      line-height: 1.45;
    }

    .field input[type="number"] {
      width: 100%;
      box-sizing: border-box;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: #fff;
      color: var(--ink);
      font: inherit;
      font-size: 18px;
      padding: 13px 14px;
    }

    .field input[type="range"] {
      width: 100%;
      accent-color: var(--accent);
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 24px;
    }

    .button {
      border: 1px solid var(--line);
      border-radius: 999px;
      background: #fff;
      color: var(--ink);
      cursor: pointer;
      font: inherit;
      font-weight: 800;
      padding: 12px 18px;
    }

    .button--primary {
      border-color: var(--accent-dark);
      background: var(--accent-dark);
      color: #fff;
    }

    .results-panel {
      position: sticky;
      top: 24px;
      overflow: hidden;
    }

    .results-panel__header {
      padding: 24px 24px 0;
    }

    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1px;
      margin-top: 24px;
      background: var(--line);
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }

    .kpi {
      min-height: 112px;
      display: grid;
      align-content: space-between;
      gap: 18px;
      background: #fff;
      padding: 20px;
    }

    .kpi span {
      color: var(--muted);
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .kpi strong {
      font-size: clamp(28px, 4vw, 48px);
      line-height: 1;
      letter-spacing: -0.06em;
    }

    .formula-box {
      margin: 24px;
      border-radius: 22px;
      background: var(--panel);
      padding: 20px;
    }

    .formula-box h3 {
      margin: 0 0 8px;
      font-size: 18px;
    }

    .formula-box p {
      margin: 0;
      color: var(--muted);
      line-height: 1.55;
    }

    @media (max-width: 900px) {
      .calculator-layout {
        grid-template-columns: 1fr;
      }

      .results-panel {
        position: static;
      }
    }

    @media (max-width: 560px) {
      .calculator-page {
        padding-inline: 14px;
      }

      .calculator-card,
      .results-panel {
        border-radius: 22px;
      }

      .kpi-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
