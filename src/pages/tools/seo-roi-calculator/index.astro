  <script>
    const byId = (id) => document.getElementById(id);
    const numberValue = (id) => Number(byId(id)?.value || 0);
    const currency = (value) =>
      new Intl.NumberFormat("en-US", {
        style: "currency",
        currency: "USD",
        notation: Math.abs(value) >= 1000000 ? "compact" : "standard",
        maximumFractionDigits: Math.abs(value) >= 1000 ? 0 : 1,
      }).format(Number.isFinite(value) ? value : 0);
    const decimal = (value, digits = 1) =>
      new Intl.NumberFormat("en-US", { maximumFractionDigits: digits }).format(
        Number.isFinite(value) ? value : 0,
      );

    function getInputs() {
      return {
        monthlyCost: numberValue("monthlyCost"),
        visitors: numberValue("visitors"),
        visitorLead: numberValue("visitorLead") / 100,
        leadCustomer: numberValue("leadCustomer") / 100,
        annualValue: numberValue("annualValue"),
        margin: numberValue("margin") / 100,
        setupCost: numberValue("setupCost"),
        churn: Math.max(numberValue("churn") / 100, 0.01),
        rampMonths: numberValue("rampMonths"),
        salesCycle: Math.round(numberValue("salesCycle")),
        horizon: Math.round(numberValue("horizon")),
      };
    }

    function model(input, demandMultiplier = 1, valueMultiplier = 1) {
      const leadsPerMonth = input.visitors * input.visitorLead * demandMultiplier;
      const customersPerMonth = leadsPerMonth * input.leadCustomer;
      const monthlyChurn = 1 - Math.pow(1 - input.churn, 1 / 12);
      const cohorts = [];
      let totalCustomers = 0;
      let cumulativeRevenue = 0;
      let cumulativeGrossProfit = 0;
      let breakEvenMonth = 0;

      for (let month = 1; month <= input.horizon; month += 1) {
        const rampFactor =
          input.rampMonths > 0
            ? Math.min(1, month / input.rampMonths)
            : 1;
        const newCustomers = customersPerMonth * rampFactor;
        totalCustomers += newCustomers;
        cohorts.push({
          count: newCustomers,
          revenueStart: month + input.salesCycle,
        });

        let activeCustomers = 0;
        cohorts.forEach((cohort) => {
          if (month < cohort.revenueStart) return;
          const age = month - cohort.revenueStart;
          activeCustomers += cohort.count * Math.pow(1 - monthlyChurn, age);
        });

        const monthlyRevenue =
          activeCustomers * ((input.annualValue * valueMultiplier) / 12);
        const monthlyGrossProfit = monthlyRevenue * input.margin;
        cumulativeRevenue += monthlyRevenue;
        cumulativeGrossProfit += monthlyGrossProfit;

        const cumulativeCost = input.setupCost + input.monthlyCost * month;
        if (!breakEvenMonth && cumulativeGrossProfit >= cumulativeCost) {
          breakEvenMonth = month;
        }
      }

      const investment =
        input.setupCost + input.monthlyCost * input.horizon;
      const cac = totalCustomers > 0 ? investment / totalCustomers : 0;
      const ltv =
        ((input.annualValue * valueMultiplier) * input.margin) / input.churn;
      const ltvCac = cac > 0 ? ltv / cac : 0;
      const monthlyGrossProfitPerCustomer =
        ((input.annualValue * valueMultiplier) * input.margin) / 12;
      const payback =
        monthlyGrossProfitPerCustomer > 0
          ? cac / monthlyGrossProfitPerCustomer
          : 0;
      const roi =
        investment > 0
          ? ((cumulativeGrossProfit - investment) / investment) * 100
          : 0;

      return {
        leadsPerMonth,
        customersPerMonth,
        cumulativeRevenue,
        cumulativeGrossProfit,
        investment,
        cac,
        ltv,
        ltvCac,
        payback,
        breakEvenMonth,
        roi,
      };
    }

    function setText(id, value) {
      const element = byId(id);
      if (element) element.textContent = value;
    }

    function calculate() {
      const input = getInputs();
      const base = model(input);
      const conservative = model(input, 0.7, 0.9);
      const aggressive = model(input, 1.3, 1.1);

      setText("roiResult", `${decimal(base.roi, 0)}%`);
      setText("horizonLabel", `over ${input.horizon} months`);
      setText("leadsResult", decimal(base.leadsPerMonth, 1));
      setText("customersResult", decimal(base.customersPerMonth, 1));
      setText("revenueResult", currency(base.cumulativeRevenue));
      setText("profitResult", currency(base.cumulativeGrossProfit));
      setText("cacResult", currency(base.cac));
      setText("ltvCacResult", `${decimal(base.ltvCac, 2)}×`);
      setText("paybackResult", `${decimal(base.payback, 1)} months`);
      setText(
        "breakEvenResult",
        base.breakEvenMonth ? `Month ${base.breakEvenMonth}` : `After month ${input.horizon}`,
      );
      setText("conservativeResult", `${decimal(conservative.roi, 0)}% ROI`);
      setText("baseResult", `${decimal(base.roi, 0)}% ROI`);
      setText("aggressiveResult", `${decimal(aggressive.roi, 0)}% ROI`);

      const badge = byId("healthBadge");
      const interpretation = byId("interpretation");
      let status = "Needs work";
      let message =
        "This model may be risky because payback is long or acquisition cost is high relative to customer value.";

      if (base.roi > 50 && base.ltvCac >= 3 && base.payback <= 12) {
        status = "Healthy model";
        message = `This model looks healthy if the assumptions are realistic. Estimated payback is ${decimal(base.payback, 1)} months and LTV:CAC is ${decimal(base.ltvCac, 2)}×.`;
      } else if (base.roi >= 0 && base.ltvCac >= 1.5) {
        status = "Validate assumptions";
        message = `The base case is positive, but it needs validation. Your forecast is especially sensitive to conversion rate, customer value, margin, and the ${input.salesCycle}-month sales cycle.`;
      }

      if (badge) {
        badge.textContent = status;
        badge.dataset.status =
          status === "Healthy model"
            ? "healthy"
            : status === "Validate assumptions"
              ? "caution"
              : "risk";
      }
      if (interpretation) interpretation.textContent = message;
    }

    function reset() {
      const defaults = {
        monthlyCost: 8000,
        visitors: 1500,
        visitorLead: 2.5,
        leadCustomer: 8,
        annualValue: 12000,
        margin: 70,
        setupCost: 0,
        churn: 20,
        rampMonths: 0,
        salesCycle: 0,
        horizon: 12,
      };
      Object.entries(defaults).forEach(([id, value]) => {
        const element = byId(id);
        if (element) element.value = String(value);
      });
      calculate();
    }

    const inputIds = [
      "monthlyCost",
      "visitors",
      "visitorLead",
      "leadCustomer",
      "annualValue",
      "margin",
      "setupCost",
      "churn",
      "rampMonths",
      "salesCycle",
      "horizon",
    ];
    inputIds.forEach((id) => byId(id)?.addEventListener("input", calculate));
    byId("calculateButton")?.addEventListener("click", calculate);
    byId("resetButton")?.addEventListener("click", reset);

    const focusCalculator = () => {
      byId("seoCalculator")?.scrollIntoView({ behavior: "smooth", block: "start" });
      window.setTimeout(() => byId("monthlyCost")?.focus(), 450);
    };
    byId("focusCalculator")?.addEventListener("click", focusCalculator);
    byId("bottomCalculatorButton")?.addEventListener("click", focusCalculator);
    calculate();
  </script>

