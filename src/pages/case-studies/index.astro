---
import BaseLayout from "../../layouts/BaseLayout.astro";

const featuredCases = [
  {
    label: "Self-service series · Part I",
    href: "/case-studies/self-service-growth-diagnostics/",
    title: "Rebuilding Self-Service in a Legacy B2B SaaS Infrastructure",
    description:
      "A browser-first flow rebuild used to test whether demand could convert without manual sales.",
  },
  {
    label: "Self-service series · Part II",
    href: "/case-studies/invoice-to-paid-billing-diagnostics/",
    title: "Diagnosing Invoice-to-Paid Constraints",
    description:
      "A deep diagnostic of the billing-state transition that blocked otherwise validated purchase intent.",
  },
  {
    label: "Self-service series · Part III",
    href: "/case-studies/payment-diagnostics-revenue-observability/",
    title: "Payment Diagnostics and Revenue Observability",
    description:
      "A practical framework for turning an opaque payment flow into an observable growth system.",
  },
  {
    label: "Supporting growth case",
    href: "/case-studies/seo-case-b2b/",
    title: "B2B SEO Case Study: 620 Inquiries to 60% ROI",
    description:
      "A firsthand case connecting technical SEO and niche research to 41 new customers, ₽1.218M revenue, and 60% realized ROI.",
  },
];

const archiveCases = [
  {
    href: "/case-studies/massage/",
    title: "Filling an Empty Massage Salon",
    description:
      "Facebook Ads case: 1,129% ROI and a repeatable acquisition flow for a local service business.",
  },
  {
    href: "/case-studies/giorgio/",
    title: "Promoting a Premium Fur Brand",
    description:
      "An agency-era paid social and brand-awareness case for Giorgio Magnani Luxury.",
  },
  {
    href: "/case-studies/websites/",
    title: "339,718 Rubles in Website Revenue During the Dead Season",
    description:
      "A commercial website-production case preserved from the earlier portfolio.",
  },
];
---

<BaseLayout
  title="Growth Case Studies — Ivan Getmanov"
  description="Growth, monetization, revenue diagnostics, B2B SEO, and selected agency-era case studies."
>
  <div class="case-index">
    <header>
      <p class="eyebrow">Case studies</p>
      <h1>Growth systems, diagnosed in public</h1>
      <p class="lead">
        The primary portfolio follows one connected story: rebuild the
        self-service journey, locate the revenue constraint, and make the
        payment system observable. The B2B SEO case shows the same
        evidence-first approach applied to acquisition.
      </p>
    </header>

    <section>
      <h2>Featured growth work</h2>
      <div class="case-grid case-grid--featured">
        {featuredCases.map((item) => (
          <a class="case-card" href={item.href}>
            <span>{item.label}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section id="archive">
      <h2>Case archive</h2>
      <p class="section-copy">
        Earlier agency-era work, translated and preserved for context. These
        cases are useful evidence, but they are not the main Growth Lead
        narrative.
      </p>
      <div class="case-grid">
        {archiveCases.map((item) => (
          <a class="case-card case-card--archive" href={item.href}>
            <span>Archive</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </a>
        ))}
      </div>
    </section>
  </div>

  <style>
    :global(.prose:has(.case-index)) {
      max-width: none;
      padding: 0;
    }

    .case-index {
      --ink: #11151a;
      --muted: #66717f;
      --line: #dbe3e7;
      --green: #0d6b5f;
      margin: -34px 0;
      padding: 80px 20px 96px;
      color: var(--ink);
      background:
        radial-gradient(circle at 80% 0%, rgba(13, 107, 95, 0.13), transparent 30%),
        linear-gradient(180deg, #fbfaf7 0%, #f2f7f4 100%);
    }

    header,
    section {
      max-width: 1120px;
      margin: 0 auto;
    }

    header {
      padding-bottom: 64px;
    }

    section {
      padding: 48px 0;
      border-top: 1px solid var(--line);
    }

    .eyebrow,
    .case-card span {
      color: var(--green);
      font-size: 12px;
      font-weight: 900;
      letter-spacing: 0.13em;
      text-transform: uppercase;
    }

    h1 {
      max-width: 960px;
      margin: 12px 0 24px;
      font-size: clamp(54px, 9vw, 118px);
      line-height: 0.92;
      letter-spacing: -0.065em;
    }

    .lead {
      max-width: 820px;
      color: var(--muted);
      font-size: clamp(20px, 2.5vw, 30px);
      line-height: 1.35;
    }

    h2 {
      margin: 0 0 24px;
      font-size: clamp(30px, 4vw, 48px);
      letter-spacing: -0.04em;
    }

    .section-copy {
      max-width: 720px;
      margin: -10px 0 28px;
      color: var(--muted);
    }

    .case-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }

    .case-grid--featured {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .case-card {
      min-height: 300px;
      display: flex;
      flex-direction: column;
      padding: 26px;
      color: inherit;
      text-decoration: none;
      border: 1px solid var(--line);
      border-radius: 24px;
      background: rgba(255, 255, 255, 0.78);
      box-shadow: 0 24px 60px rgba(17, 21, 26, 0.06);
      transition: transform 0.16s ease, box-shadow 0.16s ease;
    }

    .case-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 30px 76px rgba(17, 21, 26, 0.1);
    }

    .case-card h3 {
      margin: 24px 0 16px;
      font-size: clamp(28px, 3.4vw, 46px);
      line-height: 1;
      letter-spacing: -0.045em;
    }

    .case-card p {
      margin: auto 0 0;
      color: var(--muted);
      font-size: 17px;
    }

    .case-card--archive {
      min-height: 260px;
    }

    .case-card--archive h3 {
      font-size: clamp(25px, 2.6vw, 35px);
    }

    @media (max-width: 820px) {
      .case-grid,
      .case-grid--featured {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
