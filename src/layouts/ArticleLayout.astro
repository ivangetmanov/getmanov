---
import BaseLayout from "./BaseLayout.astro";

const frontmatter = Astro.props.frontmatter ?? {};
const canonicalUrl = new URL(
  frontmatter.canonical ?? Astro.url.pathname,
  "https://getmanov.com",
).href;
const heroImageUrl = frontmatter.heroImage
  ? new URL(frontmatter.heroImage, "https://getmanov.com").href
  : undefined;
const faqItems = frontmatter.faq ?? [];
const b2bSeoPaths = new Set([
  "/case-studies/seo-case-b2b/",
  "/notes/b2b-seo-guides-postmortem/",
]);
const currentPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const isB2BSeoArticle = b2bSeoPaths.has(currentPath);
const isCaseStudy = currentPath.startsWith("/case-studies/");
const mentionedToolId = isB2BSeoArticle
  ? "https://getmanov.com/tools/seo-roi-calculator/#application"
  : "https://getmanov.com/tools/session-saver/#software";

const articleSchema = {
  "@type": "Article",
  "@id": `${canonicalUrl}#article`,
  headline: frontmatter.title,
  description: frontmatter.description,
  url: canonicalUrl,
  mainEntityOfPage: canonicalUrl,
  ...(heroImageUrl ? { image: heroImageUrl } : {}),
  datePublished: frontmatter.datePublished,
  dateModified: frontmatter.dateModified,
  author: {
    "@type": "Person",
    name: "Ivan Getmanov",
    url: "https://getmanov.com/",
  },
  publisher: {
    "@type": "Person",
    name: "Ivan Getmanov",
    url: "https://getmanov.com/",
  },
  mentions: {
    "@id": mentionedToolId,
  },
};

const toolSchema = isB2BSeoArticle
  ? {
      "@type": "WebApplication",
      "@id": "https://getmanov.com/tools/seo-roi-calculator/#application",
      name: "Free SEO ROI Calculator Online",
      applicationCategory: "BusinessApplication",
      operatingSystem: "Any",
      url: "https://getmanov.com/tools/seo-roi-calculator/",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
      author: {
        "@type": "Person",
        name: "Ivan Getmanov",
        url: "https://getmanov.com/",
      },
    }
  : {
      "@type": "SoftwareApplication",
      "@id": "https://getmanov.com/tools/session-saver/#software",
      name: "ChatGPT Session Saver",
      applicationCategory: "BrowserApplication",
      operatingSystem: "Chrome",
      url: "https://getmanov.com/tools/session-saver/",
      installUrl:
        "https://chromewebstore.google.com/detail/chatgpt-session-saver/negkdfmbiophoipcalliiemalkghlidj/",
      author: {
        "@type": "Person",
        name: "Ivan Getmanov",
        url: "https://getmanov.com/",
      },
    };

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    articleSchema,
    ...(faqItems.length
      ? [
          {
            "@type": "FAQPage",
            "@id": `${canonicalUrl}#faq`,
            mainEntity: faqItems.map((item) => ({
              "@type": "Question",
              name: item.question,
              acceptedAnswer: {
                "@type": "Answer",
                text: item.answer,
              },
            })),
          },
        ]
      : []),
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumbs`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://getmanov.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: isCaseStudy ? "Case studies" : "Notes",
          item: isCaseStudy
            ? "https://getmanov.com/case-studies/"
            : "https://getmanov.com/notes/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: frontmatter.title,
          item: canonicalUrl,
        },
      ],
    },
    toolSchema,
  ],
};
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  canonical={frontmatter.canonical}
  structuredData={structuredData}
  image={frontmatter.heroImage}
  imageAlt={frontmatter.heroImageAlt ?? frontmatter.title}
  imageWidth={frontmatter.heroImageWidth}
  imageHeight={frontmatter.heroImageHeight}
  ogType="article"
  articlePublishedTime={frontmatter.datePublished}
  articleModifiedTime={frontmatter.dateModified}
>
  <slot />
</BaseLayout>
