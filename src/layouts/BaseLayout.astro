---
import { readFile } from "node:fs/promises";

const frontmatter = Astro.props.frontmatter ?? {};
const title = Astro.props.title ?? frontmatter.title ?? "getmanov.com";
const description =
  Astro.props.description ??
  frontmatter.description ??
  "Experiments, case-based research, tools, and notes.";
const canonical = Astro.props.canonical ?? frontmatter.canonical;
const structuredData = Astro.props.structuredData;

const canonicalUrl = canonical
  ? new URL(canonical, "https://getmanov.com").href
  : `https://getmanov.com${Astro.url.pathname}`;

const galleryPages = new Set([
  "/case-studies/seo-case-b2b/",
  "/case-studies/massage/",
  "/case-studies/giorgio/",
  "/case-studies/websites/",
  "/notes/export-long-chatgpt-chats/",
  "/tools/session-saver/",
]);
const hasCaseGalleries = galleryPages.has(Astro.url.pathname);

const b2bSeoCase = {
  href: "/case-studies/seo-case-b2b/",
  title: "B2B SEO: Full Growth Case Study",
  description: "Technical work, content, visibility, leads, revenue, and ROI.",
};

const b2bSeoGuides = [
  {
    href: "/notes/b2b-seo-agency/",
    title: "Choosing a B2B SEO Partner",
    description: "Agency, consultant, in-house, and hybrid evaluation.",
  },
  {
    href: "/notes/b2b-seo-audit/",
    title: "B2B SEO Audit",
    description: "Technical, content, authority, and measurement diagnosis.",
  },
  {
    href: "/notes/b2b-seo-branding/",
    title: "Brand Positioning",
    description: "Turn search visibility into a coherent market position.",
  },
  {
    href: "/notes/b2b-seo-checklist/",
    title: "B2B SEO Checklist",
    description: "An operating sequence from baseline to revenue.",
  },
  {
    href: "/notes/b2b-seo-kpi/",
    title: "B2B SEO KPIs",
    description: "Connect visibility to pipeline, revenue, and efficiency.",
  },
  {
    href: "/notes/b2b-seo-links/",
    title: "B2B Link Building",
    description: "Authority, referrals, evidence, and market relevance.",
  },
  {
    href: "/notes/b2b-seo-mail/",
    title: "Email and B2B SEO",
    description: "Extend search discovery through distribution and nurture.",
  },
  {
    href: "/notes/b2b-seo-smm/",
    title: "Social Distribution",
    description: "Help expertise reach people who can use and reference it.",
  },
  {
    href: "/notes/b2b-seo-technical/",
    title: "Technical SEO",
    description: "Crawling, indexation, performance, and site architecture.",
  },
  {
    href: "/notes/b2b-seo-trends/",
    title: "B2B SEO Trends",
    description: "AI search, authority, UX, and changing discovery surfaces.",
  },
];

const currentPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const hasArticleNavigation =
  (currentPath.startsWith("/notes/") && currentPath !== "/notes/") ||
  (currentPath.startsWith("/case-studies/") &&
    currentPath !== "/case-studies/");
const b2bSeoPaths = new Set([
  b2bSeoCase.href,
  ...b2bSeoGuides.map((guide) => guide.href),
]);
const hasB2BSeoMap = b2bSeoPaths.has(currentPath);

const [globalStyles, markdownStyles] = await Promise.all([
  readFile(new URL("../../public/styles/global.css", import.meta.url), "utf8"),
  readFile(new URL("../../public/styles/markdown.css", import.meta.url), "utf8"),
]);
const criticalStyles = `${globalStyles}\n${markdownStyles}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#211d1e" />
    <meta name="apple-mobile-web-app-title" content="Getmanov" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link
      rel="icon"
      type="image/png"
      href="/favicon-96x96.png"
      sizes="96x96"
    />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-Q9Y8XEE6EF"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-Q9Y8XEE6EF');
    </script>

    <!-- The small shared stylesheets are inlined to avoid render-blocking requests. -->
    <style is:inline set:html={criticalStyles}></style>

    {structuredData && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(structuredData)}
      ></script>
    )}
  </head>

  <body data-path={Astro.url.pathname}>
    {hasArticleNavigation && (
      <div class="reading-progress" aria-hidden="true">
        <span class="reading-progress__bar"></span>
      </div>
    )}

    <a class="skip-link" href="#content">Skip to content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/">
          <span class="brand-mark">GETMANOV</span>
        </a>

        <nav class="nav">
          <a href="/tools/">Tools</a>
          <a href="/projects/">Projects</a>
          <a href="/case-studies/">Case studies</a>
          <a href="/notes/">Notes</a>
        </nav>
      </div>
    </header>

    <main id="content" class="site-main">
      <div
        class:list={[
          "article-layout",
          { "article-layout--with-toc": hasArticleNavigation },
        ]}
      >
        <!-- Markdown content is wrapped in .prose. -->
        <article id="article-content" class="prose">
          <slot />
          {hasB2BSeoMap && (
            <aside class="b2b-seo-map" aria-labelledby="b2b-seo-map-title">
              <div class="b2b-seo-map__intro">
                <p class="b2b-seo-map__eyebrow">B2B SEO knowledge map</p>
                <h2 id="b2b-seo-map-title">Continue through the system</h2>
                <p>
                  The case study shows the work in practice. These guides break
                  the operating system into reusable decisions.
                </p>
              </div>

              <div class="b2b-seo-map__case">
                {currentPath === b2bSeoCase.href ? (
                  <span aria-current="page">
                    <strong>{b2bSeoCase.title}</strong>
                    <small>{b2bSeoCase.description}</small>
                  </span>
                ) : (
                  <a href={b2bSeoCase.href}>
                    <strong>{b2bSeoCase.title}</strong>
                    <small>{b2bSeoCase.description}</small>
                  </a>
                )}
              </div>

              <div class="b2b-seo-map__grid">
                {b2bSeoGuides.map((guide) => (
                  currentPath === guide.href ? (
                    <span class="b2b-seo-map__item" aria-current="page">
                      <strong>{guide.title}</strong>
                      <small>{guide.description}</small>
                    </span>
                  ) : (
                    <a class="b2b-seo-map__item" href={guide.href}>
                      <strong>{guide.title}</strong>
                      <small>{guide.description}</small>
                    </a>
                  )
                ))}
              </div>
            </aside>
          )}
        </article>

        {hasArticleNavigation && (
          <aside class="article-toc" aria-labelledby="article-toc-title">
            <nav>
              <p id="article-toc-title" class="article-toc__title">
                Table of contents
              </p>
              <ol class="article-toc__list"></ol>
            </nav>
          </aside>
        )}
      </div>
    </main>

    <footer id="contact" class="site-footer">
      <div class="container footer-grid">
        <div>
          <div class="footer-title">Contact</div>
          <div class="footer-text">
            <a href="mailto:ivangetmanov@icloud.com">ivangetmanov@icloud.com</a><br />
            <a
              href="https://t.me/getmanov_marketing"
              target="_blank"
              rel="noreferrer"
            >
              t.me/getmanov_marketing
            </a>
          </div>
        </div>

        <div>
          <div class="footer-title">What this is</div>
          <div class="footer-text">
            A personal lab: experiments, case-based research, and tools.<br />
            Built to be fast, clean, and easy to extend.
          </div>
        </div>

        <div>
          <div class="footer-title">Status</div>
          <div class="footer-text">
            Astro migration in progress.
          </div>
        </div>
      </div>
    </footer>

    {hasCaseGalleries && (
      <script is:inline src="/scripts/case-gallery.js" defer></script>
    )}
    {hasArticleNavigation && (
      <script is:inline src="/scripts/article-navigation.js" defer></script>
    )}
  </body>
</html>
