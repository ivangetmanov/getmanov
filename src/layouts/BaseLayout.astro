---
import { readFile } from "node:fs/promises";
import { telegramUrl } from "../data/pet-sitting";

const frontmatter = Astro.props.frontmatter ?? {};
const title = Astro.props.title ?? frontmatter.title ?? "getmanov.com";
const description =
  Astro.props.description ??
  frontmatter.description ??
  "Experiments, case-based research, tools, and notes.";
const canonical = Astro.props.canonical ?? frontmatter.canonical;
const structuredData = Astro.props.structuredData;
const lang = Astro.props.lang ?? "en";
const alternates = Astro.props.alternates ?? [];
const preferredImage = Astro.props.image ?? frontmatter.image;
const preferredImageAlt = Astro.props.imageAlt ?? frontmatter.imageAlt ?? title;
const preferredImageWidth = Astro.props.imageWidth ?? frontmatter.imageWidth;
const preferredImageHeight = Astro.props.imageHeight ?? frontmatter.imageHeight;
const ogType = Astro.props.ogType ?? "website";
const articlePublishedTime = Astro.props.articlePublishedTime;
const articleModifiedTime = Astro.props.articleModifiedTime;

const canonicalUrl = canonical
  ? new URL(canonical, "https://getmanov.com").href
  : `https://getmanov.com${Astro.url.pathname}`;
const preferredImageUrl = preferredImage
  ? new URL(preferredImage, "https://getmanov.com").href
  : null;
const robots = Astro.props.robots ?? (preferredImageUrl ? "index,follow,max-image-preview:large" : "index,follow");

const galleryPages = new Set([
  "/case-studies/seo-case-b2b/",
  "/case-studies/massage/",
  "/case-studies/giorgio/",
  "/case-studies/websites/",
  "/notes/export-long-chatgpt-chats/",
  "/tools/session-saver/",
]);
const hasCaseGalleries = galleryPages.has(Astro.url.pathname);

const currentPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const petSittingSectionMatch = currentPath.match(/^\/(ru|en)\/novi-sad\/pet-sitting\//);
const isPetSittingSection = Boolean(petSittingSectionMatch);
const petSectionLocale = petSittingSectionMatch?.[1] === "ru" ? "ru" : "en";
const petSectionBase = `/${petSectionLocale}/novi-sad/pet-sitting/`;
const petSectionAlternatePath = currentPath.replace(
  `/${petSectionLocale}/`,
  petSectionLocale === "ru" ? "/en/" : "/ru/",
);
const petSectionTelegram = telegramUrl();
const petSittingArticleMatch = currentPath.match(
  /^\/(ru|en)\/novi-sad\/pet-sitting\/([^/]+)\/$/,
);
const isPetSittingArticle = Boolean(
  petSittingArticleMatch && !["cats", "dogs"].includes(petSittingArticleMatch[2]),
);
const petArticleLocale = petSittingArticleMatch?.[1] === "ru" ? "ru" : "en";
const petArticleSlug = petSittingArticleMatch?.[2] ?? "";
const petArticleServiceKind = petArticleSlug.includes("cat")
  ? "cats"
  : petArticleSlug.includes("dog")
    ? "dogs"
    : "";
const petArticleServicePath = `/${petArticleLocale}/novi-sad/pet-sitting/${petArticleServiceKind ? `${petArticleServiceKind}/` : ""}`;
const hasArticleNavigation =
  (currentPath.startsWith("/notes/") && currentPath !== "/notes/") ||
  (currentPath.startsWith("/case-studies/") &&
    currentPath !== "/case-studies/") ||
  isPetSittingArticle;
const b2bSeoArticlePaths = new Set([
  "/case-studies/seo-case-b2b/",
  "/notes/b2b-seo-guides-postmortem/",
]);
const isB2BSeoArticle = b2bSeoArticlePaths.has(currentPath);
const articleCta = isB2BSeoArticle
  ? {
      href: "/tools/seo-roi-calculator/",
      eyebrow: "Free planning tool",
      title: "Try the SEO ROI Calculator",
      description: "Estimate CAC, LTV, payback, and ROI with your own numbers.",
    }
  : isPetSittingArticle
    ? petArticleLocale === "ru"
      ? {
          href: petArticleServicePath,
          eyebrow: "Домашняя передержка",
          title: petArticleServiceKind === "cats" ? "Передержка кошек" : petArticleServiceKind === "dogs" ? "Передержка собак" : "Передержка в Нови-Саде",
          description: "Условия, свободные даты, цены и реальные фото гостей.",
        }
      : {
          href: petArticleServicePath,
          eyebrow: "Home boarding",
          title: petArticleServiceKind === "cats" ? "Cat boarding" : petArticleServiceKind === "dogs" ? "Dog boarding" : "Pet boarding in Novi Sad",
          description: "See availability, pricing, conditions, and real guest media.",
        }
    : currentPath.startsWith("/notes/")
    ? {
        href: "/tools/session-saver/",
        eyebrow: "Free browser tool",
        title: "Try ChatGPT Session Saver",
        description: "Turn one active ChatGPT conversation into clean local Q&A notes.",
      }
    : null;

const [globalStyles, markdownStyles] = await Promise.all([
  readFile(new URL("../../public/styles/global.css", import.meta.url), "utf8"),
  readFile(new URL("../../public/styles/markdown.css", import.meta.url), "utf8"),
]);
const criticalStyles = `${globalStyles}\n${markdownStyles}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map((alternate: { hreflang: string; href: string }) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={new URL(alternate.href, "https://getmanov.com").href} />
    ))}
    <meta name="robots" content={robots} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={lang === "ru" ? "ru_RU" : "en_US"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogType === "article" && articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
    {ogType === "article" && articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}
    {preferredImageUrl && (
      <>
        <meta property="og:image" content={preferredImageUrl} />
        <meta property="og:image:secure_url" content={preferredImageUrl} />
        <meta property="og:image:type" content="image/webp" />
        {preferredImageWidth && <meta property="og:image:width" content={String(preferredImageWidth)} />}
        {preferredImageHeight && <meta property="og:image:height" content={String(preferredImageHeight)} />}
        <meta property="og:image:alt" content={preferredImageAlt} />
      </>
    )}
    <meta name="twitter:card" content={preferredImageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {preferredImageUrl && <meta name="twitter:image" content={preferredImageUrl} />}
    {preferredImageUrl && <meta name="twitter:image:alt" content={preferredImageAlt} />}
    <meta name="theme-color" content="#211d1e" />
    <meta name="apple-mobile-web-app-title" content="Getmanov" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link
      rel="icon"
      type="image/png"
      href="/favicon-96x96.png"
      sizes="96x96"
    />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-Q9Y8XEE6EF"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-Q9Y8XEE6EF');
    </script>
    <script is:inline>
      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;

        const link = event.target.closest('a[href]');
        if (!link || typeof window.gtag !== 'function') return;

        const targetUrl = new URL(link.href, window.location.href);
        const ctaText = (link.textContent || '').replace(/\s+/g, ' ').trim();
        const articleHeading = Array.from(document.querySelectorAll('article h2[id], article h3[id]'))
          .filter((heading) => heading.getBoundingClientRect().top <= link.getBoundingClientRect().top)
          .at(-1)?.id;
        const ctaLocation =
          link.dataset.ctaLocation ||
          articleHeading ||
          link.closest('[id]')?.id ||
          link.closest('section')?.className ||
          'content_link';
        const parameters = {
          source_page: window.location.pathname,
          cta_location: String(ctaLocation).slice(0, 100),
          cta_text: ctaText.slice(0, 150),
          target_url: targetUrl.href,
        };

        if (targetUrl.origin === window.location.origin && targetUrl.pathname === '/tools/session-saver/') {
          window.gtag('event', 'session_saver_cta_click', parameters);
        }

        if (targetUrl.hostname === 'chromewebstore.google.com') {
          window.gtag('event', 'chrome_store_click', parameters);
        }
      });
    </script>

    <!-- The small shared stylesheets are inlined to avoid render-blocking requests. -->
    <style is:inline set:html={criticalStyles}></style>

    {structuredData && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(structuredData)}
      ></script>
    )}
  </head>

  <body data-path={Astro.url.pathname}>
    {hasArticleNavigation && (
      <div class="reading-progress" aria-hidden="true">
        <span class="reading-progress__bar"></span>
      </div>
    )}

    <a class="skip-link" href="#content">Skip to content</a>

    <header class:list={["site-header", { "site-header--pet": isPetSittingSection }]}>
      <div class="container header-inner">
        <a class="brand" href={isPetSittingSection ? petSectionBase : "/"}>
          <span class="brand-mark">GETMANOV</span>
          {isPetSittingSection && <span class="pet-brand-context">Pet sitting</span>}
        </a>

        {isPetSittingSection ? (
          <nav class="nav pet-nav" aria-label={petSectionLocale === "ru" ? "Передержка животных" : "Pet boarding"}>
            <a href={petSectionBase} aria-current={currentPath === petSectionBase ? "page" : undefined}>{petSectionLocale === "ru" ? "Главная" : "Overview"}</a>
            <a href={`${petSectionBase}dogs/`} aria-current={currentPath === `${petSectionBase}dogs/` ? "page" : undefined}>{petSectionLocale === "ru" ? "Собаки" : "Dogs"}</a>
            <a href={`${petSectionBase}cats/`} aria-current={currentPath === `${petSectionBase}cats/` ? "page" : undefined}>{petSectionLocale === "ru" ? "Кошки" : "Cats"}</a>
            <a href={`${petSectionBase}#guides`}>{petSectionLocale === "ru" ? "Полезное" : "Guides"}</a>
            <a class="pet-nav__locale" href={petSectionAlternatePath} hreflang={petSectionLocale === "ru" ? "en" : "ru"}>{petSectionLocale === "ru" ? "EN" : "RU"}</a>
          </nav>
        ) : (
          <nav class="nav">
            <a href="/tools/">Tools</a>
            <a href="/case-studies/">Case studies</a>
            <a href="/notes/">Notes</a>
          </nav>
        )}
      </div>
    </header>

    <main id="content" class="site-main">
      <div
        class:list={[
          "article-layout",
          { "article-layout--with-toc": hasArticleNavigation },
        ]}
      >
        <!-- Markdown content is wrapped in .prose. -->
        <article id="article-content" class="prose">
          <slot />
        </article>

        {hasArticleNavigation && (
          <aside class="article-toc" aria-labelledby="article-toc-title">
            <a class="article-author" href="/" aria-label="About Ivan Getmanov">
              <img
                src="/images/ivan-getmanov.webp"
                alt=""
                width="1200"
                height="1600"
                loading="eager"
              />
              <span>
                <small>{lang === "ru" ? "Автор" : "Written by"}</small>
                <strong>Ivan Getmanov</strong>
              </span>
            </a>

            <nav>
              <p id="article-toc-title" class="article-toc__title">
                {lang === "ru" ? "Содержание" : "Table of contents"}
              </p>
              <ol class="article-toc__list"></ol>
            </nav>

            {articleCta && (
              <a class="article-tool-cta" href={articleCta.href}>
                <small>{articleCta.eyebrow}</small>
                <strong>{articleCta.title}</strong>
                <span>{articleCta.description}</span>
                <b aria-hidden="true">{isPetSittingArticle ? lang === "ru" ? "Посмотреть условия →" : "View boarding details →" : "Open tool →"}</b>
              </a>
            )}
          </aside>
        )}
      </div>
    </main>

    <footer id="contact" class:list={["site-footer", { "site-footer--pet": isPetSittingSection }]}>
      {isPetSittingSection ? (
        <div class="container footer-grid pet-footer-grid">
          <div>
            <div class="footer-title">{petSectionLocale === "ru" ? "Домашняя передержка" : "Home pet boarding"}</div>
            <div class="footer-text">{petSectionLocale === "ru" ? "Петроварадин, Нови-Сад" : "Petrovaradin, Novi Sad"}<br />{petSectionLocale === "ru" ? "Собаки и кошки живут у нас дома." : "Dogs and cats stay with us in our home."}</div>
          </div>
          <div>
            <div class="footer-title">{petSectionLocale === "ru" ? "Раздел" : "Explore"}</div>
            <nav class="footer-text pet-footer-links">
              <a href={petSectionBase}>{petSectionLocale === "ru" ? "Все условия" : "Pet boarding"}</a>
              <a href={`${petSectionBase}dogs/`}>{petSectionLocale === "ru" ? "Собаки" : "Dogs"}</a>
              <a href={`${petSectionBase}cats/`}>{petSectionLocale === "ru" ? "Кошки" : "Cats"}</a>
              <a href={`${petSectionBase}#guides`}>{petSectionLocale === "ru" ? "Полезные статьи" : "Useful guides"}</a>
            </nav>
          </div>
          <div>
            <div class="footer-title">{petSectionLocale === "ru" ? "Связаться с Аней" : "Contact Anna"}</div>
            <div class="footer-text">
              <a href={petSectionTelegram} target="_blank" rel="noreferrer">Telegram</a><br />
              <a href={petSectionAlternatePath} hreflang={petSectionLocale === "ru" ? "en" : "ru"}>{petSectionLocale === "ru" ? "English version" : "Русская версия"}</a>
            </div>
          </div>
        </div>
      ) : (
        <div class="container footer-grid">
          <div>
            <div class="footer-title">Contact</div>
            <div class="footer-text">
              <a href="mailto:ivangetmanov@icloud.com">ivangetmanov@icloud.com</a><br />
              <a href="https://t.me/getmanov_marketing" target="_blank" rel="noreferrer">t.me/getmanov_marketing</a>
            </div>
          </div>

          <div>
            <div class="footer-title">What this is</div>
            <div class="footer-text">
              A personal lab: experiments, case-based research, and tools.<br />
              Built to be fast, clean, and easy to extend.
            </div>
          </div>

          <div>
            <div class="footer-title">Status</div>
            <div class="footer-text">
              Site is live. I actively publish and update articles.
            </div>
          </div>
        </div>
      )}
    </footer>

    {hasCaseGalleries && (
      <script is:inline src="/scripts/case-gallery.js" defer></script>
    )}
    {hasArticleNavigation && (
      <script is:inline src="/scripts/article-navigation.js" defer></script>
    )}
  </body>
</html>
