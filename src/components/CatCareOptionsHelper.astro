---
const { locale, articleSlug } = Astro.props as { locale: "ru" | "en"; articleSlug: string };
const isEnglish = locale === "en";
const copy = isEnglish
  ? {
      eyebrow: "Compare the options",
      title: "Which cat-care arrangement should you consider?",
      description: "The answers provide a planning guide, not medical advice. Consider your cat's individual character, health, and routine.",
      duration: "How long will you be away?",
      visits: "Will someone visit regularly?",
      alone: "Can the cat stay alone comfortably?",
      care: "Does the cat need medication or closer monitoring?",
      choose: "Choose",
      short: "Up to two days",
      medium: "3–6 days",
      week: "A week or longer",
      yes: "Yes",
      no: "No",
      usuallyYes: "Usually yes",
      noOrUnknown: "No or we do not know",
      show: "Show options",
    }
  : {
      eyebrow: "Сравнить варианты",
      title: "Какой уход за кошкой имеет смысл рассмотреть?",
      description: "Ответы дают ориентир, а не медицинскую рекомендацию. Учитывайте характер, здоровье и привычки конкретной кошки.",
      duration: "Как долго вы уезжаете?",
      visits: "Будет ли кто-то регулярно приходить?",
      alone: "Кошка спокойно остаётся одна?",
      care: "Нужны лекарства или более частый контроль?",
      choose: "Выберите",
      short: "До двух дней",
      medium: "3–6 дней",
      week: "Неделя или дольше",
      yes: "Да",
      no: "Нет",
      usuallyYes: "Обычно да",
      noOrUnknown: "Нет или не знаем",
      show: "Показать варианты",
    };
---

<section class="pet-article-tool" data-cat-care-tool data-tool-type="cat_care_options" data-article-slug={articleSlug} data-locale={locale} aria-labelledby="cat-care-title">
  <p class="pet-article-tool__eyebrow">{copy.eyebrow}</p>
  <h2 id="cat-care-title">{copy.title}</h2>
  <p>{copy.description}</p>
  <form data-tool-form>
    <label>{copy.duration}
      <select name="duration" required>
        <option value="">{copy.choose}</option>
        <option value="short">{copy.short}</option>
        <option value="medium">{copy.medium}</option>
        <option value="week">{copy.week}</option>
      </select>
    </label>
    <label>{copy.visits}
      <select name="visits" required><option value="">{copy.choose}</option><option value="yes">{copy.yes}</option><option value="no">{copy.no}</option></select>
    </label>
    <label>{copy.alone}
      <select name="alone" required><option value="">{copy.choose}</option><option value="yes">{copy.usuallyYes}</option><option value="no">{copy.noOrUnknown}</option></select>
    </label>
    <label>{copy.care}
      <select name="care" required><option value="">{copy.choose}</option><option value="no">{copy.no}</option><option value="yes">{copy.yes}</option></select>
    </label>
    <button type="submit">{copy.show}</button>
  </form>
  <div class="pet-article-tool__result" data-tool-result hidden aria-live="polite"></div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-cat-care-tool]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-tool-form]');
    const result = root.querySelector<HTMLElement>('[data-tool-result]');
    if (!form || !result) return;
    const isEnglish = root.dataset.locale === 'en';
    let started = false;
    const track = (name: string) => {
      if (typeof window.gtag !== 'function') return;
      window.gtag('event', name, { article_slug: root.dataset.articleSlug, locale: root.dataset.locale, tool_type: root.dataset.toolType });
    };
    form.addEventListener('input', () => {
      if (started) return;
      started = true;
      track('pet_sitting_article_tool_start');
    });
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const values = Object.fromEntries(new FormData(form));
      const options: string[] = [];
      if (values.visits === 'yes' && values.alone === 'yes' && values.care === 'no') options.push(isEnglish ? 'regular drop-in visits' : 'регулярные визиты зооняни на дом');
      if (values.care === 'yes' || values.alone === 'no') options.push(isEnglish ? 'a live-in sitter in your home' : 'ситтера с проживанием у вас дома');
      if (values.duration !== 'short' || values.visits === 'no') options.push(isEnglish ? 'home boarding with a separate safe space' : 'домашнюю передержку с отдельным безопасным пространством');
      if (!options.length) options.push(isEnglish ? 'regular drop-in visits and home boarding' : 'регулярные визиты зооняни и домашнюю передержку');
      const uniqueOptions = [...new Set(options)];
      result.replaceChildren();
      const strong = document.createElement('strong');
      strong.textContent = isEnglish ? `Consider comparing: ${uniqueOptions.join(', ')}.` : `Имеет смысл сравнить: ${uniqueOptions.join(', ')}.`;
      const paragraph = document.createElement('p');
      paragraph.textContent = isEnglish
        ? 'Check which option best preserves your cat’s routine and provides the required level of observation. Discuss medication and health needs with the person providing care.'
        : 'Проверьте, какой вариант лучше сохраняет привычный режим кошки и обеспечивает нужную частоту наблюдения. Лекарства и особенности здоровья заранее обсудите с человеком, который будет ухаживать за питомцем.';
      result.append(strong, paragraph);
      result.hidden = false;
      track('pet_sitting_article_tool_result');
    });
  });
</script>
