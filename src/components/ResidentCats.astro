---
import { petSittingConfig } from "../data/pet-sitting";

const { compact = false, note = "Вашему питомцу совершенно не обязательно с ними дружить.", showSeparationNote = true } = Astro.props as { compact?: boolean; note?: string; showSeparationNote?: boolean };
---

<section class:list={["resident-section", { "resident-section--compact": compact }]} id="resident-cats">
  <div class="resident-intro">
    <p class="eyebrow">Наши коты</p>
    <h2>Наши коты</h2>
    <p>Оба уже жили и с другими кошками, и с собаками.</p>
  </div>
  <div class="resident-pair">
    {petSittingConfig.residentCats.map((cat, index) => (
      <figure>
        {cat.image ? (
          <img src={cat.image} alt={`Наш ${cat.name.toLowerCase()}`} width="900" height="700" loading="lazy" />
        ) : (
          <div class="cat-photo-placeholder">Фото {index === 0 ? "кота" : "кошки"}</div>
        )}
        <figcaption>
          <strong>{index === 0 ? "Кот, 4 года" : "Кошка, 4 года"}</strong>
          <span>{cat.description}</span>
        </figcaption>
      </figure>
    ))}
  </div>
  <p class="resident-note"><strong>{note}</strong>{showSeparationNote && " Если кому-то комфортнее жить отдельно — у нас есть возможность животных разделить."}</p>
</section>
