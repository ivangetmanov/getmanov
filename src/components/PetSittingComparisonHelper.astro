---
const { locale, articleSlug } = Astro.props as { locale: "ru" | "en"; articleSlug: string };
const isEnglish = locale === "en";
const copy = isEnglish
  ? {
      eyebrow: "Quick decision helper",
      title: "Which care arrangement should you compare?",
      description: "Answer four questions. The result cannot assess your pet personally, but it can help narrow the options.",
      alone: "Can your pet stay alone comfortably?",
      newPlace: "Does a new place cause significant stress?",
      company: "Does your pet need a person nearby for most of the day?",
      care: "Does your pet need frequent monitoring or medication?",
      yes: "Yes",
      sometimes: "Not always",
      no: "No",
      usuallyNo: "Usually not",
      unknown: "We do not know yet",
      show: "Show options",
    }
  : {
      eyebrow: "Небольшая подсказка",
      title: "Какой формат ухода стоит сравнить?",
      description: "Ответьте на четыре вопроса. Результат не заменяет личную оценку питомца, но поможет сузить варианты.",
      alone: "Питомец спокойно остаётся один?",
      newPlace: "Сильно ли он стрессует в новом месте?",
      company: "Нужен ли человек рядом большую часть дня?",
      care: "Нужны частый контроль или лекарства?",
      yes: "Да",
      sometimes: "Не всегда",
      no: "Нет",
      usuallyNo: "Обычно нет",
      unknown: "Пока не знаем",
      show: "Показать варианты",
    };
---

<section class="pet-article-tool" data-article-decision-tool data-tool-type="care_comparison" data-article-slug={articleSlug} data-locale={locale} aria-labelledby="care-comparison-title">
  <p class="pet-article-tool__eyebrow">{copy.eyebrow}</p>
  <h2 id="care-comparison-title">{copy.title}</h2>
  <p>{copy.description}</p>
  <form data-tool-form>
    <fieldset class="pet-article-question">
      <legend>{copy.alone}</legend>
      <div class="pet-article-options pet-article-options--three">
        <label><input type="radio" name="alone" value="yes" required /><span>{copy.yes}</span></label>
        <label><input type="radio" name="alone" value="sometimes" /><span>{copy.sometimes}</span></label>
        <label><input type="radio" name="alone" value="no" /><span>{copy.no}</span></label>
      </div>
    </fieldset>
    <fieldset class="pet-article-question">
      <legend>{copy.newPlace}</legend>
      <div class="pet-article-options pet-article-options--three">
        <label><input type="radio" name="newPlace" value="low" required /><span>{copy.usuallyNo}</span></label>
        <label><input type="radio" name="newPlace" value="high" /><span>{copy.yes}</span></label>
        <label><input type="radio" name="newPlace" value="unknown" /><span>{copy.unknown}</span></label>
      </div>
    </fieldset>
    <fieldset class="pet-article-question">
      <legend>{copy.company}</legend>
      <div class="pet-article-options">
        <label><input type="radio" name="company" value="yes" required /><span>{copy.yes}</span></label>
        <label><input type="radio" name="company" value="no" /><span>{copy.no}</span></label>
      </div>
    </fieldset>
    <fieldset class="pet-article-question">
      <legend>{copy.care}</legend>
      <div class="pet-article-options">
        <label><input type="radio" name="care" value="yes" required /><span>{copy.yes}</span></label>
        <label><input type="radio" name="care" value="no" /><span>{copy.no}</span></label>
      </div>
    </fieldset>
    <button type="submit">{copy.show}</button>
  </form>
  <div class="pet-article-tool__result" data-tool-result hidden aria-live="polite"></div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-article-decision-tool][data-tool-type="care_comparison"]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-tool-form]');
    const result = root.querySelector<HTMLElement>('[data-tool-result]');
    if (!form || !result) return;
    const isEnglish = root.dataset.locale === 'en';
    let started = false;
    const track = (name: string) => {
      if (typeof window.gtag !== 'function') return;
      window.gtag('event', name, {
        article_slug: root.dataset.articleSlug,
        locale: root.dataset.locale,
        tool_type: root.dataset.toolType,
      });
    };
    form.addEventListener('input', () => {
      if (started) return;
      started = true;
      track('pet_sitting_article_tool_start');
    });
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const values = Object.fromEntries(new FormData(form));
      let heading = isEnglish ? 'It makes sense to compare several care arrangements.' : 'Имеет смысл сравнить несколько форматов ухода.';
      let explanation = isEnglish
        ? 'Compare where your pet can keep its normal routine and receive the attention it needs.'
        : 'Посмотрите, где питомцу будет проще сохранить привычный режим и получить нужное внимание.';
      if (values.company === 'yes' || values.care === 'yes') {
        heading = isEnglish ? 'A live-in sitter in your home may be particularly suitable.' : 'Ситтер с проживанием у вас дома может быть особенно подходящим вариантом.';
        explanation = isEnglish
          ? 'Your pet remains in familiar surroundings while a person stays nearby and follows the agreed routine. Discuss medication and monitoring requirements separately with the sitter.'
          : 'Питомец останется в знакомой обстановке, а человек сможет быть рядом и соблюдать согласованный режим. Требования к лекарствам и контролю лучше отдельно обсудить с ситтером.';
      } else if (values.newPlace === 'high' && values.alone === 'yes') {
        heading = isEnglish ? 'Start by considering drop-in visits.' : 'В первую очередь стоит рассмотреть визиты зооняни.';
        explanation = isEnglish
          ? 'Your pet can stay alone comfortably, and visits avoid changing the familiar environment. Compare the visit frequency with the normal routine.'
          : 'Питомец спокойно остаётся один, а визиты позволяют не менять знакомую обстановку. Сравните частоту визитов с его обычным режимом.';
      } else if (values.newPlace === 'low' || values.newPlace === 'unknown') {
        heading = isEnglish ? 'It makes sense to consider home boarding.' : 'Имеет смысл посмотреть домашнюю передержку.';
        explanation = isEnglish
          ? 'This may suit a pet that needs company and a home environment. Check compatibility and discuss the normal routine before booking.'
          : 'Этот формат может подойти, если питомцу нужны компания и домашняя обстановка. До бронирования стоит проверить совместимость и обсудить привычный режим.';
      }
      result.replaceChildren();
      const strong = document.createElement('strong');
      strong.textContent = heading;
      const paragraph = document.createElement('p');
      paragraph.textContent = explanation;
      result.append(strong, paragraph);
      result.hidden = false;
      track('pet_sitting_article_tool_result');
    });
  });
</script>
