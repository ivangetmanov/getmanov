---
import { petSittingConfig } from "../data/pet-sitting";

const { locale = "ru" } = Astro.props as { locale?: "ru" | "en" };
const isEnglish = locale === "en";
const englishDurations = ["1–3 days", "4–13 days", "14+ days"];
const durationLabel = (duration: string, index: number) => isEnglish ? englishDurations[index] : duration;
const priceLabel = (price: string, index: number) => isEnglish
  ? index === 2 ? "Discuss individually" : price.replace(/(\d) (\d{3})/, "$1,$2").replace("в сутки", "per day")
  : price;
const quantityLabels = isEnglish ? ["1 pet", "2 pets"] : ["1 животное", "2 животных"];
const tiers = petSittingConfig.prices.oneAnimal.map((row, index) => ({
  duration: durationLabel(row.duration, index),
  onePet: priceLabel(row.price, index),
  twoPets: priceLabel(petSittingConfig.prices.twoAnimals[index].price, index),
}));
const extras = isEnglish
  ? [
      { label: "Free introduction · around 30 minutes", price: "Free" },
      { label: "Trial stay · a few hours", price: "1,000 RSD" },
    ]
  : [
      { label: "Знакомство · около 30 минут", price: "бесплатно" },
      { label: "Пробная передержка · несколько часов", price: "1 000 RSD" },
    ];
---

<section class="pricing-section" id="pricing">
  <div>
    <p class="eyebrow">{isEnglish ? "Pricing" : "Цена"}</p>
    <h2>{isEnglish ? "How much does pet boarding cost?" : "Без сложных тарифов"}</h2>
    <p>{isEnglish ? "Long stays can be discussed individually and may be possible for approximately up to two months." : "Для 14+ дней обсуждаем цену отдельно. Долгие проживания возможны примерно до двух месяцев."}</p>
  </div>
  <div class="pricing-content">
    <table class="price-table" aria-label={isEnglish ? "Pet boarding prices" : "Стоимость передержки"}>
      <thead>
        <tr>
          <th scope="col">{isEnglish ? "Length" : "Срок"}</th>
          <th scope="col">{quantityLabels[0]}</th>
          <th scope="col">{quantityLabels[1]}</th>
        </tr>
      </thead>
      <tbody>
        {tiers.map((tier) => (
          <tr>
            <th scope="row">{tier.duration}</th>
            <td>
              <span class="price-cell__label" aria-hidden="true">{quantityLabels[0]}</span>
              <strong>{tier.onePet}</strong>
            </td>
            <td>
              <span class="price-cell__label" aria-hidden="true">{quantityLabels[1]}</span>
              <strong>{tier.twoPets}</strong>
            </td>
          </tr>
        ))}
      </tbody>
    </table>

    <dl class="price-extras" aria-label={isEnglish ? "Introduction and trial stay" : "Знакомство и пробная передержка"}>
      {extras.map((extra) => (
        <div>
          <dt>{extra.label}</dt>
          <dd>{extra.price}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
