---
import "leaflet/dist/leaflet.css";
import { petSittingBusiness } from "../lib/pet-sitting-business.mjs";

const { locale = "ru" } = Astro.props as { locale?: "ru" | "en" };
const isEnglish = locale === "en";
const area = petSittingBusiness.homeVisits.serviceArea;
---

<div
  class="service-map-shell"
  data-service-area-map
  data-geojson={area.geoJsonPath}
  data-base-popup={area.popup.base[locale]}
  data-extended-popup={area.popup.extended[locale]}
  data-locale={locale}
>
  <div
    class="service-map"
    data-map-canvas
    role="application"
    tabindex="0"
    aria-label={isEnglish ? "Interactive map of the home-visit service area in Novi Sad" : "Интерактивная карта зоны выезда по Нови-Саду"}
  ></div>
  <div class="service-map-legend" aria-label={isEnglish ? "Map legend" : "Легенда карты"}>
    <div><span class="swatch swatch--base" aria-hidden="true"></span><span>{area.legend.base[locale]}</span></div>
    <div><span class="swatch swatch--extended" aria-hidden="true"></span><span>{area.legend.extended[locale]}</span></div>
    <div><span class="swatch swatch--other" aria-hidden="true"></span><span>{area.legend.other[locale]}</span></div>
  </div>
  <p class="service-map-status" data-map-status aria-live="polite">{isEnglish ? "Interactive map loading…" : "Загружаем интерактивную карту…"}</p>
</div>

<script>
  const mapRoots = document.querySelectorAll('[data-service-area-map]');

  const initialiseServiceMap = async (root) => {
    if (root.dataset.initialised === 'true') return;
    root.dataset.initialised = 'true';
    const canvas = root.querySelector('[data-map-canvas]');
    const status = root.querySelector('[data-map-status]');

    try {
      const [{ default: L }, response] = await Promise.all([
        import('leaflet'),
        fetch(root.dataset.geojson, { headers: { accept: 'application/geo+json, application/json' } }),
      ]);
      if (!response.ok) throw new Error('service_area_unavailable');
      const geojson = await response.json();
      const map = L.map(canvas, {
        zoomControl: true,
        attributionControl: true,
        minZoom: 10,
        maxZoom: 18,
      });

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        maxZoom: 19,
      }).addTo(map);

      const popupFor = (zone) => {
        const text = zone === 'base' ? root.dataset.basePopup : root.dataset.extendedPopup;
        const [title, ...details] = text.split('\n');
        const content = document.createElement('div');
        const heading = document.createElement('strong');
        heading.textContent = title;
        content.append(heading);
        if (details.length) {
          content.append(document.createElement('br'), document.createTextNode(details.join(' ')));
        }
        return content;
      };

      const zones = L.geoJSON(geojson, {
        style: (feature) => feature?.properties?.zone === 'base'
          ? { color: '#2c6c50', weight: 2, opacity: 0.9, fillColor: '#55a66e', fillOpacity: 0.38 }
          : { color: '#a68316', weight: 2, opacity: 0.85, fillColor: '#efd84c', fillOpacity: 0.34 },
        onEachFeature: (feature, layer) => {
          const zone = feature?.properties?.zone;
          if (zone === 'base' || zone === 'extended') layer.bindPopup(popupFor(zone));
        },
      }).addTo(map);

      const configuredBounds = geojson?.properties?.initialBounds;
      const bounds = Array.isArray(configuredBounds) ? L.latLngBounds(configuredBounds) : zones.getBounds();
      map.fitBounds(bounds, { padding: [18, 18], maxZoom: 12 });
      root.classList.add('is-loaded');
      status.hidden = true;
      const pointInRing = ([lng, lat], ring) => {
        let inside = false;
        for (let index = 0, previous = ring.length - 1; index < ring.length; previous = index, index += 1) {
          const [lngA, latA] = ring[index];
          const [lngB, latB] = ring[previous];
          if ((latA > lat) !== (latB > lat) && lng < ((lngB - lngA) * (lat - latA)) / (latB - latA) + lngA) inside = !inside;
        }
        return inside;
      };
      const pointInGeometry = (point, geometry) => {
        const polygons = geometry?.type === 'Polygon' ? [geometry.coordinates] : geometry?.type === 'MultiPolygon' ? geometry.coordinates : [];
        return polygons.some((polygon) => pointInRing(point, polygon[0]) && !polygon.slice(1).some((hole) => pointInRing(point, hole)));
      };
      const zoneForPoint = (point) => {
        const base = geojson.features.find((feature) => feature?.properties?.zone === 'base');
        const extended = geojson.features.find((feature) => feature?.properties?.zone === 'extended');
        if (base && pointInGeometry(point, base.geometry)) return 'green';
        if (extended && pointInGeometry(point, extended.geometry)) return 'yellow';
        return 'outside';
      };
      let selection = null;
      const selectLocation = ({ latlng }) => {
        const latitude = Number(latlng.lat.toFixed(3));
        const longitude = Number(latlng.lng.toFixed(3));
        const zone = zoneForPoint([longitude, latitude]);
        if (selection) selection.remove();
        selection = L.circle([latitude, longitude], {
          radius: 350,
          color: zone === 'green' ? '#275f4b' : zone === 'yellow' ? '#9a7710' : '#6e7d76',
          weight: 2,
          fillColor: zone === 'green' ? '#55a66e' : zone === 'yellow' ? '#efd84c' : '#fff',
          fillOpacity: 0.64,
        }).addTo(map);
        const isEnglish = root.dataset.locale === 'en';
        status.hidden = false;
        status.classList.add('is-selection');
        status.textContent = zone === 'green'
          ? isEnglish ? 'Selected: green area · base price' : 'Выбрано: зелёная зона · базовая цена'
          : zone === 'yellow'
            ? isEnglish ? 'Selected: yellow area · +500 RSD per visit' : 'Выбрано: жёлтая зона · +500 RSD за визит'
            : isEnglish
              ? 'This location is outside our usual service area. Message us—we may still be able to arrange a visit.'
              : 'Это место за пределами нашей обычной зоны выезда. Напишите нам — возможно, сможем договориться.';
        window.dispatchEvent(new CustomEvent('homevisit-location-selected', { detail: { zone, latitude, longitude } }));
      };
      zones.on('click', selectLocation);
      map.on('click', selectLocation);
      requestAnimationFrame(() => map.invalidateSize());
    } catch {
      root.classList.add('has-error');
      status.textContent = root.closest('[lang="en"]')
        ? 'We could not load the map. Enter your approximate neighborhood in the form below.'
        : 'Не получилось загрузить карту. Укажите примерный район в форме ниже.';
      window.dispatchEvent(new CustomEvent('homevisit-map-error'));
    }
  };

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        observer.unobserve(entry.target);
        initialiseServiceMap(entry.target);
      }
    }, { rootMargin: '400px 0px' });
    mapRoots.forEach((root) => observer.observe(root));
  } else {
    mapRoots.forEach(initialiseServiceMap);
  }
</script>

<style>
  .service-map-shell { position:relative; min-height:470px; overflow:hidden; border:1px solid #cbd8d1; border-radius:15px; background:#dfe9e3; isolation:isolate; }
  .service-map { width:100%; height:470px; background:#dfe9e3; }
  .service-map-legend { position:absolute; right:12px; bottom:24px; z-index:500; display:grid; gap:7px; width:min(290px,calc(100% - 24px)); border:1px solid rgba(32,51,47,.18); border-radius:10px; padding:11px 13px; background:rgba(255,255,255,.94); box-shadow:0 3px 14px rgba(32,51,47,.13); color:#20332f; font-size:13px; line-height:1.3; pointer-events:none; }
  .service-map-legend>div { display:grid; grid-template-columns:14px 1fr; gap:8px; align-items:center; }
  .swatch { width:14px; height:14px; border:2px solid; border-radius:3px; }
  .swatch--base { border-color:#2c6c50; background:rgba(85,166,110,.55); }
  .swatch--extended { border-color:#a68316; background:rgba(239,216,76,.55); }
  .swatch--other { border-color:#a9b7b0; background:#fff; }
  .service-map-status { position:absolute; inset:50% auto auto 50%; z-index:2; width:min(300px,80%); margin:0; transform:translate(-50%,-50%); color:#52645d; text-align:center; }
  .service-map-status.is-selection { inset:auto 12px 132px 12px; z-index:500; width:auto; border:1px solid rgba(32,51,47,.18); border-radius:9px; padding:9px 12px; transform:none; background:rgba(255,255,255,.95); color:#20332f; font-size:13px; font-weight:700; text-align:left; }
  .is-loaded .service-map-status[hidden] { display:none; }
  .has-error .service-map { display:none; }
  .has-error .service-map-legend { display:none; }
  :global(.service-map .leaflet-control-attribution) { font-size:10px; }
  :global(.service-map .leaflet-popup-content) { margin:12px 16px; color:#20332f; font:14px/1.45 system-ui,sans-serif; }
  @media (max-width:600px) {
    .service-map-shell { min-height:430px; }
    .service-map { height:430px; }
    .service-map-legend { right:8px; bottom:22px; width:calc(100% - 16px); font-size:12px; }
    .service-map-status.is-selection { right:8px; bottom:126px; left:8px; }
  }
</style>
