<script>
  import { calculateHomeVisitQuote, formatRsd } from '../lib/pet-sitting-business.mjs';

  const root = document.querySelector('[data-home-visits-form-root]');
  if (root) {
    const form = root.querySelector('[data-home-form]');
    const status = root.querySelector('[data-form-status]');
    const submit = form.querySelector('button[type="submit"]');
    const dogWalkField = form.querySelector('[data-dog-walk]');
    const locationSummary = form.querySelector('[data-location-summary]');
    const locationAction = form.querySelector('[data-location-action]');
    const locationFallback = form.querySelector('[data-location-fallback]');
    const priceSummary = form.querySelector('[data-live-price]');
    const isEnglish = root.dataset.locale === 'en';
    let started = false;
    const track = (name, extra = {}) => {
      if (typeof window.gtag !== 'function') return;
      window.gtag('event', name, { source_page: root.dataset.sourcePage, locale: root.dataset.locale, service_type: 'home_visit', ...extra });
    };
    const markStarted = () => { if (!started) { started = true; track('home_visits_form_start'); } };
    const values = () => {
      const data = new FormData(form);
      const dates = form.querySelector('[data-home-visit-dates]');
      return {
        dateFrom: dates.dataset.dateFrom || String(data.get('dateFrom') || ''),
        dateTo: dates.dataset.dateTo || String(data.get('dateTo') || ''),
        petType: String(data.get('petType') || 'cat'),
        visitsPerDay: Number(data.get('visitsPerDay') || 1),
        dogWalk: data.get('dogWalk') === 'true',
        serviceZone: root.dataset.serviceZone || String(data.get('serviceZone') || ''),
      };
    };
    const updateForm = () => {
      const current = values();
      const dogInvolved = current.petType === 'dog' || current.petType === 'cat_and_dog';
      dogWalkField.hidden = !dogInvolved;
      if (!dogInvolved) form.querySelector('[name="dogWalk"][value="false"]').checked = true;
      const refreshed = values();
      const quote = refreshed.dateFrom && refreshed.dateTo && refreshed.serviceZone
        ? calculateHomeVisitQuote(refreshed.dateFrom, refreshed.dateTo, refreshed.visitsPerDay, refreshed.dogWalk, refreshed.serviceZone)
        : null;
      priceSummary.textContent = quote?.total
        ? isEnglish ? `Estimated: ${formatRsd(quote.total, 'en')} RSD` : `Ориентировочно: ${formatRsd(quote.total, 'ru')} RSD`
        : quote?.needsConfirmation
          ? isEnglish ? 'We’ll confirm the price after you contact us.' : 'Стоимость подтвердим после связи.'
          : isEnglish ? 'Choose dates and mark your location to see an estimate.' : 'Выберите даты и отметьте место на карте, чтобы увидеть примерную стоимость.';
    };
    form.addEventListener('focusin', markStarted);
    form.addEventListener('input', () => { markStarted(); updateForm(); });
    root.addEventListener('homevisit-dates-change', updateForm);
    window.addEventListener('homevisit-location-selected', (event) => {
      const { zone, latitude, longitude } = event.detail;
      root.dataset.serviceZone = zone;
      root.dataset.approximateLatitude = String(latitude);
      root.dataset.approximateLongitude = String(longitude);
      form.querySelector('[name="serviceZone"]').value = zone;
      form.querySelector('[name="approximateLatitude"]').value = String(latitude);
      form.querySelector('[name="approximateLongitude"]').value = String(longitude);
      form.querySelector('[name="serviceZone"]').setAttribute('value', zone);
      form.querySelector('[name="approximateLatitude"]').setAttribute('value', String(latitude));
      form.querySelector('[name="approximateLongitude"]').setAttribute('value', String(longitude));
      locationSummary.textContent = zone === 'green'
        ? isEnglish ? 'Green area · base price' : 'Зелёная зона · базовая цена'
        : zone === 'yellow'
          ? isEnglish ? 'Yellow area · +500 RSD per visit' : 'Жёлтая зона · +500 RSD за визит'
          : isEnglish ? 'Outside our usual service area · price on request' : 'За пределами обычной зоны · стоимость по запросу';
      locationAction.textContent = isEnglish ? 'Change on the map' : 'Изменить на карте';
      locationFallback.hidden = true;
      updateForm();
    });
    window.addEventListener('homevisit-map-error', () => {
      locationFallback.hidden = false;
      locationFallback.querySelector('input').required = true;
      locationSummary.textContent = isEnglish ? 'Enter your approximate neighborhood below.' : 'Укажите примерный район ниже.';
    });
    document.querySelectorAll('[data-home-telegram]').forEach((link) => link.addEventListener('click', () => track('home_visits_telegram_click', { cta_location: link.dataset.ctaLocation || 'content' })));
    updateForm();
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const current = values();
      const dateFrom = current.dateFrom;
      const dateTo = current.dateTo;
      if (!form.reportValidity()) return;
      if (!dateFrom || !dateTo) { status.textContent = isEnglish ? 'Choose the first and last day.' : 'Выберите первый и последний день.'; status.className = 'form-status is-error'; return; }
      const serviceZone = root.dataset.serviceZone || String(data.get('serviceZone') || '');
      const neighborhood = String(data.get('neighborhood') || '').trim();
      if (!serviceZone && !neighborhood) { status.textContent = isEnglish ? 'Mark your approximate location on the map above.' : 'Отметьте примерное место на карте выше.'; status.className = 'form-status is-error'; return; }
      const usernameRaw = String(data.get('telegramUsername') || '').trim();
      const telegramUsername = usernameRaw.startsWith('@') ? usernameRaw : `@${usernameRaw}`;
      if (!/^@[A-Za-z0-9_]{5,32}$/.test(telegramUsername)) { status.textContent = isEnglish ? 'Enter a valid Telegram username: @username.' : 'Укажите корректный Telegram username: @username.'; status.className = 'form-status is-error'; return; }
      submit.disabled = true;
      status.textContent = isEnglish ? 'Sending…' : 'Отправляем…';
      status.className = 'form-status';
      const petType = String(data.get('petType'));
      const visitsPerDay = Number(data.get('visitsPerDay'));
      const dogWalk = data.get('dogWalk') === 'true' && petType !== 'cat';
      track('home_visits_form_submit', { pet_type: petType, service_zone: serviceZone || 'fallback' });
      try {
        const response = await fetch('/.netlify/functions/pet-sitting-inquiry', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ service_type: 'home_visit', sourcePage: root.dataset.sourcePage, locale: root.dataset.locale, date_from: dateFrom, date_to: dateTo, pet_type: petType, visits_per_day: visitsPerDay, dog_walk: dogWalk, service_zone: serviceZone, approximate_location: serviceZone ? { latitude: Number(root.dataset.approximateLatitude), longitude: Number(root.dataset.approximateLongitude) } : undefined, neighborhood, telegram_username: telegramUsername, optional_comment: String(data.get('optionalComment') || ''), website: String(data.get('website') || '') }) });
        if (!response.ok) throw new Error('request_failed');
        status.textContent = isEnglish ? 'Sent! We’ll reply in Telegram.' : 'Готово! Ответим в Telegram.';
        status.className = 'form-status is-success';
        form.reset();
      } catch {
        status.textContent = isEnglish ? 'Could not send the request. Please message Anna directly in Telegram.' : 'Не получилось отправить запрос. Напишите Ане напрямую в Telegram.';
        status.className = 'form-status is-error';
      } finally { submit.disabled = false; }
    });
  }
</script>

