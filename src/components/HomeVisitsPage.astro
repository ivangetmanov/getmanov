---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeVisitsServiceMap from "./HomeVisitsServiceMap.astro";
import HomeVisitsDateRange from "./HomeVisitsDateRange.astro";
import PetMedia from "./PetMedia.astro";
import { petSittingConfig, telegramUrl } from "../data/pet-sitting";
import { formatRsd, petSittingBusiness } from "../lib/pet-sitting-business.mjs";
import {
  absoluteSiteUrl,
  annaEntity,
  ivanEntity,
  petSittingSchemaIds,
  petSittingWebsiteEntity,
  primaryImageEntity,
} from "../lib/pet-sitting-seo.mjs";

const { locale = "ru" } = Astro.props as { locale?: "ru" | "en" };
const isEnglish = locale === "en";
const path = petSittingBusiness.pagePaths[locale].homeVisits;
const counterpart = petSittingBusiness.pagePaths[isEnglish ? "ru" : "en"].homeVisits;
const title = isEnglish
  ? "In-Home Pet Sitting in Novi Sad | Cat & Dog Home Visits"
  : "Петситтер с выездом на дом в Нови-Саде | Уход за кошками и собаками";
const description = isEnglish
  ? "Anna and Ivan visit cats and dogs in their own homes in Novi Sad for practical care, company, and photo and video updates after each visit."
  : "Аня и Ваня приезжают к кошкам и собакам домой в Нови-Саде: практический уход, общение и фото- и видеоотчёт после визита.";
const h1 = isEnglish ? "Pet Sitting at Your Home in Novi Sad" : "Петситтер с выездом на дом в Нови-Саде";
const heroPhoto = petSittingConfig.heroPhotos.main;
const heroAlt = isEnglish ? "Anna holding Sweet, one of her cats" : "Аня со Свит, одной из своих кошек";
const canonicalUrl = absoluteSiteUrl(path);
const imageUrl = absoluteSiteUrl(heroPhoto);
const imageId = `${imageUrl}#image`;
const webPageId = `${canonicalUrl}#webpage`;
const breadcrumbId = `${canonicalUrl}#breadcrumb`;
const serviceId = petSittingSchemaIds.services.homeVisits;
const telegram = telegramUrl();
const homeVisitRules = petSittingBusiness.homeVisits;

const faq = isEnglish ? [
  ["What's included in a visit?", "A standard visit includes food, fresh water, cleaning the litter box or pet area, play, and company. If needed, we can give familiar medication following your instructions. After every visit, we send photos and videos and tell you how your pet is doing and what we did."],
  ["How long does a visit usually take?", "Usually around 30–60 minutes, depending on your pet and what needs to be done."],
  ["How many times a day can you visit?", "We can arrange one, two, or three visits a day. The minimum order is one visit."],
  ["Can you walk my dog?", "Yes. A visit with an approximately 30-minute walk costs 2,000 RSD. Without a walk, a standard visit costs 1,500 RSD."],
  ["Can you give my pet medication?", "Yes, we can give familiar medication following your instructions. If your pet needs more complex care, we will discuss it with you in advance."],
  ["Will Anna or Ivan be the one visiting?", "One of us will visit, and sometimes we may come together. If you would prefer one particular person, just tell us in advance."],
  ["Can we meet beforehand?", "Yes. If you like, one of us can visit for free to meet your pet, learn their routine, and see where everything is kept."],
  ["How do I give you the keys?", "We will arrange whatever is easiest. You can give them to us when we meet your pet or we can meet separately before you leave."],
  ["Which parts of Novi Sad do you cover?", "You can see our service area on the map above. The base price applies in the green area, while visits in the yellow area cost an extra 500 RSD. If you are unsure, simply mark your approximate location on the map."],
  ["What if I have several pets?", "The standard price covers care for up to three pets at one address. If you have more animals or their care will take substantially longer, we will agree the price in advance."],
  ["Will you send photos and videos?", "Yes. After every visit, we send photos and videos and tell you how your pet is doing and what we did."],
  ["Can I leave my home camera on?", "Of course. If having a camera at home helps you feel more comfortable, we do not mind at all."],
  ["What happens if something goes wrong?", "We will contact you immediately and explain what is happening. If it is urgent and waiting for a reply would be unsafe for your pet, we will contact a veterinarian if needed and let you know as soon as possible."],
  ["How do I pay for the visits?", "Visits are paid for in cash before the service begins."],
] : [
  ["Что входит в визит?", "В обычный визит входят кормление, свежая вода, уборка лотка или места питомца, игры и общение. Если нужно, можем дать привычные лекарства по вашей инструкции. После каждого визита присылаем фото и видео и рассказываем, как питомец себя чувствует и что мы сделали."],
  ["Сколько длится один визит?", "Обычно около 30–60 минут — в зависимости от питомца и того, что нужно сделать."],
  ["Сколько раз в день вы можете приезжать?", "Можно договориться об одном, двух или трёх визитах в день. Минимальный заказ — один визит."],
  ["Можно ли погулять с собакой?", "Да. Визит с прогулкой около 30 минут стоит 2 000 RSD. Если прогулка не нужна, обычный визит стоит 1 500 RSD."],
  ["Можно ли дать питомцу лекарства?", "Да, можем дать привычные лекарства по вашей инструкции. Если уход сложнее обычного, обсудим его заранее."],
  ["Кто будет приходить — Аня или Ваня?", "На визит приезжает кто-то из нас, а иногда можем приехать вдвоём. Если для вас важно, чтобы приходил конкретно кто-то один, скажите об этом заранее."],
  ["Можно ли познакомиться заранее?", "Да. Если хотите, один из нас бесплатно приедет познакомиться с питомцем, узнать его режим и посмотреть, где лежит всё необходимое."],
  ["Как передать ключи?", "Договоримся так, как будет удобно. Можно передать их при знакомстве или встретиться отдельно перед вашим отъездом."],
  ["В какие районы Нови-Сада вы приезжаете?", "Зону выезда можно посмотреть на карте выше. В зелёной зоне действует базовая цена, в жёлтой к стоимости визита добавляется 500 RSD. Если не уверены, просто отметьте примерное место на карте."],
  ["Что если у меня несколько питомцев?", "В обычную стоимость входит уход максимум за тремя питомцами по одному адресу. Если животных больше или уход требует заметно больше времени, договоримся о цене заранее."],
  ["Будете присылать фото и видео?", "Да. После каждого визита присылаем фото и видео и рассказываем, как питомец себя чувствует и что мы сделали."],
  ["Можно оставить включённой домашнюю камеру?", "Конечно. Если дома есть камера и вам спокойнее дополнительно наблюдать за питомцем, мы совершенно не против."],
  ["Что будет, если с питомцем что-то случится?", "Сразу свяжемся с вами и расскажем, что происходит. Если ситуация срочная и ждать ответа небезопасно для питомца, при необходимости обратимся к ветеринару и сообщим вам об этом как можно скорее."],
  ["Как оплачиваются визиты?", "Визиты оплачиваются наличными заранее, до начала услуги."],
];

const careItems = isEnglish
  ? ["Food, bowls, and fresh water", "Litter box and basic cleaning around your pet", "Play and company", "Familiar medication following your instructions", "Photos and videos", "An update on how your pet is doing and what we did"]
  : ["Корм, миски и свежая вода", "Лоток и базовая уборка места питомца", "Игры и общение", "Привычные лекарства по инструкции", "Фото и видео", "Рассказ о состоянии питомца и о том, что сделали"];
const fitItems = isEnglish
  ? ["Your cat is calmer in familiar territory", "Your pet does not need overnight boarding", "You are away and need someone to check, feed, and spend time with your pet", "A journey and a new home would be an unnecessary change"]
  : ["Кошке спокойнее на знакомой территории", "Питомцу не нужна передержка с ночёвкой", "Вы уезжаете, а питомца нужно проверить, покормить и не оставлять совсем без общения", "Поездка и новое место будут лишней переменой"];
const howItWorks = isEnglish ? [
  ["Send a request", "We check the neighborhood, dates, and whether we can visit."],
  ["Meet beforehand if you like", "One of us can visit for free to meet your pet and see where everything is kept."],
  ["We follow the agreed schedule", "After every visit, we send photos and videos and tell you how your pet is doing and what we did."],
] : [
  ["Оставляете запрос", "Проверяем район, даты и возможность приезжать."],
  ["Если хотите, знакомимся заранее", "Один из нас может бесплатно приехать, чтобы познакомиться с питомцем и посмотреть, где что лежит."],
  ["Приезжаем по графику", "После каждого визита присылаем фото и видео и рассказываем, как питомец себя чувствует и что мы сделали."],
];
const guides = isEnglish ? [
  { href: "/en/novi-sad/pet-sitting/pet-sitter-vs-boarding/", title: "Pet sitter, home boarding, or pet hotel" },
  { href: "/en/novi-sad/pet-sitting/can-cat-stay-alone-for-a-week/", title: "Can a cat stay alone for a week?" },
] : [
  { href: "/ru/novi-sad/pet-sitting/pet-sitter-vs-boarding/", title: "Петситтер, домашняя передержка или зоогостиница" },
  { href: "/ru/novi-sad/pet-sitting/can-cat-stay-alone-for-a-week/", title: "Можно ли оставить кошку одну на неделю" },
];
const knownProof = isEnglish ? [
  { src: "/images/pet-sitting/dog-guest-02.webp", alt: "Small ginger dog Shady resting in Anna and Ivan's home", caption: "Shady relaxing in our home." },
  { src: "/images/pet-sitting/cat-guest-03.webp", alt: "Striped cat Pepe resting next to Anna", caption: "Pepe resting next to Anna." },
  { src: "/images/pet-sitting/dog-guest-04.webp", alt: "Small ginger dog Shady playing with Ivan", caption: "Shady playing with Ivan." },
  { src: "/images/pet-sitting/cat-guest-04.webp", alt: "Striped cat Pepe and Pablo resting together", caption: "Pepe and Pablo resting together." },
] : [
  { src: "/images/pet-sitting/dog-guest-02.webp", alt: "Маленькая рыжая собака Шэди отдыхает у Ани и Вани дома", caption: "Шэди отдыхает у нас дома." },
  { src: "/images/pet-sitting/cat-guest-03.webp", alt: "Полосатый кот Пепе отдыхает рядом с Аней", caption: "Пепе отдыхает рядом с Аней." },
  { src: "/images/pet-sitting/dog-guest-04.webp", alt: "Маленькая рыжая собака Шэди играет с Ваней", caption: "Шэди играет с Ваней." },
  { src: "/images/pet-sitting/cat-guest-04.webp", alt: "Полосатый кот Пепе и Пабло отдыхают вместе", caption: "Пепе и Пабло отдыхают вместе." },
];
const knownSources = new Set(knownProof.map((photo) => photo.src));
const galleryPhotos = [
  ...knownProof,
  ...petSittingConfig.guestPhotos.filter((photo) => !knownSources.has(photo.src)).map((photo) => ({ src: photo.src, alt: isEnglish ? photo.altEn : photo.alt })),
  ...petSittingConfig.residentCats.map((cat) => ({ src: cat.image, alt: isEnglish ? `${cat.nameEn}, our cat` : `${cat.name}, наш кот` })),
];
const galleryVideos = petSittingConfig.guestVideos.map((video) => ({
  ...video,
  title: isEnglish ? video.animal === "cat" ? "A cat we cared for" : "A dog we cared for" : video.animal === "cat" ? "Кошка, о которой мы заботились" : "Собака, о которой мы заботились",
}));

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    petSittingWebsiteEntity(),
    ivanEntity(),
    annaEntity(),
    primaryImageEntity({ url: imageUrl, width: 1290, height: 1039 }),
    {
      "@type": "WebPage", "@id": webPageId, url: canonicalUrl, name: title, description,
      inLanguage: locale, isPartOf: { "@id": petSittingSchemaIds.website },
      primaryImageOfPage: { "@id": imageId }, mainEntity: { "@id": serviceId }, breadcrumb: { "@id": breadcrumbId },
    },
    {
      "@type": "Service", "@id": serviceId,
      name: isEnglish ? "In-home pet sitting in Novi Sad" : "Петситтинг с выездом на дом в Нови-Саде",
      description, serviceType: "In-home pet sitting and pet home visits", image: { "@id": imageId },
      provider: [{ "@id": petSittingSchemaIds.anna }, { "@id": petSittingSchemaIds.ivan }],
      areaServed: [{ "@type": "City", name: "Novi Sad" }], subjectOf: { "@id": webPageId },
    },
    {
      "@type": "BreadcrumbList", "@id": breadcrumbId,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: isEnglish ? "Home" : "Главная", item: "https://getmanov.com/" },
        { "@type": "ListItem", position: 2, name: isEnglish ? "Pet sitting in Novi Sad" : "Уход за питомцами в Нови-Саде", item: absoluteSiteUrl(petSittingBusiness.pagePaths[locale].main) },
        { "@type": "ListItem", position: 3, name: isEnglish ? "Home visits" : "Выезды домой", item: canonicalUrl },
      ],
    },
    {
      "@type": "FAQPage", "@id": `${canonicalUrl}#faq`, isPartOf: { "@id": webPageId },
      mainEntity: faq.map(([question, answer]) => ({ "@type": "Question", name: question, acceptedAnswer: { "@type": "Answer", text: answer } })),
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={path}
  lang={locale}
  structuredData={structuredData}
  alternates={[
    { hreflang: "ru", href: isEnglish ? counterpart : path },
    { hreflang: "en", href: isEnglish ? path : counterpart },
    { hreflang: "x-default", href: isEnglish ? path : counterpart },
  ]}
  image={heroPhoto}
  imageAlt={heroAlt}
  imageWidth={1290}
  imageHeight={1039}
>
  <div class="home-visits-page">
    <section class="hv-hero" data-page-section="hero">
      <div class="hv-hero__heading">
        <p class="eyebrow">{isEnglish ? "Home visits · Novi Sad" : "Выезды домой · Нови-Сад"}</p>
        <h1>{h1}</h1>
      </div>
      <figure class="hv-hero__media">
        <img src={heroPhoto} alt={heroAlt} width="1290" height="1039" />
        <figcaption>{isEnglish ? "Anna with Sweet, one of our cats." : "Аня со Свит, одной из наших кошек."}</figcaption>
      </figure>
      <div class="hv-hero__details">
        <p>{isEnglish ? "We’re Anna and Ivan. If your pet is calmer at home, we can visit them in Novi Sad, take care of the essentials, and keep them company." : "Мы — Аня и Ваня. Если питомцу спокойнее остаться дома, можем приезжать к нему в Нови-Саде, заботиться обо всём необходимом и составлять компанию."}</p>
        <p class="hero-facts">{isEnglish ? `From ${formatRsd(homeVisitRules.standardVisitPrice, "en")} RSD per visit · around ${homeVisitRules.usualDurationMinutes.min}–${homeVisitRules.usualDurationMinutes.max} minutes · photos and videos after every visit` : `От ${formatRsd(homeVisitRules.standardVisitPrice, "ru")} RSD за визит · около ${homeVisitRules.usualDurationMinutes.min}–${homeVisitRules.usualDurationMinutes.max} минут · фото и видео после каждого визита`}</p>
        <div class="actions">
          <a class="button button--primary" href="#request">{isEnglish ? "Send a request" : "Оставить запрос"}</a>
          <a class="button" href={telegram} data-home-telegram data-cta-location="hero" target="_blank" rel="noreferrer">{isEnglish ? "Message Anna on Telegram" : "Написать Ане в Telegram"}</a>
        </div>
      </div>
    </section>

    <section class="proof-section" aria-labelledby="proof-title" data-page-section="proof">
      <div><h2 id="proof-title">{isEnglish ? "Our experience with pets" : "Наш опыт с питомцами"}</h2><p>{isEnglish ? "Some of the animals we have already cared for. Some photos were taken during home boarding." : "Некоторые животные, о которых мы уже заботились. Часть фотографий сделана во время домашней передержки."}</p></div>
      <PetMedia photos={galleryPhotos} videos={galleryVideos} label={isEnglish ? "pets we have cared for" : "питомцев, о которых мы заботились"} videoLabel={isEnglish ? "Pet care video" : "Видео с питомцем"} locale={locale} primaryPhotosFirst />
      <p class="reporting-callout">{homeVisitRules.reportingCopy[locale]}</p>
    </section>

    <section class="area-section" aria-labelledby="area-title" data-page-section="area-price">
      <div class="area-copy"><h2 id="area-title">{isEnglish ? "Service area in Novi Sad" : "Зона выезда по Нови-Саду"}</h2><p>{homeVisitRules.serviceArea.copy[locale]}</p><p>{homeVisitRules.serviceArea.noteCopy[locale]}</p></div>
      <HomeVisitsServiceMap locale={locale} />
      <div class="pricing-wrap"><h3>{isEnglish ? "Visit pricing" : "Стоимость визита"}</h3><div class="price-cards"><div><span>{isEnglish ? "Standard home visit" : "Обычный визит домой"}</span><strong>{formatRsd(homeVisitRules.standardVisitPrice, locale)} RSD</strong></div><div><span>{isEnglish ? "Dog visit with an approximately 30-minute walk" : "Визит к собаке с прогулкой около 30 минут"}</span><strong>{formatRsd(homeVisitRules.dogVisitWithWalkPrice, locale)} RSD</strong></div></div><p>{isEnglish ? "You can book one, two, or three visits a day. The minimum order is one visit." : "Можно заказать один, два или три визита в день. Минимальный заказ — один визит."}</p><p>{isEnglish ? "A standard visit covers care for up to three pets at one address. If you have more animals or their care will take substantially longer, we will agree the price in advance." : "В стоимость обычного визита входит уход максимум за тремя питомцами по одному адресу. Если животных больше или уход требует заметно больше времени, договоримся о цене заранее."}</p></div>
    </section>

    <section class="request-section" id="request" aria-labelledby="request-title" data-page-section="request" data-home-visits-form-root data-locale={locale} data-source-page={path}>
      <div class="request-intro"><h2 id="request-title">{isEnglish ? "Fill in the short form or message Anna directly on Telegram" : "Заполните короткую форму или сразу напишите Ане в Telegram"}</h2><p>{isEnglish ? "Share your dates and a few details. We’ll check the route and whether we can visit on those days, then reply in Telegram." : "Укажите даты и несколько деталей. Проверим маршрут и возможность приехать в эти дни и ответим вам в Telegram."}</p><a class="button request-telegram" href={telegram} data-home-telegram data-cta-location="form-choice" target="_blank" rel="noreferrer">{isEnglish ? "Message Anna on Telegram" : "Написать Ане в Telegram"}</a></div>
      <form class="home-form" data-home-form novalidate>
        <HomeVisitsDateRange locale={locale} />
        <fieldset><legend>{isEnglish ? "Pet" : "Питомец"}</legend><div class="segments"><label><input type="radio" name="petType" value="cat" checked /><span>{isEnglish ? "Cat" : "Кошка"}</span></label><label><input type="radio" name="petType" value="dog" /><span>{isEnglish ? "Dog" : "Собака"}</span></label><label><input type="radio" name="petType" value="cat_and_dog" /><span>{isEnglish ? "Cat & dog" : "Кошка и собака"}</span></label></div></fieldset>
        <fieldset><legend>{isEnglish ? "Visits per day" : "Визитов в день"}</legend><div class="segments segments--numbers"><label><input type="radio" name="visitsPerDay" value="1" checked /><span>1</span></label><label><input type="radio" name="visitsPerDay" value="2" /><span>2</span></label><label><input type="radio" name="visitsPerDay" value="3" /><span>3</span></label></div></fieldset>
        <fieldset data-dog-walk hidden><legend>{isEnglish ? "Does your dog need a walk?" : "Нужна прогулка?"}</legend><div class="segments segments--walk"><label><input type="radio" name="dogWalk" value="false" checked /><span>{isEnglish ? "No" : "Нет"}</span></label><label><input type="radio" name="dogWalk" value="true" /><span>{isEnglish ? "Yes, around 30 minutes" : "Да, около 30 минут"}</span></label></div></fieldset>
        <div class="location-choice"><strong>{isEnglish ? "Location" : "Место"}</strong><p data-location-summary>{isEnglish ? "Mark your approximate location on the map above" : "Отметьте примерное место на карте выше"}</p><a href="#area-title" data-location-action>{isEnglish ? "Choose on the map" : "Отметить на карте"}</a></div>
        <input type="hidden" name="serviceZone" /><input type="hidden" name="approximateLatitude" /><input type="hidden" name="approximateLongitude" />
        <label class="location-fallback" data-location-fallback hidden>{isEnglish ? "Approximate neighborhood" : "Примерный район"}<input type="text" name="neighborhood" maxlength="120" placeholder={isEnglish ? "For example: Liman 2 or Petrovaradin" : "Например: Лиман 2 или Петроварадин"} /></label>
        <label>{isEnglish ? "Comment — optional" : "Комментарий — необязательно"}<textarea name="optionalComment" rows="3" maxlength="1000" placeholder={isEnglish ? "For example: two cats, medication, or something important about your pet" : "Например: два кота, нужны лекарства или что-то важное про питомца"}></textarea></label>
        <label>{isEnglish ? "Your Telegram" : "Ваш Telegram"}<input type="text" name="telegramUsername" autocomplete="username" placeholder="@username" pattern="@?[A-Za-z0-9_]{5,32}" required /></label>
        <p class="live-price" data-live-price aria-live="polite">{isEnglish ? "Choose dates and mark your location to see an estimate." : "Выберите даты и отметьте место на карте, чтобы увидеть примерную стоимость."}</p>
        <div class="honeypot" aria-hidden="true"><label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
        <button class="button button--primary" type="submit">{isEnglish ? "Send request" : "Отправить запрос"}</button>
        <p class="form-status" data-form-status role="status" aria-live="polite">{isEnglish ? "We’ll reply in Telegram after checking the details." : "Ответим в Telegram после проверки деталей."}</p>
      </form>
    </section>

    <section class="how-section" aria-labelledby="how-title" data-page-section="how"><div><h2 id="how-title">{isEnglish ? "How it works" : "Как всё происходит"}</h2></div><ol>{howItWorks.map(([stepTitle, copy], index) => <li><span>{index + 1}</span><div><strong>{stepTitle}</strong><p>{copy}</p></div></li>)}</ol></section>
    <section class="split-section" aria-labelledby="visit-includes-title" data-page-section="includes"><div><h2 id="visit-includes-title">{isEnglish ? "What's included in a visit" : "Что входит в визит"}</h2><p>{isEnglish ? "Before the first visit, we will agree exactly what your pet needs." : "Перед первым визитом договоримся, что именно нужно вашему питомцу."}</p></div><ul class="check-grid">{careItems.map((item) => <li>{item}</li>)}</ul></section>
    <section class="trust-section" aria-labelledby="trust-title" data-page-section="people"><div><h2 id="trust-title">{isEnglish ? "Anna and Ivan" : "Аня и Ваня"}</h2></div><div class="trust-copy"><p>{isEnglish ? "We are Anna and Ivan, a married couple. We lived in Vietnam for three years, where we adopted two cats from a shelter, and now live with them in Petrovaradin. We both work remotely: Ivan in marketing and Anna as a CSM." : "Мы — Аня и Ваня, муж и жена. Три года жили во Вьетнаме, где взяли из приюта двух котов, а теперь живём вместе с ними в Петроварадине. Оба работаем удалённо: Ваня — в маркетинге, Аня — CSM."}</p><p>{homeVisitRules.whoVisitsCopy[locale]}</p></div></section>
