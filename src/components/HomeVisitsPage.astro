---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeVisitsServiceMap from "./HomeVisitsServiceMap.astro";
import { petSittingConfig, telegramUrl } from "../data/pet-sitting";
import { formatRsd, petSittingBusiness } from "../lib/pet-sitting-business.mjs";
import {
  absoluteSiteUrl,
  annaEntity,
  ivanEntity,
  petSittingSchemaIds,
  petSittingWebsiteEntity,
  primaryImageEntity,
} from "../lib/pet-sitting-seo.mjs";

const { locale = "ru" } = Astro.props as { locale?: "ru" | "en" };
const isEnglish = locale === "en";
const path = petSittingBusiness.pagePaths[locale].homeVisits;
const counterpart = petSittingBusiness.pagePaths[isEnglish ? "ru" : "en"].homeVisits;
const title = isEnglish
  ? "In-Home Pet Sitting in Novi Sad | Cat & Dog Home Visits"
  : "Петситтер с выездом на дом в Нови-Саде | Уход за кошками и собаками";
const description = isEnglish
  ? "Anna and Ivan visit cats and dogs in their own homes in Novi Sad for practical care, company, and photo and video updates after each visit."
  : "Аня и Ваня приезжают к кошкам и собакам домой в Нови-Саде: практический уход, общение и фото- и видеоотчёт после визита.";
const h1 = isEnglish ? "Pet Sitting at Your Home in Novi Sad" : "Петситтер с выездом на дом в Нови-Саде";
const heroPhoto = petSittingConfig.heroPhotos.main;
const heroAlt = isEnglish ? "Anna holding one of her cats" : "Аня с одним из своих котов";
const canonicalUrl = absoluteSiteUrl(path);
const imageUrl = absoluteSiteUrl(heroPhoto);
const imageId = `${imageUrl}#image`;
const webPageId = `${canonicalUrl}#webpage`;
const breadcrumbId = `${canonicalUrl}#breadcrumb`;
const serviceId = petSittingSchemaIds.services.homeVisits;
const telegram = telegramUrl();
const homeVisitRules = petSittingBusiness.homeVisits;

const faq = isEnglish ? [
  ["What does a pet sitter do during a home visit?", "We agree the care list in advance. A standard visit can include feeding, fresh water, basic cleaning around the pet, play and company, medication following your instructions, and a detailed update."],
  ["Can you visit a cat over several days?", "Yes. Send the dates, number of pets, approximate neighborhood, and care details. We will confirm whether we can cover the full period."],
  ["Which parts of Novi Sad do you visit?", homeVisitRules.serviceArea.copy.en],
  ["Will you send photos and videos?", homeVisitRules.reportingCopy.en],
  ["How are home visits different from boarding?", "With a home visit, your pet stays in their own home and we come to them. With boarding, your pet temporarily lives with us in our Petrovaradin apartment."],
  ["How long is a visit?", `Usually around ${homeVisitRules.usualDurationMinutes.min}–${homeVisitRules.usualDurationMinutes.max} minutes, depending on the pet and what needs to be done.`],
  ["How many visits per day can I request?", "You can request one, two, or three visits per day. One-off visits are also welcome, and the minimum order is one visit."],
  ["Can you walk my dog?", `Yes. A dog visit with an approximately ${homeVisitRules.dogWalkMinutes}-minute walk costs ${formatRsd(homeVisitRules.dogVisitWithWalkPrice, "en")} RSD. A standalone walk of the same approximate length is also available at the same price.`],
  ["Can you give medication?", "We can give medication according to your instructions. Veterinary procedures, injections, and more complex medical care must be discussed individually."],
  ["Can we meet before the first booking?", "Yes. The optional introductory meeting is free and Anna will usually handle it. We can meet the pet, see the setup, learn the routine, locate supplies, arrange access, and discuss emergency instructions."],
  ["Who will come to my home?", homeVisitRules.whoVisitsCopy.en],
  ["How do keys and access work?", homeVisitRules.accessCopy.en],
  ["Can I use a home camera?", "Absolutely. If you notice something worrying, contact us; depending on availability, we may be able to make an additional urgent visit, but we cannot guarantee an emergency response at every hour."],
  ["How do payment and cancellations work?", homeVisitRules.paymentCopy.en],
  ["What happens in an emergency?", "We contact you immediately and do not silently wait if something is wrong. If waiting would endanger your pet, we act reasonably, contact a veterinarian if necessary, and update you as quickly as possible."],
] : [
  ["Что делает петситтер во время визита?", "Заранее согласуем список ухода. Обычный визит может включать кормление, свежую воду, базовую уборку места питомца, игры и общение, лекарства по вашей инструкции и подробный отчёт."],
  ["Можно ли приходить к кошке несколько дней подряд?", "Да. Укажите даты, количество питомцев, примерный район и детали ухода. Мы подтвердим, сможем ли приезжать весь нужный период."],
  ["В какие районы Нови-Сада вы приезжаете?", homeVisitRules.serviceArea.copy.ru],
  ["Будете присылать фото и видео?", homeVisitRules.reportingCopy.ru],
  ["Чем визиты на дом отличаются от передержки?", "При выезде питомец остаётся у себя дома, а мы приезжаем к нему. При передержке питомец временно живёт у нас в квартире в Петроварадине."],
  ["Сколько длится визит?", `Обычно визит занимает около ${homeVisitRules.usualDurationMinutes.min}–${homeVisitRules.usualDurationMinutes.max} минут — в зависимости от питомца и того, что нужно сделать.`],
  ["Сколько раз в день можно приезжать?", "Можно выбрать один, два или три визита в день. Разовый визит тоже возможен, минимальный заказ — один визит."],
  ["Можно ли погулять с собакой?", `Да. Визит с прогулкой около ${homeVisitRules.dogWalkMinutes} минут стоит ${formatRsd(homeVisitRules.dogVisitWithWalkPrice, "ru")} RSD. Отдельную прогулку примерно такой же длительности тоже можно заказать по той же цене.`],
  ["Можно ли дать питомцу лекарства?", "Можем дать лекарства по вашей инструкции. Ветеринарные процедуры, уколы и более сложный медицинский уход обсуждаем индивидуально."],
  ["Можно познакомиться до первого заказа?", "Да. Встреча необязательна и бесплатна; обычно приезжает Аня. Познакомимся с питомцем, посмотрим домашнюю обстановку, узнаем режим, найдём всё необходимое, договоримся о доступе и обсудим экстренные инструкции."],
  ["Кто именно будет приходить?", homeVisitRules.whoVisitsCopy.ru],
  ["Как передать ключи и организовать доступ?", homeVisitRules.accessCopy.ru],
  ["Можно ли оставить включённой домашнюю камеру?", "Конечно. Если заметите через камеру что-то тревожное, напишите нам: в зависимости от графика мы, возможно, сможем приехать дополнительно, но не обещаем экстренный выезд в любое время."],
  ["Как устроены оплата и отмена?", homeVisitRules.paymentCopy.ru],
  ["Что будет в экстренной ситуации?", "Сразу связываемся с вами и не ждём молча, если что-то не так. Если ожидание опасно для питомца, действуем разумно, при необходимости обращаемся к ветеринару и как можно быстрее сообщаем вам."],
];

const careItems = isEnglish
  ? ["Food and fresh water", "Litter-box and basic pet-area cleaning", "Play and quiet company", "Simple pet care and medication following your instructions", "A couple of photos and videos after every visit", "A written update about your pet and what was done"]
  : ["Корм и свежая вода", "Лоток и базовая уборка места питомца", "Игры и спокойное общение", "Простой уход и лекарства по вашей инструкции", "Пара фотографий и видео после каждого визита", "Письменный отчёт о питомце и сделанном уходе"];
const fitItems = isEnglish
  ? ["Your cat is calmer in familiar territory", "Your pet does not need overnight boarding", "You are away and need someone to check, feed, and spend time with your pet", "A journey and a new home would be an unnecessary change"]
  : ["Кошке спокойнее на знакомой территории", "Питомцу не нужна передержка с ночёвкой", "Вы уезжаете, а питомца нужно проверить, покормить и не оставлять совсем без общения", "Поездка и новое место будут лишней переменой"];
const prepItems = isEnglish
  ? ["Food, bowls, and the usual water setup", "Litter box and litter, where relevant", "Medication and clear instructions", "Leash or harness, where relevant", "Toys and familiar pet items", "Keys or agreed access", "Information about where necessary things are kept", "Secured windows and dangerous items kept out of reach"]
  : ["Корм, миски и привычный запас воды", "Лоток и наполнитель, если нужны", "Лекарства и понятные инструкции", "Поводок или шлейка, если нужны", "Игрушки и привычные вещи питомца", "Ключи или согласованный доступ", "Информация о том, где лежит всё необходимое", "Закрытые окна и недоступные опасные предметы"];
const guides = isEnglish ? [
  { href: "/en/novi-sad/pet-sitting/pet-sitter-vs-boarding/", title: "Pet sitter, home boarding, or pet hotel" },
  { href: "/en/novi-sad/pet-sitting/can-cat-stay-alone-for-a-week/", title: "Can a cat stay alone for a week?" },
] : [
  { href: "/ru/novi-sad/pet-sitting/pet-sitter-vs-boarding/", title: "Петситтер, домашняя передержка или зоогостиница" },
  { href: "/ru/novi-sad/pet-sitting/can-cat-stay-alone-for-a-week/", title: "Можно ли оставить кошку одну на неделю" },
];
const proofPhotos = isEnglish ? [
  { src: "/images/pet-sitting/dog-guest-02.webp", alt: "Shady resting while staying with Anna and Ivan", caption: "Shady. Our existing media shows our real experience with pets; it is not presented as a client-home visit." },
  { src: "/images/pet-sitting/cat-guest-03.webp", alt: "Pepe resting next to Anna", caption: "Pepe resting next to Anna." },
  { src: "/images/pet-sitting/dog-guest-04.webp", alt: "Guinness playing with Ivan", caption: "Guinness playing with Ivan." },
  { src: "/images/pet-sitting/cat-guest-04.webp", alt: "Pepe and Pablo resting together", caption: "Pepe and Pablo resting together." },
] : [
  { src: "/images/pet-sitting/dog-guest-02.webp", alt: "Шэди отдыхает рядом с Аней и Ваней", caption: "Шэди. Здесь наш опыт с животными; мы не выдаём фото с передержки за визит в доме клиента." },
  { src: "/images/pet-sitting/cat-guest-03.webp", alt: "Пепе отдыхает рядом с Аней", caption: "Пепе отдыхает рядом с Аней." },
  { src: "/images/pet-sitting/dog-guest-04.webp", alt: "Гинесс играет с Ваней", caption: "Гинесс играет с Ваней." },
  { src: "/images/pet-sitting/cat-guest-04.webp", alt: "Пепе и Пабло отдыхают вместе", caption: "Пепе и Пабло отдыхают вместе." },
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    petSittingWebsiteEntity(),
    ivanEntity(),
    annaEntity(),
    primaryImageEntity({ url: imageUrl, width: 1290, height: 1039 }),
    {
      "@type": "WebPage", "@id": webPageId, url: canonicalUrl, name: title, description,
      inLanguage: locale, isPartOf: { "@id": petSittingSchemaIds.website },
      primaryImageOfPage: { "@id": imageId }, mainEntity: { "@id": serviceId }, breadcrumb: { "@id": breadcrumbId },
    },
    {
      "@type": "Service", "@id": serviceId,
      name: isEnglish ? "In-home pet sitting in Novi Sad" : "Петситтинг с выездом на дом в Нови-Саде",
      description, serviceType: "In-home pet sitting and pet home visits", image: { "@id": imageId },
      provider: [{ "@id": petSittingSchemaIds.anna }, { "@id": petSittingSchemaIds.ivan }],
      areaServed: [{ "@type": "City", name: "Novi Sad" }], subjectOf: { "@id": webPageId },
    },
    {
      "@type": "BreadcrumbList", "@id": breadcrumbId,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: isEnglish ? "Home" : "Главная", item: "https://getmanov.com/" },
        { "@type": "ListItem", position: 2, name: isEnglish ? "Pet sitting in Novi Sad" : "Уход за питомцами в Нови-Саде", item: absoluteSiteUrl(petSittingBusiness.pagePaths[locale].main) },
        { "@type": "ListItem", position: 3, name: isEnglish ? "Home visits" : "Выезды домой", item: canonicalUrl },
      ],
    },
    {
      "@type": "FAQPage", "@id": `${canonicalUrl}#faq`, isPartOf: { "@id": webPageId },
      mainEntity: faq.map(([question, answer]) => ({ "@type": "Question", name: question, acceptedAnswer: { "@type": "Answer", text: answer } })),
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={path}
  lang={locale}
  structuredData={structuredData}
  alternates={[
    { hreflang: "ru", href: isEnglish ? counterpart : path },
    { hreflang: "en", href: isEnglish ? path : counterpart },
    { hreflang: "x-default", href: isEnglish ? path : counterpart },
  ]}
  image={heroPhoto}
  imageAlt={heroAlt}
  imageWidth={1290}
  imageHeight={1039}
>
  <div class="home-visits-page">
    <section class="hv-hero">
      <div class="hv-hero__heading">
        <p class="eyebrow">{isEnglish ? "Home visits · Novi Sad" : "Выезды домой · Нови-Сад"}</p>
        <h1>{h1}</h1>
      </div>
      <figure class="hv-hero__media">
        <img src={heroPhoto} alt={heroAlt} width="1290" height="1039" />
        <figcaption>{isEnglish ? "Anna, one of the two people who may visit your pet." : "Аня — один из двух людей, которые могут приезжать к питомцу."}</figcaption>
      </figure>
      <div class="hv-hero__details">
        <p>{isEnglish ? `We’re Anna and Ivan. If your pet is calmer at home, we can come to them in Novi Sad: provide practical care and company, then ${homeVisitRules.reportingCopy.en.charAt(0).toLowerCase()}${homeVisitRules.reportingCopy.en.slice(1)}` : `Мы — Аня и Ваня. Если питомцу спокойнее остаться дома, можем приезжать к нему в Нови-Саде: обеспечить нужный уход и общение. ${homeVisitRules.reportingCopy.ru}`}</p>
        <div class="actions">
          <a class="button button--primary" href="#request">{isEnglish ? "Send a request" : "Оставить запрос"}</a>
          <a class="button" href={telegram} data-home-telegram data-cta-location="hero" target="_blank" rel="noreferrer">{isEnglish ? "Message Anna on Telegram" : "Написать Ане в Telegram"}</a>
        </div>
      </div>
    </section>

    <aside class="service-definition" aria-label={isEnglish ? "Difference between services" : "Разница между услугами"}>
      <div><strong>{isEnglish ? "Home boarding" : "Домашняя передержка"}</strong><span>{isEnglish ? "Your pet stays in our home." : "Питомец живёт у нас дома."}</span></div>
      <div><strong>{isEnglish ? "Home visits" : "Выезды домой"}</strong><span>{isEnglish ? "Your pet stays home; we come to them." : "Питомец остаётся дома; мы приезжаем к нему."}</span></div>
    </aside>

    <section class="split-section" aria-labelledby="visit-includes-title">
      <div><p class="eyebrow">{isEnglish ? "Practical care" : "Практический уход"}</p><h2 id="visit-includes-title">{isEnglish ? "What a visit can include" : "Что может входить в визит"}</h2><p>{isEnglish ? "We agree the exact care list before confirming the request." : "Точный список заранее согласуем перед подтверждением заявки."}</p></div>
      <ul class="check-grid">{careItems.map((item) => <li>{item}</li>)}</ul>
    </section>

    <section class="split-section split-section--soft" aria-labelledby="fit-title">
      <div><p class="eyebrow">{isEnglish ? "A familiar environment" : "Знакомая обстановка"}</p><h2 id="fit-title">{isEnglish ? "When home visits make sense" : "Кому подойдут выезды домой"}</h2></div>
      <ul class="check-grid">{fitItems.map((item) => <li>{item}</li>)}</ul>
    </section>

    <section class="trust-section" aria-labelledby="trust-title">
      <div><p class="eyebrow">{isEnglish ? "Specific people, not a marketplace" : "Конкретные люди, не маркетплейс"}</p><h2 id="trust-title">{isEnglish ? "Anna and Ivan" : "Аня и Ваня"}</h2></div>
      <div class="trust-copy">
        <p>{isEnglish ? "We are a married couple. We lived in Vietnam for three years, adopted our two cats from a shelter there, and now live with them in Petrovaradin. We both work remotely—Ivan in marketing and Anna as a CSM." : "Мы муж и жена. Три года жили во Вьетнаме, там взяли из приюта двух котов, а теперь живём вместе с ними в Петроварадине. Оба работаем удалённо: Ваня — в маркетинге, Аня — CSM."}</p>
        <p>{homeVisitRules.whoVisitsCopy[locale]}</p>
      </div>
    </section>

    <section class="area-section" aria-labelledby="area-title">
      <div class="area-copy">
        <p class="eyebrow">{isEnglish ? "Service area" : "Зона выезда"}</p>
        <h2 id="area-title">{isEnglish ? "Our service area in Novi Sad" : "Зона выезда по Нови-Саду"}</h2>
        <p>{homeVisitRules.serviceArea.copy[locale]}</p>
        <div class="area-lists">
          <div><strong>{homeVisitRules.serviceArea.legend.base[locale]}</strong><ul>{homeVisitRules.serviceArea.baseAreas.map((area) => <li>{area[locale]}</li>)}</ul></div>
          <div><strong>{homeVisitRules.serviceArea.legend.extended[locale]}</strong><ul>{homeVisitRules.serviceArea.extendedAreas.map((area) => <li>{area[locale]}</li>)}</ul></div>
        </div>
        <p class="area-note">{homeVisitRules.serviceArea.legend.other[locale]}. {homeVisitRules.serviceArea.noteCopy[locale]}</p>
      </div>
      <HomeVisitsServiceMap locale={locale} />
    </section>

    <section class="split-section visit-options" aria-labelledby="format-title">
      <div><p class="eyebrow">{isEnglish ? "Visit options and price" : "Формат и стоимость"}</p><h2 id="format-title">{isEnglish ? "One, two, or three visits a day" : "Один, два или три визита в день"}</h2><p>{isEnglish ? `A visit usually takes around ${homeVisitRules.usualDurationMinutes.min}–${homeVisitRules.usualDurationMinutes.max} minutes, depending on the pet and what needs to be done. One-off visits are welcome; the minimum order is one visit.` : `Обычно визит занимает около ${homeVisitRules.usualDurationMinutes.min}–${homeVisitRules.usualDurationMinutes.max} минут — в зависимости от питомца и того, что нужно сделать. Можно заказать разовый визит; минимальный заказ — один визит.`}</p></div>
      <div class="pricing-wrap">
        <div class="price-cards">
          <div><span>{isEnglish ? "Standard home visit" : "Обычный визит домой"}</span><strong>{formatRsd(homeVisitRules.standardVisitPrice, locale)} RSD</strong></div>
          <div><span>{isEnglish ? `Dog visit + ~${homeVisitRules.dogWalkMinutes}-minute walk` : `Визит к собаке + прогулка ~${homeVisitRules.dogWalkMinutes} минут`}</span><strong>{formatRsd(homeVisitRules.dogVisitWithWalkPrice, locale)} RSD</strong></div>
          <div><span>{isEnglish ? `Standalone ~${homeVisitRules.dogWalkMinutes}-minute dog walk` : `Отдельная прогулка ~${homeVisitRules.dogWalkMinutes} минут`}</span><strong>{formatRsd(homeVisitRules.standaloneDogWalkPrice, locale)} RSD</strong></div>
        </div>
        <p>{isEnglish ? `One or two pets are included in the standard visit price; there is no per-pet surcharge. In the yellow extended area, add ${formatRsd(homeVisitRules.serviceArea.extendedVisitSurcharge, locale)} RSD per visit. Care that needs substantially more time is agreed in advance.` : `В стоимость обычного визита входят один или два питомца — доплаты за каждого из них нет. В жёлтой расширенной зоне добавляется ${formatRsd(homeVisitRules.serviceArea.extendedVisitSurcharge, locale)} RSD за визит. Уход, который требует заметно больше времени, согласуем заранее.`}</p>
      </div>
    </section>

    <section class="meeting-section" aria-labelledby="meeting-title">
      <div><p class="eyebrow">{isEnglish ? "Before the first booking" : "Перед первым заказом"}</p><h2 id="meeting-title">{isEnglish ? "Optional free introductory meeting" : "Необязательная бесплатная встреча"}</h2></div>
      <div><p>{isEnglish ? "We are happy to meet first; Anna will usually come. We meet your pet, learn the routine, see the home setup and where supplies are kept, arrange access or keys, and discuss emergency instructions." : "Если хотите, можем сначала бесплатно познакомиться; обычно приезжает Аня. Познакомимся с питомцем, узнаем режим и домашнюю обстановку, посмотрим, где лежит всё необходимое, договоримся о доступе или ключах и обсудим экстренные инструкции."}</p><p>{isEnglish ? "When agreed in advance, a visit can also include watering plants, feeding fish, briefly airing the apartment, or another small necessary basic task. This is not cleaning, housekeeping, or home management." : "Если договориться заранее, во время визита можем также полить растения, покормить рыб, ненадолго проветрить квартиру или сделать другую небольшую необходимую вещь. Это не уборка, не помощь по хозяйству и не управление домом."}</p></div>
    </section>

    <section class="split-section" aria-labelledby="prepare-title">
      <div><p class="eyebrow">{isEnglish ? "Before visits begin" : "Перед началом визитов"}</p><h2 id="prepare-title">{isEnglish ? "What to prepare" : "Что подготовить"}</h2><p>{isEnglish ? "Please explain anything important about your pet or home in advance and leave the space safe." : "Заранее расскажите обо всём важном про питомца и дом и оставьте пространство безопасным."}</p></div>
      <ul class="check-grid">{prepItems.map((item) => <li>{item}</li>)}</ul>
    </section>

    <section class="meeting-section" aria-labelledby="conditions-title">
      <div><p class="eyebrow">{isEnglish ? "Service conditions" : "Условия услуги"}</p><h2 id="conditions-title">{isEnglish ? "Access, payment, and longer trips" : "Доступ, оплата и долгие поездки"}</h2></div>
      <div><p>{homeVisitRules.accessCopy[locale]} {homeVisitRules.paymentCopy[locale]}</p><p>{isEnglish ? "We can visit for multiple weeks and do not publish a hard maximum. If you are away for a long time, we will discuss whether visits suit your pet or whether boarding would be a better fit." : "Можем приезжать и несколько недель — жёсткого максимального срока нет. Если уезжаете надолго, обсудим, подходит ли питомцу формат визитов или лучше выбрать передержку."}</p></div>
    </section>

    <section class="proof-section" aria-labelledby="proof-title">
      <div><p class="eyebrow">{isEnglish ? "Real animals, real care" : "Реальные животные и забота"}</p><h2 id="proof-title">{isEnglish ? "Our experience with pets" : "Наш опыт с питомцами"}</h2><p>{isEnglish ? "These are animals we have cared for. The photos document that experience; they are not claimed to be from client-home visits." : "Это животные, о которых мы заботились. Фото подтверждают опыт, но мы не выдаём их за съёмку во время выездов к клиентам."}</p></div>
      <div class="proof-grid">{proofPhotos.map((photo) => <figure><img src={photo.src} alt={photo.alt} width="720" height="1280" loading="lazy" /><figcaption>{photo.caption}</figcaption></figure>)}</div>
    </section>

    <section class="request-section" id="request" aria-labelledby="request-title" data-home-visits-form-root data-locale={locale} data-source-page={path} data-telegram={petSittingConfig.telegramUsername}>
      <div class="request-intro"><p class="eyebrow">{isEnglish ? "Request a visit" : "Запрос на выезд"}</p><h2 id="request-title">{isEnglish ? "Tell us what your pet needs" : "Расскажите, что нужно питомцу"}</h2><p>{isEnglish ? "This is a request, not an automatic booking. We will check the route, dates, and details and reply in Telegram." : "Это запрос, а не автоматическое бронирование. Проверим маршрут, даты и детали и ответим в Telegram."}</p></div>
      <form class="home-form" data-home-form novalidate>
        <div class="form-grid">
          <label>{isEnglish ? "From" : "Дата с"}<input type="date" name="dateFrom" required /></label>
          <label>{isEnglish ? "To" : "Дата по"}<input type="date" name="dateTo" required /></label>
          <label>{isEnglish ? "Animal" : "Питомец"}<select name="animal" required><option value="cat">{isEnglish ? "Cat" : "Кошка"}</option><option value="dog">{isEnglish ? "Dog" : "Собака"}</option></select></label>
          <label>{isEnglish ? "Number of pets" : "Количество питомцев"}<input type="number" name="quantity" min="1" max="20" value="1" required /></label>
          <label>{isEnglish ? "Visits per day" : "Визитов в день"}<select name="visitsPerDay" required>{homeVisitRules.visitsPerDay.map((count) => <option value={count}>{isEnglish ? `${count} ${count === 1 ? "visit" : "visits"}` : `${count} ${count === 1 ? "визит" : count === 2 ? "визита" : "визита"}`}</option>)}</select><small>{isEnglish ? "One-off bookings are welcome; the minimum is one visit." : "Разовый заказ возможен; минимум — один визит."}</small></label>
          <label data-dog-walk-field hidden>{isEnglish ? "Walk needed?" : "Нужна прогулка?"}<select name="dogWalk"><option value="false">{isEnglish ? "No" : "Нет"}</option><option value="true">{isEnglish ? `Yes, around ${homeVisitRules.dogWalkMinutes} minutes` : `Да, около ${homeVisitRules.dogWalkMinutes} минут`}</option></select></label>
          <label class="form-wide">{isEnglish ? "Approximate neighborhood" : "Примерный район"}<input type="text" name="neighborhood" maxlength="120" autocomplete="address-level3" placeholder={isEnglish ? "For example, the neighborhood name" : "Например, название района"} required /><small>{isEnglish ? "No exact address is needed at this stage." : "Точный адрес на этом этапе не нужен."}</small></label>
          <label class="form-wide">{isEnglish ? "Medication or special care (optional)" : "Лекарства или особый уход (необязательно)"}<input type="text" name="specialCare" maxlength="300" placeholder={isEnglish ? "For example: one tablet with food" : "Например: одна таблетка вместе с кормом"} /><small>{isEnglish ? "Simple routine medication follows your instructions; complex care is discussed individually." : "Простые регулярные лекарства даём по инструкции; сложный уход обсуждаем отдельно."}</small></label>
          <label class="form-wide">{isEnglish ? "Care details (optional)" : "Что нужно сделать (необязательно)"}<textarea name="notes" rows="4" maxlength="1000" placeholder={isEnglish ? "Food, water, litter box, play, routines, or anything important" : "Корм, вода, лоток, игры, привычки и всё важное"}></textarea></label>
          <label class="form-wide">{isEnglish ? "Your Telegram" : "Ваш Telegram"}<input type="text" name="telegramUsername" autocomplete="username" placeholder="@username" pattern="@?[A-Za-z0-9_]{5,32}" required /><small>{isEnglish ? "We need this only to reply to your request." : "Нужен только для ответа на запрос."}</small></label>
        </div>
        <div class="honeypot" aria-hidden="true"><label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
        <button class="button button--primary" type="submit">{isEnglish ? "Send request" : "Отправить запрос"}</button>
        <p class="form-status" data-form-status role="status" aria-live="polite">{isEnglish ? "We’ll reply in Telegram after checking the details." : "Ответим в Telegram после проверки деталей."}</p>
        <p class="direct-link">{isEnglish ? "Prefer to write directly?" : "Удобнее написать напрямую?"} <a href={telegram} data-home-telegram data-cta-location="form" target="_blank" rel="noreferrer">Telegram · @{petSittingConfig.telegramUsername}</a></p>
      </form>
    </section>

    <aside class="boarding-link" aria-labelledby="boarding-link-title"><div><p class="eyebrow">{isEnglish ? "Need a different format?" : "Нужен другой формат?"}</p><h2 id="boarding-link-title">{isEnglish ? "Would you like your pet to stay with us?" : "Хотите, чтобы питомец жил у нас?"}</h2><p>{isEnglish ? "For a longer trip, the best format depends on the animal. See our home boarding service for cats and dogs in Petrovaradin." : "Для долгой поездки лучший формат зависит от питомца. Посмотрите домашнюю передержку кошек и собак в Петроварадине."}</p></div><nav><a href={petSittingBusiness.pagePaths[locale].main}>{isEnglish ? "All boarding details" : "Все условия передержки"}</a><a href={petSittingBusiness.pagePaths[locale].dogs}>{isEnglish ? "Dog boarding" : "Передержка собак"}</a><a href={petSittingBusiness.pagePaths[locale].cats}>{isEnglish ? "Cat boarding" : "Передержка кошек"}</a></nav></aside>

