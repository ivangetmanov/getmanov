---
import BaseLayout from "../layouts/BaseLayout.astro";
import PetMedia from "./PetMedia.astro";
import PetPricing from "./PetPricing.astro";
import PetSittingCalendar from "./PetSittingCalendar.astro";
import { petSittingBillingFaq } from "../data/pet-sitting-faq";
import {
  petSittingConfig,
  petSittingPages,
  petSittingPagesEn,
  telegramUrl,
  type PetSittingPageKind,
} from "../data/pet-sitting";

const { kind, locale = "ru" } = Astro.props as { kind: PetSittingPageKind; locale?: "ru" | "en" };
const isEnglish = locale === "en";
const localizedPages = isEnglish ? petSittingPagesEn : petSittingPages;
const page = localizedPages[kind];
const telegram = telegramUrl();
const isMain = kind === "main";
const isDogs = kind === "dogs";
const isCats = kind === "cats";
const priceLabel = isEnglish ? "From 1,500 RSD per day." : isCats ? "от 1 500 RSD в сутки" : "От 1 500 RSD в сутки";
const heroPhoto = petSittingConfig.heroPhotos[kind];
const videoLabel = isDogs
  ? isEnglish ? "Video of a dog staying with us" : "Видео с собакой на домашней передержке"
  : isCats
    ? isEnglish ? "Video of a cat staying with us" : "Видео с кошкой на домашней передержке"
    : isEnglish ? "Video of a pet staying with us" : "Видео с питомцем на домашней передержке";
const guestPhotos = petSittingConfig.guestPhotos.filter(
  (photo) => !photo.kind || photo.kind === kind || kind === "main",
).map((photo) => ({ src: photo.src, alt: isEnglish ? photo.altEn : photo.alt }));
const residentCatPhotos = isMain
  ? petSittingConfig.residentCats.map((cat) => ({
      src: cat.image,
      alt: isEnglish ? `${cat.nameEn}, our resident cat` : `${cat.name}, наш домашний питомец`,
    }))
  : [];
const photos = [...guestPhotos, ...residentCatPhotos];
const videos = (isMain
  ? petSittingConfig.guestVideos
  : petSittingConfig.guestVideos.filter((video) => video.animal === (isDogs ? "dog" : "cat"))
).sort((first, second) => Number(Boolean(second.featured)) - Number(Boolean(first.featured)));
const mediaHeading = isEnglish ? "Photos and videos every day" : "Фото и видео каждый день";
const mediaLabel = isEnglish
  ? isDogs ? "guest dogs" : isCats ? "guest cats" : "guest pets"
  : isDogs ? "собак-гостей" : isCats ? "кошек-гостей" : "гостей";
const mediaCopy = isEnglish
  ? isDogs
    ? 'We send photos and videos at least three times a day rather than just a ceremonial "everything is fine" picture, so you can see what your dog is actually doing.'
    : isCats
      ? 'We send photos and videos at least three times a day, not just a message saying "everything is fine," so you can see how your cat is actually doing.'
      : 'We send photos and videos at least three times a day. A message saying "everything is fine" is one thing; actually seeing your pet eating, sleeping, walking around, lying on the sofa or simply getting comfortable is much more useful.'
  : isDogs
    ? "Мы знаем, как тревожно оставлять любимого питомца, поэтому присылаем фото и видео минимум 3 раза в день. Не ограничиваемся сообщением «всё хорошо», а показываем, как на самом деле проходит день собаки у нас."
    : isCats
      ? "Мы знаем, как тревожно оставлять любимого питомца, поэтому присылаем фото и видео минимум 3 раза в день. Не ограничиваемся сообщением «всё хорошо», а показываем, как на самом деле проходит день кошки у нас."
      : "Для нас это важная часть передержки. Когда оставляешь питомца у других людей, сообщение «всё хорошо» — это одно. А когда видишь, как он ест, спит, гуляет, валяется на диване или уже освоился и занимается своими делами, — совсем другое. Поэтому мы присылаем фото и видео минимум 3 раза в день и всегда остаёмся на связи.";

const faqByPage: Record<PetSittingPageKind, string[][]> = {
  main: [
    ["Кто вы и с кем будет жить мой питомец?", "Мы — Анна и Иван. Передержка проходит в квартире, где мы живём в Петроварадине. Вместе с нами живут два своих кота. Одновременно берём максимум двух гостевых питомцев."],
    ["Как вы сохраняете привычный режим питомца?", "У каждого питомца свои привычки, и мы не меняем их просто потому, что хозяин уехал.\n\nЕсли собака привыкла гулять три раза в день — гуляем три. Если привыкла спать на кровати — спит на кровати. Если кошке нужны определённый лоток и наполнитель — привозите их с собой.\n\nЕсли питомцу нужно много внимания или, наоборот, хочется побыть отдельно и чтобы его никто не трогал, — мы обеспечим это.\n\nМы подстраиваем передержку под питомца, а не питомца под передержку."],
    ["Как всё устроено дома?", "Мы живём в квартире в Петроварадине. У нас три изолированные комнаты, поэтому, если питомцам нужно отдельное пространство, мы спокойно их разделяем.\n\nДвора и балкона нет. С собаками гуляем на улице по привычному для них графику.\n\nУ нас нет запретов на диваны и кровати, а кошкам можно забираться на столы и шкафы.\n\nУ нас живут свои кот и кошка, обоим по четыре года. Пабло очень дружелюбный и любопытный. Свит более пугливая и чаще спокойно отдыхает отдельно. Оба уже жили и с другими кошками, и с собаками.\n\nВашему питомцу совершенно не обязательно с ними дружить. Если ему комфортнее жить отдельно, мы разделим животных и выделим каждому своё пространство."],
    ["А если мой питомец не подружится с вашими котами?", "Ничего страшного. Дружить с нашими котами необязательно: если питомцу комфортнее отдельно, мы разделим животных и выделим ему своё спокойное пространство."],
    ["А нормально вообще оставлять животное там, где уже есть другие животные?", "Да, если у каждого достаточно пространства и никого не заставляют общаться. Наши коты привыкли к гостям: иногда животные знакомятся и проводят время вместе, иногда просто игнорируют друг друга. Оба варианта нормальны."],
    ["Сколько животных у вас бывает одновременно?", "Максимум два гостевых питомца одновременно."],
    ["Можно сначала приехать познакомиться?", "Перед первой передержкой можно прийти к нам домой — это бесплатно. Вы познакомитесь с нами и увидите, где будет жить питомец.\n\nСобаку можно взять с собой — она всё понюхает, осмотрится, познакомится с нами и котами, а мы посмотрим, как животные друг на друга реагируют.\n\nКошку приносить на знакомство не рекомендуем: короткий визит в незнакомое пространство скорее станет для неё лишним стрессом и не покажет, как она будет чувствовать себя во время полноценной передержки."],
    ["А можно оставить питомца на пробу?", "Если речь о собаке — да. Можно оставить её у нас на 3–4 часа и посмотреть, как она чувствует себя без хозяина. Тестовая передержка стоит 1 000 RSD.\n\nДля кошек тестовый визит не рекомендуем: короткое пребывание в незнакомом месте скорее добавит стресса и мало скажет о том, как пройдёт полноценная передержка."],
    ["Что взять с собой?", "Всё, что помогает питомцу чувствовать себя привычно в новом месте.\n\nКорм, миски, поводок или переноску, лекарства, игрушки, любимую лежанку — если она ему нужна. Для кошки рекомендуем привезти привычные лоток и наполнитель.\n\nЕсли у питомца есть особенный ритуал, режим или странная привычка — обязательно расскажите нам. Мы это учтём."],
    ["Будете присылать фото и видео?", "Да. Присылаем фото и видео минимум 3 раза в день и всегда остаёмся на связи."],
    ["Что если у моего питомца какой-то очень специфический режим?", "Расскажите нам. Мы не ждём, что все животные одинаковые. Если это что-то адекватное и выполнимое, сохраняем его обычный режим."],
    ["А если что-нибудь пойдёт не так?", "Мы точно не будем молча ждать вашего возвращения. Разберёмся в ситуации, сразу свяжемся с вами и вместе решим, что делать. Если вдруг случится срочная ситуация со здоровьем и ждать ответа будет опасно для животного, сделаем необходимое в моменте, при необходимости обратимся к ветеринару и сразу же сообщим вам."],
  ],
  dogs: [
    ["Кто вы и с кем будет жить мой питомец?", "Мы — Анна и Иван. Передержка проходит в квартире, где мы живём в Петроварадине. Вместе с нами живут два своих кота. Одновременно берём максимум двух гостевых питомцев."],
    ["Моя собака любит гоняться за кошками. Вы её возьмёте?", "Если вы не знаете, как ваша собака относится к кошкам, это лучше проверить заранее.\n\nОбычный интерес, желание понюхать, познакомиться или поиграть — нормальная реакция и не преграда для совместного проживания.\n\nЕсли же собака охотится за кошками, не может переключиться или проявляет серьёзную агрессию, честнее будет выбрать ситтера без своих кошек.\n\nИменно для этого у нас есть бесплатное знакомство."],
    ["А если собака не подружится с вашими котами?", "Это не страшно.\n\nУ нас три изолированные комнаты, и животным совсем не обязательно становиться лучшими друзьями.\n\nМы разделяем питомцев так, чтобы у каждого оставалось своё безопасное пространство. При этом собака продолжает общаться с нами, гулять и жить в своём обычном ритме."],
    ["Моя собака никогда не оставалась с чужими. Что делать?", "Для этого можно сначала прийти познакомиться, а потом при желании оставить её тестово на несколько часов. Не обязательно сразу начинать с недельной поездки."],
    ["Она вообще не умеет оставаться одна.", "Такое тоже бывает. Если вашему питомцу постоянно нужен человек рядом, скажите об этом до передержки. Мы организуем всё так, чтобы во время проживания собаки дома всегда был кто-то из нас.\n\nТакую потребность важно обсудить заранее, чтобы мы могли спланировать своё время и подтвердить, что сможем быть рядом с собакой 24/7."],
    ["Сколько раз вы будете гулять?", "Передержка — не время вводить новые правила. Перед заездом мы узнаём привычный режим вашей собаки и придерживаемся его на протяжении всей передержки.\n\nСколько прогулок нужно? Когда и сколько ест? Где любит спать? Спокойно ли остаётся одна? Принимает ли лекарства?\n\nРасскажите нам заранее обо всём, что считаете важным, — и мы это учтём.\n\nУ нас нет правила «всем собакам две прогулки по двадцать минут». Если ваш питомец привык к определённому графику и длительности прогулок — расскажите нам, и мы будем его соблюдать.\n\nТо же самое с кормлением, лекарствами и другими привычными вещами."],
    ["Можно привезти свой корм?", "Да. Более того, лучше не менять привычный корм без необходимости."],
    ["Можно давать лекарства?", "Да, если вы объясните, что, когда и как нужно давать."],
    ["Можно собаке на диван или кровать?", "Там, где привыкла дома. Если собака спит на своей лежанке — возьмите её с собой, знакомое место поможет ей быстрее освоиться.\n\nПривыкла отдыхать на диване — пожалуйста. Спит с человеком на кровати — мы только за."],
    ["Можно сначала приехать познакомиться?", "Перед первой передержкой мы приглашаем зайти к нам домой на 30 минут — это бесплатно. Собака познакомится с нами, квартирой и котами, а вы сами увидите, где и с кем она будет жить."],
    ["Можно ли оставить собаку на пробу?", "Если хочется проверить, как собака чувствует себя без хозяина, можно оставить её у нас на 3–4 часа. Тестовая передержка стоит 1 000 RSD."],
    ["Что взять с собой?", "Корм, миски, поводок, лекарства, игрушки, любимую лежанку — если она ей нужна. Если у собаки есть особенный ритуал, режим или странная привычка — обязательно расскажите нам. Мы это учтём."],
    ["Будете присылать фото и видео?", "Да. Присылаем фото и видео минимум 3 раза в день."],
    ["Что если что-то неожиданное случится, пока меня нет?", "Сразу свяжемся с вами и будем решать проблему, а не ждать вашего возвращения. Если ситуация срочная и связана со здоровьем, действуем в интересах собаки, при необходимости обращаемся к ветеринару и сразу сообщаем вам."],
  ],
  cats: [
    ["Кто вы и с кем будет жить мой питомец?", "Мы — Анна и Иван. Передержка проходит в квартире, где мы живём в Петроварадине. Вместе с нами живут два своих кота. Одновременно берём максимум двух гостевых питомцев."],
    ["Какие нужны прививки?", "Нужны действующая комплексная прививка и прививка от бешенства. Перед передержкой попросим прислать фото ветпаспорта."],
    ["А если моя кошка вообще не любит других кошек?", "У нас живут свои кот и кошка, но вашему питомцу совершенно не обязательно с ними общаться.\n\nВ квартире три изолированные комнаты. Если котику спокойнее жить отдельно, мы выделим ему своё безопасное пространство и организуем всё так, чтобы животные не пересекались."],
    ["А если она спрячется и не будет выходить?", "Не будем её вытаскивать или заставлять общаться. Поставим рядом миски и лоток и дадим столько времени на адаптацию, сколько ей потребуется.\n\nЕсли в первые дни кошка захочет спрятаться и не выходить, поставим миски и лоток рядом и дадим столько времени на адаптацию, сколько потребуется."],
    ["Нужно ли знакомить её с вашими котами?", "Нет. Наши коты уже привыкли к другим животным, а если гость хочет сидеть в своей комнате и никого не видеть — тоже ок.\n\nНаши коты Пабло и Свит уже жили и с другими кошками, и с собаками. Пабло очень дружелюбный и любопытный, а Свит более пугливая и чаще спокойно отдыхает отдельно.\n\nНаши коты будут рады познакомиться, но если ваша кошка выберет побыть одной, мы не будем настаивать на знакомстве и выделим каждому своё пространство."],
    ["Можно привезти свой лоток и наполнитель?", "Да, и мы рекомендуем так делать. Знакомые запахи и привычный наполнитель помогают кошке спокойнее освоиться в новом месте."],
    ["Можно привезти привычный корм?", "Привозите привычный корм и расскажите, когда и сколько питомец ест. Мы будем придерживаться её обычного режима и не дадим ничего нового без согласования с вами."],
    ["Что если у неё особый режим?", "Передержка — не время вводить новые правила. Перед заездом мы узнаём о рутине вашей кошки и придерживаемся её всё время, пока питомец живёт у нас."],
    ["Можно давать лекарства?", "Да, если вы объясните, что, когда и как нужно давать."],
    ["Можно ли ей на диван или кровать?", "Да, у нас нет никаких ограничений."],
    ["Нужно ли заранее привозить кошку знакомиться?", "Перед первой передержкой приглашаем вас зайти к нам домой примерно на 30 минут — это бесплатно. Вы познакомитесь с нами, увидите квартиру и условия, в которых будет жить питомец, познакомитесь с нашими котами.\n\nСаму кошку приносить на знакомство не рекомендуем: короткий визит в незнакомое пространство скорее станет для неё лишним стрессом и не покажет, как она будет чувствовать себя во время полноценной передержки.\n\nМожно также оставить кошку тестово на несколько часов — это стоит 1 000 RSD."],
    ["Что взять с собой?", "Привозите привычный корм, миски, лоток, наполнитель, игрушки — всё это поможет кошке чувствовать себя спокойнее в новом месте."],
    ["Будете присылать фото и видео?", "Да. Мы всегда остаёмся на связи и присылаем фото и видео минимум 3 раза в день — даже если котик пока предпочитает проводить время в укрытии."],
    ["А если кошке внезапно станет плохо?", "Сразу свяжемся с вами, расскажем, что происходит, и вместе решим, что делать дальше. Не будем ждать вашего возвращения, если ситуацию нужно решать сейчас.\n\nЕсли ситуация срочная, действуем в интересах питомца и при необходимости обращаемся к ветеринару, не дожидаясь вашего возвращения."],
  ],
};
const faqByPageEn: Record<PetSittingPageKind, string[][]> = {
  main: [
    ["Who are you, and who will my pet stay with?", "We are Anna and Ivan. Pet boarding takes place in the apartment where we live in Petrovaradin. We have two resident cats, and we host no more than two guest pets at the same time."],
    ["How do you keep my pet's normal routine?", "Every pet has different habits, and we do not see much point in changing them just because their owner is away.\n\nIf a dog normally goes out three times a day, we go out three times. If they normally sleep on the bed, the bed is fine here too.\n\nIf a cat needs a particular food, litter box or litter, we use what they are familiar with.\n\nIf your pet needs more attention — or would rather stay somewhere quiet and be left alone — both are fine.\n\nIn short, we try to adapt the stay to the animal rather than make the animal adapt to the stay."],
    ["Where will my pet stay?", "We live in an apartment in Petrovaradin.\n\nThere are three separate rooms, so animals can be kept apart if someone needs their own space.\n\nThere is no garden or balcony. Dogs are walked outside according to their normal routine.\n\nSofas and beds are fine if your pet is allowed on them at home.\n\nWe have our own male cat and female cat. Both are four years old and have lived around both dogs and other cats. Pablo is very friendly and curious. Sweet is more cautious and usually chooses somewhere away from the action to relax on her own."],
    ["What if my pet does not get along with your cats?", "That can happen, and it is not necessarily a problem. You can meet us before the first stay, and the apartment has three separate rooms if the animals need to live apart. Your pet will still have our attention and a quiet space of their own. Nobody has to become friends."],
    ["Is it okay that other animals already live in the home?", "Yes, as long as everyone has enough space and nobody is forced to interact. Our cats are used to guests. Sometimes the animals spend time together and sometimes they simply ignore each other. Both are fine."],
    ["How many guest pets do you host at once?", "No more than two guest pets at the same time."],
    ["Can we meet you first?", "Before the first stay, you are welcome to visit our home for around 30 minutes for free.\n\nYou can meet us, see the apartment, let your dog look and sniff around, and we can see how everyone reacts to each other. We do not recommend bringing a cat for a short introduction because an unfamiliar space is more likely to add stress and will not show how a full stay would feel."],
    ["Can I leave my pet for a short trial stay?", "Yes. You can leave your dog or cat with us for a few hours before the main stay. It costs 1,000 RSD."],
    ["What should I bring?", "Anything that helps your pet live roughly the same way they do at home.\n\nFood, bowls, lead, carrier, medication, toys and their own bed if they use one.\n\nFor cats, you can also bring their usual litter box and litter.\n\nIf your pet has a particular routine, ritual or slightly strange habit, just tell us."],
    ["Will you send photos and videos?", "Yes. We send photos and videos at least three times a day, not just one ceremonial update, and we stay in touch throughout the stay."],
    ["What if my pet has an unusual routine?", "Tell us about it. We do not expect every animal to live the same way. If the routine is practical for us to follow, we will try to keep it familiar."],
    ["What happens if something goes wrong?", "We will not quietly wait for you to return. We will assess the situation, contact you straight away and decide what to do together. If there is an urgent health problem and waiting would put the animal at risk, we will do what is necessary at the time, contact a vet if needed and tell you immediately."],
  ],
  dogs: [
    ["Who are you, and who will my pet stay with?", "We are Anna and Ivan. Pet boarding takes place in the apartment where we live in Petrovaradin. We have two resident cats, and we host no more than two guest pets at the same time."],
    ["My dog likes chasing cats. Will you take them?", "If you do not know how your dog behaves around cats, it is worth checking before the stay.\n\nNormal curiosity, sniffing, wanting to meet them or trying to play is not automatically a problem.\n\nIt is different if the dog genuinely hunts or relentlessly chases cats, cannot disengage, or shows serious aggression. In that case, it is more sensible to choose a sitter without resident cats.\n\nThat is one reason we offer a free introduction before boarding."],
    ["What if my dog does not get along with your cats?", "That is fine. There are three separate rooms in the apartment, and nobody has to become best friends.\n\nWe can separate the animals so everyone has their own space. Your dog will still spend time with us, go for walks and live their normal life."],
    ["My dog has never stayed with strangers before. What should I do?", "Start with the free introduction. If you want, you can then leave your dog with us for a few hours before committing to a longer stay."],
    ["My dog cannot stay alone.", "Tell us before booking. We can sometimes arrange the stay so that one of us is home while the dog is staying with us.\n\nThis is not an automatic promise for every booking, so it is important to discuss it in advance."],
    ["How often will you walk my dog?", "Boarding is not a particularly good time to suddenly introduce a completely new set of rules. So we first ask how your dog normally lives at home and try to keep things similar.\n\nHow many walks? When do they eat? Where do they sleep? Are they allowed on the sofa? Are they comfortable staying alone? If something in their routine matters to them, just tell us beforehand.\n\nThere is no rule here that every dog gets exactly two twenty-minute walks. Tell us their normal schedule and we will keep as close to it as we reasonably can.\n\nThe same applies to feeding, medication and other familiar routines."],
    ["Can I bring their normal food?", "Yes. It is usually better not to change familiar food without a reason."],
    ["Can you give medication?", "Yes, if you explain what to give, when to give it and how."],
    ["Can my dog sleep on the sofa or bed?", "Yes. If your dog sleeps in their own bed at home, you can bring it. If they normally lie on the sofa, that is fine. If they normally sleep with a person on the bed, we do not have a rule against that either."],
    ["Can we meet you first?", "Before the first stay, you can visit us at home for around 30 minutes for free. Your dog can meet us, see the apartment and meet the cats, and you can see where they would be staying."],
    ["Can I leave my dog for a trial stay?", "If you want to test being away from the owner, you can leave your dog with us for a few hours for 1,000 RSD."],
    ["What should I bring?", "Bring their normal food, bowls, lead, medication, toys and their own bed if they use one. If your dog has a particular routine, ritual or slightly strange habit, just tell us."],
    ["Will you send photos and videos?", "Yes. We send photos and videos at least three times a day. This is not something we want to reduce to one formal update."],
    ["What happens in an emergency?", "We will contact you straight away and deal with the situation rather than wait for you to return. If there is an urgent health issue, we will act in the dog's interest, contact a vet if needed and tell you immediately."],
  ],
  cats: [
    ["Who are you, and who will my pet stay with?", "We are Anna and Ivan. Pet boarding takes place in the apartment where we live in Petrovaradin. We have two resident cats, and we host no more than two guest pets at the same time."],
    ["Which vaccinations are required?", "A current core vaccine and rabies vaccination are required, both administered within the last 12 months."],
    ["My cat really does not like other cats. Is that a problem?", "Not by itself. We have our own male cat and female cat, but your cat does not need to become friends with them.\n\nThere are three separate rooms in the apartment. If your cat is more comfortable living separately, we can give them their own space and not make them meet our cats at all."],
    ["What if my cat hides and refuses to come out?", "They can hide. We will not pull them out or force interaction. They can settle in at their own pace.\n\nIf they want to hide for the first few days, they can hide. If they need a quiet separate space, we can arrange that."],
    ["Does my cat have to meet your cats?", "No. Our cats are already used to other animals, but if a guest wants to stay in their own room and see nobody, that is also fine.\n\nPablo is very friendly and curious. Sweet is more cautious and usually chooses somewhere away from the action to relax on her own. Both have lived around other cats and dogs. Your cat does not need to become friends with them."],
    ["Can I bring their own litter box and litter?", "Yes, and that is usually the best option if your cat is familiar with them."],
    ["Can I bring their normal food?", "Tell us how feeding works at home and bring their normal food. We will keep the same routine and will not give them anything new without agreeing it with you."],
    ["What if my cat has a particular routine?", "We are not going to deliberately change your cat's habits just because they are staying with us. If they want to hide for the first few days, they can hide. If they need a quiet separate space, we can arrange that."],
    ["Can you give medication?", "Yes, if you explain what to give, when to give it and how."],
    ["Can they sleep on the sofa or bed?", "Yes, if they are allowed to at home."],
    ["Should I bring my cat for an introduction first?", "You can visit us for around 30 minutes before the first stay for free. You can see the apartment and meet us.\n\nWe do not recommend bringing your cat for a short introduction because an unfamiliar space is more likely to add stress and will not show how a full stay would feel. You can also leave your cat with us for a few hours as a trial stay. Trial stay: 1,000 RSD."],
    ["What should I bring?", "Bring their normal food, bowls, litter box, usual litter, toys and medication — whatever helps things feel normal."],
    ["Will you send photos and videos?", "Yes. We send photos and videos at least three times a day. We consider this a normal part of the stay."],
    ["What happens if my cat suddenly becomes ill?", "We will not simply wait for you to return. We will assess the situation, message or call you immediately and decide what to do together.\n\nIf the situation is urgent, we will first do what the cat needs at that moment, contact a vet if necessary and get in touch with you immediately."],
  ],
};
const billingFaq = petSittingBillingFaq[locale];
const boardingDaysFaq = [billingFaq.question, billingFaq.answer];
const faq = [boardingDaysFaq, ...(isEnglish ? faqByPageEn : faqByPage)[kind]];
const serviceName = isEnglish
  ? isMain ? "Home pet boarding in Novi Sad" : isDogs ? "Dog boarding in Novi Sad" : "Cat boarding in Novi Sad"
  : page.h1;
const alternates = [
  { hreflang: "ru", href: petSittingPages[kind].path },
  { hreflang: "en", href: petSittingPagesEn[kind].path },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: serviceName,
    description: page.description,
    url: `https://getmanov.com${page.path}`,
    areaServed: "Petrovaradin, Novi Sad",
    serviceType: isEnglish ? "Home pet boarding" : "Домашняя передержка животных",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: isEnglish ? "Home" : "Главная", item: "https://getmanov.com/" },
      { "@type": "ListItem", position: 2, name: isEnglish ? "Pet boarding in Novi Sad" : "Передержка животных", item: `https://getmanov.com${localizedPages.main.path}` },
      ...(isMain ? [] : [{ "@type": "ListItem", position: 3, name: page.focus, item: `https://getmanov.com${page.path}` }]),
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map(([question, answer]) => ({
      "@type": "Question",
      name: question,
      acceptedAnswer: { "@type": "Answer", text: answer },
    })),
  },
];
---

<BaseLayout title={page.title} description={page.description} canonical={page.path} lang={locale} structuredData={structuredData} alternates={alternates}>
  <div class:list={["pet-page", `pet-page--${kind}`]}>
    <nav class="pet-locale-switch" aria-label={isEnglish ? "Language" : "Язык"}>
      <a href={petSittingPages[kind].path} aria-current={!isEnglish ? "page" : undefined}>RU</a>
      <span aria-hidden="true">/</span>
      <a href={petSittingPagesEn[kind].path} aria-current={isEnglish ? "page" : undefined}>EN</a>
    </nav>
    <section class="pet-hero">
      <div class="pet-hero__copy">
        <p class="eyebrow">{isEnglish ? "Petrovaradin · Novi Sad" : "Петроварадин · Нови-Сад"}</p>
        <h1>{page.h1}</h1>
        {!isEnglish && isMain ? (
          <div class="main-hero-intro">
            <h2>Не знаете, с кем оставить питомца на время отъезда?</h2>
            <p class="pet-hero__lead">Домашняя передержка помогает питомцу чувствовать себя комфортно и сохранить привычные для него вещи, даже когда вас нет рядом. Мы заранее узнаём о его характере, рутине и потребностях и учитываем их на протяжении всего времени с нами.</p>
            <p>Питомец будет жить с нами в квартире в Петроварадине.</p>
          </div>
        ) : !isEnglish && isDogs ? (
          <div class="dog-hero-intro">
            <h2>Переживаете, с кем оставить питомца на время отъезда?</h2>
            <p class="pet-hero__lead">{page.lead}</p>
            <p>Регулярно присылаем фото и видео, рассказываем, как дела у питомца, и всегда остаёмся на связи.</p>
            <p>Передержка проходит в нашей квартире в Петроварадине.</p>
          </div>
        ) : !isEnglish && isCats ? (
          <div class="cat-hero-intro">
            <h2>Не знаете, с кем оставить котика во время отъезда?</h2>
            <p class="pet-hero__lead">На домашней передержке питомец остаётся под присмотром и получает столько внимания и личного пространства, сколько ему нужно.</p>
            <p>Мы не торопим знакомство, даём кошке возможность спрятаться, привыкнуть к новым запахам, поспать в одиночестве — столько, сколько нужно. <strong>А привычные корм и наполнитель помогают сохранить знакомую часть домашней рутины.</strong></p>
          </div>
        ) : <p class="pet-hero__lead">{page.lead}</p>}
        <p class="pet-hero__price"><strong>{priceLabel}</strong>{isMain && <span>{isEnglish ? "We host no more than two guest pets at the same time." : "Берём максимум двух гостевых животных одновременно."}</span>}</p>
        <div class="pet-actions">
          <a class="pet-button pet-button--primary" href="#dates">{isEnglish ? "Check available dates" : "Проверить даты"}</a>
          <a class="pet-button" href={telegram} target="_blank" rel="noreferrer">{isEnglish ? "Message Anna on Telegram" : "Написать Ане в Telegram"}</a>
        </div>
      </div>
      <div class="hero-media">
        <img src={heroPhoto} alt={isEnglish ? isDogs ? "Dog staying with us in our home" : isCats ? "Cat staying with us in our home" : "Pet staying with us in our home" : isDogs ? "Собака на домашней передержке" : isCats ? "Кошка на домашней передержке" : "Питомец на домашней передержке"} width="1200" height="900" />
      </div>
    </section>

    <section class="early-media">
      <div>
        <h2>{mediaHeading}</h2>
        <p>{mediaCopy}</p>
      </div>
      <PetMedia photos={photos} videos={videos} label={mediaLabel} videoLabel={videoLabel} locale={locale} />
    </section>

    <PetSittingCalendar locale={locale} kind={kind} />
    <PetPricing locale={locale} />

    <section class="faq-section" id="faq">
      <div><p class="eyebrow">{isEnglish ? "Frequently asked questions" : "Частые вопросы"}</p><h2>{isEnglish ? isDogs ? "Dog boarding FAQ" : isCats ? "Cat boarding FAQ" : "Pet boarding FAQ" : isDogs ? "О передержке собак" : isCats ? "О передержке кошек" : "Что обычно спрашивают"}</h2></div>
      <div class="faq-list">{faq.map(([question, answer], index) => <details id={index === 0 ? "boarding-days" : undefined} open={index === 0}><summary>{question}</summary><p>{answer}</p></details>)}</div>
    </section>

    <section class="final-cta">
      <div><p class="eyebrow">{isEnglish ? "Next step" : "Следующий шаг"}</p><h2>{isEnglish ? "Need pet boarding?" : "Нужна передержка?"}</h2></div>
      <div class="pet-actions">
        <a class="pet-button pet-button--primary" href="#dates">{isEnglish ? "Check available dates" : "Проверить даты"}</a>
        <a class="pet-button" href={telegram} target="_blank" rel="noreferrer">{isEnglish ? "Message Anna on Telegram" : "Написать Ане в Telegram"}</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style is:inline>
  html[lang] { scroll-padding-top:84px; }
  .prose:has(.pet-page) { width:100%; max-width:none; padding:0; }
  .pet-page { --ink:#20332f; --muted:#52645d; --line:#d9e2dc; --paper:#fbfaf6; --accent:#275f4b; --warm:#9d623c; overflow-x:clip; margin:-34px 0; padding:0 24px 72px; background:#fbfaf6; color:var(--ink); font-size:17px; }
  .pet-page * { min-width:0; }
  .pet-page a { color:inherit; }
  .pet-page p { text-wrap:pretty; }
  .pet-page h1,.pet-page h2,.pet-page h3 { overflow-wrap:normal; word-break:normal; hyphens:none; }
  .main-hero-intro h2,.dog-hero-intro h2,.cat-hero-intro h2 { margin:24px 0 12px; font-size:clamp(21px,2vw,28px); line-height:1.18; letter-spacing:-.025em; }
  .main-hero-intro p,.dog-hero-intro p,.cat-hero-intro p { margin:0 0 10px; color:var(--muted); font-size:17px; line-height:1.65; }
  .pet-locale-switch { display:flex; width:min(1160px,100%); justify-content:flex-end; gap:7px; margin:0 auto -48px; padding-top:18px; color:var(--muted); font-size:12px; font-weight:800; letter-spacing:.08em; }.pet-locale-switch a { text-decoration:none; }.pet-locale-switch a[aria-current="page"] { color:var(--accent); text-decoration:underline; text-underline-offset:3px; }
  .pet-hero,.early-media,.pricing-section,.pet-media,.faq-section,.final-cta { width:min(1160px,100%); margin-inline:auto; }
  .eyebrow { margin:0 0 12px; color:var(--accent); font-size:12px; font-weight:800; letter-spacing:.11em; text-transform:uppercase; }
  .pet-hero { display:grid; grid-template-columns:minmax(0,1.05fr) minmax(360px,.95fr); gap:56px; align-items:center; min-height:610px; padding:70px 0 58px; }
  .pet-hero h1 { max-width:760px; margin:0; font-size:clamp(48px,4.7vw,64px); line-height:1.02; letter-spacing:-.045em; }
  .pet-hero__lead { max-width:690px; margin:22px 0 0; color:var(--muted); font-size:21px; line-height:1.43; }
  .pet-hero__price { display:flex; flex-wrap:wrap; gap:8px 18px; margin:22px 0 0; }.pet-hero__price strong { font-size:18px; }.pet-hero__price span { color:var(--muted); }
  .pet-actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:28px; }.pet-button { display:inline-flex; min-height:46px; align-items:center; justify-content:center; border:1px solid var(--ink); border-radius:8px; padding:10px 16px; font:inherit; font-weight:750; text-decoration:none; }.pet-page .pet-button--primary { border-color:var(--accent); background:var(--accent); color:#fff; }
  .hero-media { aspect-ratio:4/3; overflow:hidden; background:#edf0eb; }.hero-media img { width:100%; height:100%; object-fit:cover; }
  .early-media { display:grid; grid-template-columns:minmax(230px,.54fr) minmax(0,1.46fr); gap:56px; align-items:start; padding:84px 0 40px; }.early-media h2,.pricing-section h2,.faq-section h2,.final-cta h2 { margin:0; font-size:clamp(30px,3.5vw,46px); line-height:1.08; letter-spacing:-.04em; }.early-media p,.pricing-section>div:first-child p:not(.eyebrow) { color:var(--muted); font-size:17px; line-height:1.7; }
  .pet-media { padding:50px 0; }.early-media .pet-media { width:100%; padding:0; }.media-grid,.media-gallery-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:14px; }.media-grid figure,.media-gallery-grid figure { margin:0; }.video-frame,.photo-card { position:relative; display:block; width:100%; aspect-ratio:9/16; overflow:hidden; border:0; border-radius:16px; padding:0; background:#dfe7e2; box-shadow:0 10px 28px rgba(32,51,47,.1); }.video-frame iframe,.video-poster,.video-poster img,.photo-card img { display:block; width:100%; height:100%; border:0; }.video-frame iframe { background:#111; }.video-poster,.photo-card { cursor:pointer; }.video-poster { position:relative; padding:0; background:#dfe7e2; }.video-poster img,.photo-card img { object-fit:cover; }.video-poster::after,.photo-card::after { content:""; position:absolute; inset:0; background:linear-gradient(180deg,transparent 72%,rgba(9,24,19,.32)); opacity:.7; transition:opacity .18s ease; }.photo-card:hover::after,.photo-card:focus-visible::after { opacity:0; }.video-play { position:absolute; z-index:1; left:50%; top:50%; display:grid; width:58px; height:58px; place-items:center; border-radius:50%; background:rgba(255,255,255,.94); color:var(--accent); box-shadow:0 8px 24px rgba(17,42,33,.22); transform:translate(-50%,-50%); transition:transform .18s ease,background .18s ease; }.video-play svg { width:22px; margin-left:3px; }.video-poster:hover .video-play,.video-poster:focus-visible .video-play { background:#fff; transform:translate(-50%,-50%) scale(1.08); }.video-poster:focus-visible,.photo-card:focus-visible { outline:3px solid var(--accent); outline-offset:3px; }.video-number { position:absolute; z-index:1; right:12px; bottom:12px; color:#fff; font-size:12px; font-weight:800; letter-spacing:.04em; }.media-grid figcaption,.media-gallery-grid figcaption { padding-top:8px; color:var(--muted); font-size:13px; line-height:1.4; }.media-gallery { margin-top:18px; }.media-gallery>summary { display:flex; min-height:52px; align-items:center; justify-content:space-between; gap:16px; border:1px solid var(--line); border-radius:12px; padding:12px 16px; cursor:pointer; list-style:none; background:#fff; font-weight:800; }.media-gallery>summary::-webkit-details-marker { display:none; }.media-gallery>summary::after { content:"+"; display:grid; width:30px; height:30px; place-items:center; border-radius:50%; background:#e8f0eb; color:var(--accent); font-size:22px; line-height:1; }.media-gallery[open]>summary::after { content:"−"; }.media-gallery>summary:hover { border-color:#9eb6aa; }.media-gallery-grid { margin-top:14px; }.photo-lightbox { width:min(900px,calc(100vw - 32px)); max-width:none; height:min(90vh,1100px); max-height:none; border:0; border-radius:18px; padding:0; overflow:hidden; background:#17231f; box-shadow:0 24px 80px rgba(0,0,0,.42); }.photo-lightbox::backdrop { background:rgba(15,23,20,.82); backdrop-filter:blur(5px); }.photo-lightbox img { width:100%; height:100%; object-fit:contain; }.photo-lightbox-close { position:absolute; z-index:1; top:12px; right:12px; display:grid; width:42px; height:42px; place-items:center; border:0; border-radius:50%; background:rgba(255,255,255,.92); color:var(--ink); cursor:pointer; font:inherit; font-size:27px; line-height:1; }.photo-lightbox-close:focus-visible { outline:3px solid #fff; outline-offset:3px; }.media-empty { min-height:250px; display:grid; place-content:center; gap:5px; border:1px solid var(--line); border-radius:16px; background:#f3f3ed; color:var(--muted); text-align:center; padding:30px; }.media-empty strong { color:var(--ink); }
  .pricing-section { display:grid; grid-template-columns:.55fr 1.45fr; gap:54px; padding:78px 0; border-top:1px solid var(--line); }.pricing-content { min-width:0; }.pricing-section .price-table { display:table; width:100%; margin:0; overflow:visible; border-collapse:collapse; border-top:1px solid var(--ink); table-layout:fixed; }.pricing-section .price-table th,.pricing-section .price-table td { min-width:0; border:0; border-bottom:1px solid var(--line); padding:17px 14px; background:transparent; text-align:left; vertical-align:top; }.price-table th:first-child,.price-table td:first-child { width:27%; padding-left:0; }.price-table th:last-child,.price-table td:last-child { padding-right:0; }.price-table thead th { padding-top:12px; padding-bottom:12px; color:var(--muted); font-size:12px; font-weight:700; }.price-table tbody th { color:var(--ink); font-size:16px; font-weight:800; }.price-table td strong { display:block; font-size:15px; line-height:1.45; }.price-cell__label { display:none; }.price-extras { display:grid; gap:0; margin:28px 0 0; border-top:1px solid var(--ink); }.price-extras>div { display:grid; grid-template-columns:minmax(0,1fr) minmax(150px,.65fr); gap:24px; align-items:center; border-bottom:1px solid var(--line); padding:17px 0; }.price-extras dt,.price-extras dd { margin:0; }.price-extras dt { font-weight:750; }.price-extras dd { font-weight:800; }
  .faq-section { display:block; margin-block:86px 20px; padding:72px clamp(22px,6vw,72px); border:1px solid var(--line); border-radius:24px; background:#f0f4f1; }.faq-section>div:first-child { max-width:760px; margin:0 auto 36px; text-align:center; }.faq-section h2 { font-size:clamp(34px,4.6vw,54px); }.faq-list { display:grid; max-width:900px; gap:10px; margin-inline:auto; }.faq-list details { overflow:hidden; border:1px solid #d3ded7; border-radius:12px; background:#fff; }.faq-list summary { position:relative; display:flex; min-height:68px; align-items:center; padding:18px 62px 18px 22px; cursor:pointer; list-style:none; font-size:18px; font-weight:780; line-height:1.35; }.faq-list summary::-webkit-details-marker { display:none; }.faq-list summary::after { content:"+"; position:absolute; right:20px; display:grid; width:30px; height:30px; place-items:center; border-radius:50%; background:#e8f0eb; color:var(--accent); font-size:22px; font-weight:500; line-height:1; }.faq-list details[open] summary::after { content:"−"; }.faq-list summary:hover { color:var(--accent); }.faq-list summary:focus-visible { outline:3px solid var(--accent); outline-offset:-3px; }.faq-list p { max-width:760px; margin:0; padding:0 62px 22px 22px; color:#44554f; font-size:17px; line-height:1.68; white-space:pre-line; }
  .final-cta { display:flex; justify-content:space-between; gap:28px; align-items:center; margin-top:20px; border:1px solid var(--line); border-radius:18px; padding:28px 32px; background:#f0f4f1; }.final-cta h2 { font-size:clamp(26px,3vw,36px); }.final-cta .eyebrow { margin-bottom:7px; }.final-cta .pet-actions { flex:0 0 auto; margin:0; }
  .pet-page--dogs .hero-media { background:#eee8df; }.pet-page--cats .hero-media { background:#ebe8e1; }.pet-page--cats .hero-media img { object-position:center 44%; }
