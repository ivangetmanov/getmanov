---
import BaseLayout from "../layouts/BaseLayout.astro";
import PetMedia from "./PetMedia.astro";
import PetPricing from "./PetPricing.astro";
import PetSittingCalendar from "./PetSittingCalendar.astro";
import ResidentCats from "./ResidentCats.astro";
import { petSittingBillingFaq } from "../data/pet-sitting-faq";
import {
  petSittingArticleGuides,
  petSittingConfig,
  petSittingPages,
  petSittingPagesEn,
  telegramUrl,
  type PetSittingPageKind,
} from "../data/pet-sitting";

const { kind, locale = "ru" } = Astro.props as { kind: PetSittingPageKind; locale?: "ru" | "en" };
const isEnglish = locale === "en";
const localizedPages = isEnglish ? petSittingPagesEn : petSittingPages;
const page = localizedPages[kind];
const telegram = telegramUrl();
const isMain = kind === "main";
const isDogs = kind === "dogs";
const isCats = kind === "cats";
const priceLabel = isEnglish ? "From 1,500 RSD per day." : isCats ? "от 1 500 RSD в сутки" : "От 1 500 RSD в сутки";
const heroPhoto = petSittingConfig.heroPhotos[kind];
const videoLabel = isDogs
  ? isEnglish ? "Video of a dog staying with us" : "Видео с собакой на домашней передержке"
  : isCats
    ? isEnglish ? "Video of a cat staying with us" : "Видео с кошкой на домашней передержке"
    : isEnglish ? "Video of a pet staying with us" : "Видео с питомцем на домашней передержке";
const related = (["main", "dogs", "cats"] as PetSittingPageKind[]).filter(
  (item) => item !== kind,
);
const guides = petSittingArticleGuides
  .filter((guide) => guide.kinds.some((guideKind) => guideKind === kind))
  .map((guide) => isEnglish ? guide.en : guide.ru);
const photos = petSittingConfig.guestPhotos.filter(
  (photo) => !photo.kind || photo.kind === kind || kind === "main",
).map((photo) => ({ src: photo.src, alt: isEnglish ? photo.altEn : photo.alt }));
const videos = (isMain
  ? petSittingConfig.guestVideos
  : petSittingConfig.guestVideos.filter((video) => video.animal === (isDogs ? "dog" : "cat"))
).sort((first, second) => Number(Boolean(second.featured)) - Number(Boolean(first.featured)));

const faqByPage: Record<PetSittingPageKind, string[][]> = {
  main: [
    ["А если мой питомец не подружится с вашими котами?", "Ничего страшного. Дружить с нашими котами необязательно: если питомцу комфортнее отдельно, мы разделим животных и выделим ему своё спокойное пространство."],
    ["А нормально вообще оставлять животное там, где уже есть другие животные?", "Да, если у каждого достаточно пространства и никого не заставляют общаться. Наши коты привыкли к гостям: иногда животные знакомятся и проводят время вместе, иногда просто игнорируют друг друга. Оба варианта нормальны."],
    ["Сколько животных у вас бывает одновременно?", "Максимум два гостевых питомца одновременно."],
    ["Можно сначала приехать познакомиться?", "Да. Перед первой передержкой можно бесплатно прийти к нам домой примерно на полчаса, познакомиться с нами и посмотреть квартиру."],
    ["А можно оставить питомца на пробу?", "Если речь о собаке — да. Можно оставить её у нас на 3–4 часа и посмотреть, как она чувствует себя без хозяина. Тестовая передержка стоит 1 000 RSD.\n\nДля кошек тестовый визит не рекомендуем: короткое пребывание в незнакомом месте скорее добавит стресса и мало скажет о том, как пройдёт полноценная передержка."],
    ["Будете присылать фото и видео?", "Да. Присылаем фото и видео минимум 3 раза в день и всегда остаёмся на связи."],
    ["Что если у моего питомца какой-то очень специфический режим?", "Расскажите нам. Мы не ждём, что все животные одинаковые. Если это что-то адекватное и выполнимое, сохраняем его обычный режим."],
    ["А если что-нибудь пойдёт не так?", "Мы точно не будем молча ждать вашего возвращения. Разберёмся в ситуации, сразу свяжемся с вами и вместе решим, что делать. Если вдруг случится срочная ситуация со здоровьем и ждать ответа будет опасно для животного, сделаем необходимое в моменте, при необходимости обратимся к ветеринару и сразу же сообщим вам."],
  ],
  dogs: [
    ["Моя собака любит гоняться за кошками. Вы её возьмёте?", "Смотря что именно значит «гоняться». Если ей просто интересно, хочется познакомиться или поиграть — это можно проверить на знакомстве. Если она действительно преследует кошек, не может переключиться или проявляет агрессию, лучше выбрать передержку без собственных котов."],
    ["А если собака не подружится с вашими котами?", "Это нормально. Дружить необязательно. В квартире три изолированные комнаты, поэтому животных при необходимости можно разделить."],
    ["Моя собака никогда не оставалась с чужими. Что делать?", "Для этого можно сначала прийти познакомиться, а потом при желании оставить её тестово на несколько часов. Не обязательно сразу начинать с недельной поездки."],
    ["Она вообще не умеет оставаться одна.", "Скажите нам заранее. Такую потребность важно обсудить, чтобы мы могли спланировать своё время и подтвердить, что сможем быть рядом с собакой 24/7."],
    ["Сколько раз вы будете гулять?", "Столько, сколько собака привыкла гулять дома. Расскажите нам её обычный график."],
    ["Можно привезти свой корм?", "Да. Более того, лучше не менять привычный корм без необходимости."],
    ["Можно давать лекарства?", "Да, если вы объясните, что, когда и как нужно давать."],
    ["Можно собаке на диван или кровать?", "Можно, если для неё это привычно."],
    ["Будете присылать фото и видео?", "Да. Присылаем фото и видео минимум 3 раза в день."],
    ["Что если что-то неожиданное случится, пока меня нет?", "Сразу свяжемся с вами и будем решать проблему, а не ждать вашего возвращения. Если ситуация срочная и связана со здоровьем, действуем в интересах собаки, при необходимости обращаемся к ветеринару и сразу сообщаем вам."],
  ],
  cats: [
    ["А если моя кошка вообще не любит других кошек?", "Это нормально. Если питомцу спокойнее жить отдельно, мы выделим ему отдельную комнату и организуем всё так, чтобы животные не пересекались."],
    ["А если она спрячется и не будет выходить?", "Не будем её вытаскивать или заставлять общаться. Поставим рядом миски и лоток и дадим столько времени на адаптацию, сколько ей потребуется."],
    ["Можно привезти свой лоток и наполнитель?", "Да, и мы рекомендуем так делать. Знакомые запахи и привычный наполнитель помогают кошке спокойнее освоиться в новом месте."],
    ["Что если она ест только определённый корм или по особому режиму?", "Привозите привычный корм и расскажите, когда и сколько питомец ест. Мы будем придерживаться его обычного режима и не дадим ничего нового без согласования с вами."],
    ["Можно ли ей на диван или кровать?", "Да, у нас нет никаких ограничений."],
    ["Какие нужны прививки?", "Нужны действующая комплексная прививка и прививка от бешенства. Перед передержкой попросим прислать фото ветпаспорта."],
    ["А если что-то пойдёт не так?", "Сразу свяжемся с вами, расскажем, что происходит, и вместе решим, что делать дальше. Не будем ждать вашего возвращения, если ситуацию нужно решать сейчас."],
    ["А если кошке внезапно станет плохо?", "Сразу свяжемся с вами. Если ситуация срочная, действуем в интересах питомца и при необходимости обращаемся к ветеринару, не дожидаясь вашего возвращения."],
    ["Будете присылать фото и видео?", "Да. Мы всегда остаёмся на связи и присылаем фото и видео минимум 3 раза в день — даже если котик пока предпочитает проводить время в укрытии."],
  ],
};
const faqByPageEn: Record<PetSittingPageKind, string[][]> = {
  main: [
    ["What if my pet does not get along with your cats?", "That can happen, and it is not necessarily a problem. You can meet us before the first stay, and the apartment has three separate rooms if the animals need to live apart. Your pet will still have our attention and a quiet space of their own. Nobody has to become friends."],
    ["Is it okay that other animals already live in the home?", "Yes, as long as everyone has enough space and nobody is forced to interact. Our cats are used to guests. Sometimes the animals spend time together and sometimes they simply ignore each other. Both are fine."],
    ["How many guest pets do you host at once?", "No more than two guest pets at the same time."],
    ["Can we meet you first?", "Yes. You can visit our home for around 30 minutes for free, see the apartment and meet us."],
    ["Can I leave my pet for a short trial stay?", "Yes. You can leave your dog or cat with us for a few hours before the main stay. It costs 1,000 RSD."],
    ["Will you send photos and videos?", "Yes, regularly, and not just one ceremonial photo."],
    ["What if my pet has an unusual routine?", "Tell us about it. We do not expect every animal to live the same way. If the routine is practical for us to follow, we will try to keep it familiar."],
    ["What happens if something goes wrong?", "We will not quietly wait for you to return. We will assess the situation, contact you straight away and decide what to do together. If there is an urgent health problem and waiting would put the animal at risk, we will do what is necessary at the time, contact a vet if needed and tell you immediately."],
  ],
  dogs: [
    ["My dog likes chasing cats. Will you take them?", "It depends on what chasing means. Curiosity, sniffing or wanting to play can be checked during the introduction. If the dog genuinely hunts cats, cannot disengage or shows aggression, it is better to choose a sitter without resident cats."],
    ["What if my dog does not get along with your cats?", "That is fine. Nobody has to become friends. The apartment has three separate rooms, so the animals can be kept apart when needed."],
    ["My dog has never stayed with strangers before. What should I do?", "Start with the free introduction. If you want, you can then leave your dog with us for a few hours before committing to a longer stay."],
    ["My dog cannot stay alone.", "Tell us in advance. We may be able to arrange the stay so that one of us remains at home."],
    ["How often will you walk my dog?", "As often as they are used to at home. Tell us their normal schedule."],
    ["Can I bring their normal food?", "Yes. It is usually better not to change familiar food without a reason."],
    ["Can you give medication?", "Yes, if you explain what to give, when to give it and how."],
    ["Can my dog sleep on the sofa or bed?", "Yes, if that is normal for them at home."],
    ["Will you send photos and videos?", "Yes, regularly. This is not something we want to reduce to one formal update."],
    ["What happens in an emergency?", "We will contact you straight away and deal with the situation rather than wait for you to return. If there is an urgent health issue, we will act in the dog's interest, contact a vet if needed and tell you immediately."],
  ],
  cats: [
    ["My cat really does not like other cats. Is that a problem?", "Not by itself. Your cat can have a separate room, and our cats can be kept away. Nobody will force them to meet."],
    ["What if my cat hides and refuses to come out?", "They can hide. We will not pull them out or force interaction. They can settle in at their own pace."],
    ["Can I bring their own litter box and litter?", "Yes, and that is usually the best option if your cat is familiar with them."],
    ["What if my cat only eats a specific food?", "Tell us how feeding works at home and bring their normal food. We will try to keep the same routine."],
    ["Can they sleep on the sofa or bed?", "Yes, if they are allowed to at home."],
    ["Which vaccinations are required?", "A current core vaccine and rabies vaccination are required, both administered within the last 12 months."],
    ["What happens if something goes wrong?", "We will not simply wait for you to return. We will assess the situation, message or call you immediately and decide what to do together."],
    ["What happens if my cat suddenly becomes ill?", "If the situation is urgent, we will first do what the cat needs at that moment, contact a vet if necessary and get in touch with you immediately."],
    ["Will you send photos and videos?", "Yes, regularly. We consider this a normal part of the stay."],
  ],
};
const billingFaq = petSittingBillingFaq[locale];
const boardingDaysFaq = [billingFaq.question, billingFaq.answer];
const faq = [boardingDaysFaq, ...(isEnglish ? faqByPageEn : faqByPage)[kind]];
const serviceName = isEnglish
  ? isMain ? "Home pet boarding in Novi Sad" : isDogs ? "Dog boarding in Novi Sad" : "Cat boarding in Novi Sad"
  : page.h1;
const alternates = [
  { hreflang: "ru", href: petSittingPages[kind].path },
  { hreflang: "en", href: petSittingPagesEn[kind].path },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: serviceName,
    description: page.description,
    url: `https://getmanov.com${page.path}`,
    areaServed: "Petrovaradin, Novi Sad",
    serviceType: isEnglish ? "Home pet boarding" : "Домашняя передержка животных",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: isEnglish ? "Home" : "Главная", item: "https://getmanov.com/" },
      { "@type": "ListItem", position: 2, name: isEnglish ? "Pet boarding in Novi Sad" : "Передержка животных", item: `https://getmanov.com${localizedPages.main.path}` },
      ...(isMain ? [] : [{ "@type": "ListItem", position: 3, name: page.focus, item: `https://getmanov.com${page.path}` }]),
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map(([question, answer]) => ({
      "@type": "Question",
      name: question,
      acceptedAnswer: { "@type": "Answer", text: answer },
    })),
  },
];
---

<BaseLayout title={page.title} description={page.description} canonical={page.path} lang={locale} structuredData={structuredData} alternates={alternates}>
  <div class:list={["pet-page", `pet-page--${kind}`]}>
    <nav class="pet-locale-switch" aria-label={isEnglish ? "Language" : "Язык"}>
      <a href={petSittingPages[kind].path} aria-current={!isEnglish ? "page" : undefined}>RU</a>
      <span aria-hidden="true">/</span>
      <a href={petSittingPagesEn[kind].path} aria-current={isEnglish ? "page" : undefined}>EN</a>
    </nav>
    <section class="pet-hero">
      <div class="pet-hero__copy">
        <p class="eyebrow">{isEnglish ? "Petrovaradin · Novi Sad" : "Петроварадин · Нови-Сад"}</p>
        <h1>{page.h1}</h1>
        {!isEnglish && isMain ? (
          <div class="main-hero-intro">
            <h2>Не знаете, с кем оставить питомца на время отъезда?</h2>
            <p class="pet-hero__lead">Домашняя передержка помогает питомцу чувствовать себя комфортно и сохранить привычные для него вещи, даже когда вас нет рядом. Мы заранее узнаём о его характере, рутине и потребностях и учитываем их на протяжении всего времени с нами.</p>
            <p>Питомец будет жить с нами в квартире в Петроварадине.</p>
          </div>
        ) : !isEnglish && isDogs ? (
          <div class="dog-hero-intro">
            <h2>Переживаете, с кем оставить питомца на время отъезда?</h2>
            <p class="pet-hero__lead">{page.lead}</p>
            <p>Регулярно присылаем фото и видео, рассказываем, как дела у питомца, и всегда остаёмся на связи.</p>
            <p>Передержка проходит в нашей квартире в Петроварадине.</p>
          </div>
        ) : !isEnglish && isCats ? (
          <div class="cat-hero-intro">
            <h2>Не знаете, с кем оставить котика во время отъезда?</h2>
            <p class="pet-hero__lead">На домашней передержке питомец остаётся под присмотром и получает столько внимания и личного пространства, сколько ему нужно.</p>
            <p>Мы не торопим знакомство, даём кошке возможность спрятаться, привыкнуть к новым запахам, поспать в одиночестве — столько, сколько нужно. <strong>А привычные корм и наполнитель помогают сохранить знакомую часть домашней рутины.</strong></p>
          </div>
        ) : <p class="pet-hero__lead">{page.lead}</p>}
        <p class="pet-hero__price"><strong>{priceLabel}</strong>{isMain && <span>{isEnglish ? "We host no more than two guest pets at the same time." : "Берём максимум двух гостевых животных одновременно."}</span>}</p>
        <div class="pet-actions">
          <a class="pet-button pet-button--primary" href="#dates">{isEnglish ? "Check available dates" : "Проверить даты"}</a>
          <a class="pet-button" href={telegram} target="_blank" rel="noreferrer">{isEnglish ? "Message Anna on Telegram" : "Написать Ане в Telegram"}</a>
        </div>
      </div>
      <div class="hero-media">
        <img src={heroPhoto} alt={isEnglish ? isDogs ? "Dog staying with us in our home" : isCats ? "Cat staying with us in our home" : "Pet staying with us in our home" : isDogs ? "Собака на домашней передержке" : isCats ? "Кошка на домашней передержке" : "Питомец на домашней передержке"} width="1200" height="900" />
      </div>
    </section>

    {isMain && (
      <>
        <section class="early-media">
          <div>
            {isEnglish ? (
              <><h2>See what staying with us actually looks like</h2><p>We send photos and videos regularly.</p><p>A message saying "everything is fine" is one thing. Actually seeing your pet eating, sleeping, walking around, lying on the sofa or simply getting comfortable is much more useful.</p><p>These are real photos and videos from pets that have stayed with us.</p></>
            ) : (
              <><h2>Как питомцы живут у нас</h2><p>Для нас это важная часть передержки. Когда оставляешь питомца у других людей, сообщение «всё хорошо» — это одно. А когда видишь, как он ест, спит, гуляет, валяется на диване или уже освоился и занимается своими делами, — совсем другое.</p><p>Поэтому мы присылаем фото и видео минимум 3 раза в день и всегда остаёмся на связи.</p></>
            )}
          </div>
          <PetMedia photos={photos} videos={videos} label={isEnglish ? "guest pets" : "гостей"} videoLabel={videoLabel} locale={locale} />
        </section>
        <PetSittingCalendar locale={locale} kind={kind} />
        <PetPricing locale={locale} />

        <section class="routine-section">
          <div><h2>{isEnglish ? "Not one fixed routine for every animal" : "Не гостиница с одним режимом для всех"}</h2></div>
          <div class="routine-copy">
            {isEnglish ? (
              <><p>Every pet has different habits, and we do not see much point in changing them just because their owner is away.</p><p>If a dog normally goes out three times a day, we go out three times. If they normally sleep on the bed, the bed is fine here too.</p><p>If a cat needs a particular food, litter box or litter, we use what they are familiar with.</p><p>If your pet needs more attention — or would rather stay somewhere quiet and be left alone — both are fine.</p><p><strong>In short, we try to adapt the stay to the animal rather than make the animal adapt to the stay.</strong></p></>
            ) : (
              <><p>У каждого питомца свои привычки, и мы не меняем их просто потому, что хозяин уехал.</p><p>Если собака привыкла гулять три раза в день — гуляем три. Если привыкла спать на кровати — спит на кровати. Если кошке нужны определённый лоток и наполнитель — привозите их с собой.</p><p>Если питомцу нужно много внимания или, наоборот, хочется побыть отдельно и чтобы его никто не трогал, — мы обеспечим это.</p><p><strong>Мы подстраиваем передержку под питомца, а не питомца под передержку.</strong></p></>
            )}
          </div>
        </section>

        <section class="routine-section">
          <div>
            <h2>{isEnglish ? "Where your pet will stay" : "Как всё устроено дома"}</h2>
          </div>
          <div class="routine-copy">
            {isEnglish ? (
              <><p>We live in an apartment in Petrovaradin.</p><p>There are three separate rooms, so animals can be kept apart if someone needs their own space.</p><p>There is no garden or balcony. Dogs are walked outside according to their normal routine.</p><p>Sofas and beds are fine if your pet is allowed on them at home.</p><p>We have our own male cat and female cat. Both are four years old and have lived around both dogs and other cats.</p></>
            ) : (
              <><p>Мы живём в квартире в Петроварадине. У нас три изолированные комнаты, поэтому, если питомцам нужно отдельное пространство, мы спокойно их разделяем.</p><p>Двора и балкона нет. С собаками гуляем на улице по привычному для них графику.</p><p>У нас нет запретов на диваны и кровати, а кошкам можно забираться на столы и шкафы.</p><p>У нас живут свои кот и кошка, обоим по четыре года. Они привыкли к гостям: у нас уже оставались на передержке и собаки, и другие кошки.</p><p>Вашему питомцу совершенно не обязательно с ними дружить. Если ему комфортнее жить отдельно, мы разделим животных и выделим каждому своё пространство.</p></>
            )}
          </div>
        </section>

        <ResidentCats locale={locale} />

        <section class="intro-section">
          {isEnglish ? (
            <><div><h2>You can meet us first</h2><p>Before the first stay, you are welcome to visit our home for around 30 minutes for free.</p><p>You can meet us, see the apartment, let your pet look and sniff around, and we can see how everyone reacts to each other.</p><p>If you want a more realistic test, you can leave your dog or cat with us for a few hours before the main stay.</p><p><strong>Trial stay: 1,000 RSD.</strong></p></div><div><h2>What should you bring?</h2><p>Anything that helps your pet live roughly the same way they do at home.</p><p>Food, bowls, lead, carrier, medication, toys and their own bed if they use one.</p><p>For cats, you can also bring their usual litter box and litter.</p><p>If your pet has a particular routine, ritual or slightly strange habit, just tell us.</p></div></>
          ) : (
            <><div><h2>Познакомимся заранее</h2><p>Перед первой передержкой можно прийти к нам домой — это бесплатно. Вы познакомитесь с нами, и увидите, где будет жить питомец.</p><p>Собаку можно взять с собой — она всё понюхает, осмотрится, познакомится с нами и котами, а мы посмотрим, как животные друг на друга реагируют.</p><p>Кошку приносить на знакомство не рекомендуем: короткий визит в незнакомое пространство скорее станет для неё лишним стрессом и не покажет, как она будет чувствовать себя во время полноценной передержки.</p><p>Если хочется проверить, как собака чувствует себя без хозяина, можно оставить её у нас на 3–4 часа. Тестовая передержка стоит 1 000 RSD.</p></div><div><h2>Что взять с собой</h2><p>Всё, что помогает питомцу чувствовать себя привычно в новом месте.</p><p>Корм, миски, поводок или переноску, лекарства, игрушки, любимую лежанку — если она ему нужна. Для кошки рекомендуем привезти привычные лоток и наполнитель.</p><p>Если у питомца есть особенный ритуал, режим или странная привычка — обязательно расскажите нам. Мы это учтём.</p></div></>
          )}
        </section>
      </>
    )}

    {isDogs && (
      <>
        <section class="early-media"><div>{isEnglish ? <><h2>Real dogs staying with us</h2><p>We send regular photos and videos rather than just a ceremonial "everything is fine" picture.</p><p>Walks, sleeping, playing, lying on the sofa and simply getting on with normal life — we want you to be able to see what your dog is actually doing.</p></> : <><h2>Фото и видео каждый день</h2><p>Мы знаем, как тревожно оставлять любимого питомца, поэтому присылаем фото и видео минимум 3 раза в день. Не ограничиваемся сообщением «всё хорошо», а показываем, как на самом деле проходит день собаки у нас.</p><p>Прогулки, сон, игры, валяние на диване, знакомство с котами — всё, что происходит в течение дня.</p></>}</div><PetMedia photos={photos} videos={videos} label={isEnglish ? "guest dogs" : "собак-гостей"} videoLabel={videoLabel} locale={locale} /></section>
        <PetSittingCalendar locale={locale} kind={kind} />
        <PetPricing locale={locale} />

        <section class="species-intro dog-routine">
          <div><h2>{isEnglish ? "We are not going to retrain your dog in a week" : "Никаких резких изменений"}</h2></div>
          <div>{isEnglish ? <><p>Boarding is not a particularly good time to suddenly introduce a completely new set of rules.</p><p>So we first ask how your dog normally lives at home and try to keep things similar.</p><p>How many walks? When do they eat? Where do they sleep? Are they allowed on the sofa? Are they comfortable staying alone?</p><p>If something in their routine matters to them, just tell us beforehand.</p></> : <><p>Передержка — не время вводить новые правила. Перед заездом мы узнаём привычный режим вашей собаки и придерживаемся его на протяжении всей передержки.</p><p>Сколько прогулок нужно? Когда и сколько ест? Где любит спать? Спокойно ли остаётся одна? Принимает ли лекарства?</p><p>Расскажите нам заранее обо всём, что считаете важным, — и мы это учтём.</p></>}</div>
        </section>

        <section class="dog-cats-section">
          <div>{isEnglish ? <><h2>What if my dog cannot stay alone?</h2><p>That happens.</p><p>If your dog cannot comfortably stay home without a person, tell us before booking.</p><p>We can sometimes arrange the stay so that one of us is home while the dog is staying with us.</p></> : <><h2>Если собака не остаётся одна</h2><p>Такое тоже бывает. Если вашему питомцу постоянно нужен человек рядом, скажите об этом до передержки. Мы организуем всё так, чтобы во время проживания собаки дома всегда был кто-то из нас.</p></>}</div>
          <div class="plain-note"><p>{isEnglish ? "This is not an automatic promise for every booking, so it is important to discuss it in advance." : "Такую потребность важно обсудить заранее, чтобы мы могли спланировать своё время и подтвердить, что сможем быть рядом с собакой 24/7."}</p></div>
        </section>

        <section class="dog-cats-section">
          <div>{isEnglish ? <><h2>We have two cats</h2><p>If you do not know how your dog behaves around cats, it is worth checking before the stay.</p><p>Normal curiosity, sniffing, wanting to meet them or trying to play is not automatically a problem.</p><p>It is different if the dog genuinely hunts or relentlessly chases cats, cannot disengage, or shows serious aggression.</p><p>In that case, it is more sensible to choose a sitter without resident cats.</p><p>That is one reason we offer a free introduction before boarding.</p></> : <><h2>У нас есть два своих кота</h2><p>Если вы не знаете, как ваша собака относится к кошкам, это лучше проверить заранее.</p><p>Обычный интерес, желание понюхать, познакомиться или поиграть — нормальная реакция и не преграда для совместного проживания.</p><p>Если же собака охотится за кошками, не может переключиться или проявляет серьёзную агрессию, честнее будет выбрать ситтера без своих кошек.</p><p>Именно для этого у нас есть бесплатное знакомство.</p></>}</div>
          <div class="plain-note">{isEnglish ? <><h2>What if they simply do not like each other?</h2><p>That is fine.</p><p>There are three separate rooms in the apartment, and nobody has to become best friends.</p><p>We can separate the animals so everyone has their own space.</p><p>Your dog will still spend time with us, go for walks and live their normal life.</p></> : <><h2>А если они просто не понравятся друг другу?</h2><p>Это не страшно.</p><p>У нас три изолированные комнаты, и животным совсем не обязательно становиться лучшими друзьями.</p><p>Мы разделяем питомцев так, чтобы у каждого оставалось своё безопасное пространство. При этом собака продолжает общаться с нами, гулять и жить в своём обычном ритме.</p></>}</div>
        </section>

        <section class="dog-trial">
          {isEnglish ? <><h2>You can test it first</h2><p>Before the first stay, you can visit us at home for around 30 minutes for free.</p><p>Your dog can meet us, see the apartment and meet the cats, and you can see where they would be staying.</p><p>If you want to test being away from the owner, you can leave them with us for a few hours for 1,000 RSD.</p></> : <><h2>познакомимся заранее</h2><p>Перед первой передержкой мы приглашаем зайти к нам домой на 30 минут — это бесплатно. Собака познакомится с нами, квартирой и котами, а вы сами увидите, где и с кем она будет жить.</p><p>Если хочется проверить, как собака чувствует себя без хозяина, можно оставить её у нас на 3–4 часа. Тестовая передержка стоит 1 000 RSD.</p></>}
        </section>
        <section class="intro-section">{isEnglish ? <><div><h2>We walk your dog as often as they are used to</h2><p>There is no rule here that every dog gets exactly two twenty-minute walks.</p><p>Tell us their normal schedule and we will keep as close to it as we reasonably can.</p><p>The same applies to feeding, medication and other familiar routines.</p></div><div><h2>Can my dog sleep on the sofa or bed?</h2><p>Yes.</p><p>If your dog sleeps in their own bed at home, you can bring it.</p><p>If they normally lie on the sofa, that is fine.</p><p>If they normally sleep with a person on the bed, we do not have a rule against that either.</p></div></> : <><div><h2>Гуляем так, как собака привыкла</h2><p>У нас нет правила «всем собакам две прогулки по двадцать минут». Если ваш питомец привык к определённому графику и длительности прогулок — расскажите нам, и мы будем его соблюдать.</p><p>То же самое с кормлением, лекарствами и другими привычными вещами.</p></div><div><h2>Где питомец будет спать?</h2><p>Там, где привык дома. Если собака спит на своей лежанке — возьмите её с собой, знакомое место поможет ей быстрее освоиться.</p><p>Привыкла отдыхать на диване — пожалуйста. Спит с человеком на кровати — мы только за.</p></div></>}</section>
      </>
    )}

    {isCats && (
      <>
        <section class="early-media"><div>{isEnglish ? <><h2>Real cats staying with us</h2><p>Yes, we send lots of photos and videos :)</p><p>When we leave our own pets with someone, it is much more reassuring to see how they are actually doing than to receive only a message saying "everything is fine."</p><p>So photos and videos are a normal part of the stay.</p></> : <><h2>Фото и видео каждый день</h2><p>Мы знаем, как тревожно оставлять любимого питомца, поэтому присылаем фото и видео <strong>минимум 3 раза в день</strong>. Не ограничиваемся сообщением «всё хорошо», а показываем, как на самом деле проходит день кошки у нас.</p><p>Сон, питание, игры, валяние на диване, знакомство с котами — всё, что происходит в течение дня.</p></>}</div><PetMedia photos={photos} videos={videos} label={isEnglish ? "guest cats" : "кошек-гостей"} videoLabel={videoLabel} locale={locale} /></section>
        <PetSittingCalendar locale={locale} kind={kind} />
        <PetPricing locale={locale} />

        <section class="cat-safe-space">
          <div class="cat-safe-space__copy">{isEnglish ? <><h2>If your cat does not like other cats, that is fine</h2><p>We have our own male cat and female cat, but your cat does not need to become friends with them.</p><p>There are three separate rooms in the apartment.</p><p>If your cat is more comfortable living separately, we can give them their own space and not make them meet our cats at all.</p></> : <><h2>Если кошка не дружит с другими — это нормально</h2><p>У нас живут свои кот и кошка, но вашему питомцу совершенно не обязательно с ними общаться.</p><p>В квартире три изолированные комнаты. Если котику спокойнее жить отдельно, мы выделим ему своё безопасное пространство и организуем всё так, чтобы животные не пересекались.</p></>}</div>
          <div class="cat-list"><p>{isEnglish ? "Our cats are already used to other animals, but if a guest wants to stay in their own room and see nobody, that is also fine." : "Наши коты уже привыкли к другим животным, а если гость хочет сидеть в своей комнате и никого не видеть — тоже ок."}</p></div>
        </section>

        <section class="routine-section"><div><h2>{isEnglish ? "We try to keep things familiar" : "Сохраняем привычный режим, как дома"}</h2></div><div class="routine-copy">{isEnglish ? <><p>We are not going to deliberately change your cat's habits just because they are staying with us.</p><p>Bring their normal food, bowls, litter box, usual litter, toys and medication — whatever helps things feel normal.</p><p>If they want to hide for the first few days, they can hide.</p><p>If they normally sleep on the bed, the bed is fine.</p><p>If they need a quiet separate space, we can arrange that.</p></> : <><p>Передержка — не время вводить новые правила. Перед заездом мы узнаём о рутине вашей кошки и придерживаемся её всё время, пока питомец живёт у нас.</p><p>Привозите привычный корм, миски, лоток, наполнитель, игрушки — всё это поможет кошке чувствовать себя спокойнее в новом месте.</p><p>Если в первые дни кошка захочет спрятаться и не выходить, поставим миски и лоток рядом и дадим столько времени на адаптацию, сколько потребуется.</p></>}</div></section>
        <ResidentCats compact={true} locale={locale} note={isEnglish ? "Your cat does not need to become friends with them." : "Наши коты будут рады познакомиться, но если ваша кошка выберет побыть одной, мы не будем настаивать на знакомстве и выделим каждому своё пространство."} showSeparationNote={false} />

        <section class="cat-arrival">
          <div>{isEnglish ? <><h2>Meeting before the stay</h2><p>If you would like, you can visit us for around 30 minutes before the first stay for free.</p><p>You can see the apartment and meet us, your cat can look around a little, and we can see how they react to the new place and our cats.</p></> : <><h2>Познакомимся заранее</h2><p>Перед первой передержкой приглашаем вас зайти к нам домой примерно на 30 минут — это бесплатно. Вы познакомитесь с нами, увидите квартиру и условия, в которых будет жить питомец, познакомитесь с нашими котами.</p><p>Саму кошку приносить на знакомство не рекомендуем: короткий визит в незнакомое пространство скорее станет для неё лишним стрессом и не покажет, как она будет чувствовать себя во время полноценной передержки.</p></>}</div>
          <p class="cat-arrival__note">{isEnglish ? <>You can also leave your cat with us for a few hours as a trial stay. <strong>Trial stay: 1,000 RSD.</strong></> : <>Можно также оставить кошку тестово на несколько часов — это стоит <strong>1 000 RSD</strong>.</>}</p>
        </section>
      </>
    )}

    <section class="faq-section" id="faq">
      <div><p class="eyebrow">{isEnglish ? "Frequently asked questions" : "Частые вопросы"}</p><h2>{isEnglish ? isDogs ? "Dog boarding FAQ" : isCats ? "Cat boarding FAQ" : "Pet boarding FAQ" : isDogs ? "О передержке собак" : isCats ? "О передержке кошек" : "Что обычно спрашивают"}</h2></div>
      <div class="faq-list">{faq.map(([question, answer], index) => <details id={index === 0 ? "boarding-days" : undefined} open={index === 0}><summary>{question}</summary><p>{answer}</p></details>)}</div>
    </section>

    <section class="related-section" aria-labelledby="related-title">
      <p class="eyebrow">{isEnglish ? "More information" : "Подробнее"}</p><h2 id="related-title">{isEnglish ? isMain ? "Dog and cat boarding" : "Other pet boarding pages" : isMain ? "Отдельно о собаках и кошках" : "Другие страницы передержки"}</h2>
      <nav>{related.map((item) => <a href={localizedPages[item].path}>{localizedPages[item].h1}<span>→</span></a>)}</nav>
    </section>

    <section class="guide-section" aria-labelledby="guide-title">
      <p class="eyebrow">{isEnglish ? "Practical guides" : "Полезные гайды"}</p>
      <h2 id="guide-title">{isEnglish ? "Choose and prepare for boarding" : "Как выбрать и подготовиться к передержке"}</h2>
      <nav>{guides.map((guide) => <a href={guide.href}><span><strong>{guide.title}</strong><small>{guide.description}</small></span><b aria-hidden="true">→</b></a>)}</nav>
    </section>

    <section class="final-cta">
      <div><p class="eyebrow">{isEnglish ? "Petrovaradin" : "Петроварадин"}</p><h2>{isEnglish ? "Message Anna and tell us which dates you need" : "Напишите Ане и расскажите, на какие даты нужна передержка"}</h2></div>
      <a class="pet-button pet-button--primary" href={telegram} target="_blank" rel="noreferrer">{isEnglish ? "Message Anna on Telegram" : "Написать Ане в Telegram"}</a>
    </section>
  </div>
</BaseLayout>

<style is:inline>
  html[lang] { scroll-padding-top:84px; }
  .prose:has(.pet-page) { width:100%; max-width:none; padding:0; }
  .pet-page { --ink:#20332f; --muted:#52645d; --line:#d9e2dc; --paper:#fbfaf6; --accent:#275f4b; --warm:#9d623c; overflow:hidden; margin:-34px 0; padding:0 24px 72px; background:#fbfaf6; color:var(--ink); font-size:17px; }
  .pet-page * { min-width:0; }
  .pet-page a { color:inherit; }
  .pet-page p { text-wrap:pretty; }
  .pet-page h1,.pet-page h2,.pet-page h3 { overflow-wrap:normal; word-break:normal; hyphens:none; }
  .main-hero-intro h2,.dog-hero-intro h2,.cat-hero-intro h2 { margin:24px 0 12px; font-size:clamp(21px,2vw,28px); line-height:1.18; letter-spacing:-.025em; }
  .main-hero-intro p,.dog-hero-intro p,.cat-hero-intro p { margin:0 0 10px; color:var(--muted); font-size:17px; line-height:1.65; }
  .pet-locale-switch { display:flex; width:min(1160px,100%); justify-content:flex-end; gap:7px; margin:0 auto -48px; padding-top:18px; color:var(--muted); font-size:12px; font-weight:800; letter-spacing:.08em; }.pet-locale-switch a { text-decoration:none; }.pet-locale-switch a[aria-current="page"] { color:var(--accent); text-decoration:underline; text-underline-offset:3px; }
  .pet-hero,.trust-summary,.early-media,.routine-section,.resident-section,.pricing-section,.intro-section,.species-intro,.dog-cats-section,.dog-trial,.cat-safe-space,.cat-arrival,.pet-media,.faq-section,.related-section,.final-cta { width:min(1160px,100%); margin-inline:auto; }
  .eyebrow { margin:0 0 12px; color:var(--accent); font-size:12px; font-weight:800; letter-spacing:.11em; text-transform:uppercase; }
  .pet-hero { display:grid; grid-template-columns:minmax(0,1.05fr) minmax(360px,.95fr); gap:56px; align-items:center; min-height:610px; padding:70px 0 58px; }
  .pet-hero h1 { max-width:760px; margin:0; font-size:clamp(48px,4.7vw,64px); line-height:1.02; letter-spacing:-.045em; }
  .pet-hero__lead { max-width:690px; margin:22px 0 0; color:var(--muted); font-size:21px; line-height:1.43; }
  .pet-hero__price { display:flex; flex-wrap:wrap; gap:8px 18px; margin:22px 0 0; }.pet-hero__price strong { font-size:18px; }.pet-hero__price span { color:var(--muted); }
  .pet-actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:28px; }.pet-button { display:inline-flex; min-height:46px; align-items:center; justify-content:center; border:1px solid var(--ink); border-radius:8px; padding:10px 16px; font:inherit; font-weight:750; text-decoration:none; }.pet-page .pet-button--primary { border-color:var(--accent); background:var(--accent); color:#fff; }
  .hero-media { aspect-ratio:4/3; overflow:hidden; background:#edf0eb; }.hero-media img { width:100%; height:100%; object-fit:cover; }
  .trust-summary { border-block:1px solid var(--line); padding:20px 0; }.trust-summary ul { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:9px 56px; margin:0; padding-left:20px; }.trust-summary li { padding-left:3px; font-size:15px; line-height:1.45; }.trust-summary li::marker { color:var(--accent); }
