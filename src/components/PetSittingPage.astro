---
import BaseLayout from "../layouts/BaseLayout.astro";
import PetMedia from "./PetMedia.astro";
import PetPricing from "./PetPricing.astro";
import PetSittingCalendar from "./PetSittingCalendar.astro";
import ResidentCats from "./ResidentCats.astro";
import {
  petSittingConfig,
  petSittingPages,
  telegramUrl,
  type PetSittingPageKind,
} from "../data/pet-sitting";

const { kind } = Astro.props as { kind: PetSittingPageKind };
const page = petSittingPages[kind];
const telegram = telegramUrl();
const isMain = kind === "main";
const isDogs = kind === "dogs";
const isCats = kind === "cats";
const heroPhoto = petSittingConfig.heroPhotos[kind];
const related = (["main", "dogs", "cats"] as PetSittingPageKind[]).filter(
  (item) => item !== kind,
);
const photos = petSittingConfig.guestPhotos.filter(
  (photo) => !photo.kind || photo.kind === kind || kind === "main",
);
const videos = petSittingConfig.youtubeVideos.filter(
  (video) => !video.kind || video.kind === kind || kind === "main",
);

const faqByPage: Record<PetSittingPageKind, string[][]> = {
  main: [
    ["А если питомец не подружится с вашими котами?", "Ничего страшного. Дружить необязательно. До первой передержки можно прийти на знакомство, а во время проживания животных можно разделить по комнатам."],
    ["Можно сначала посмотреть квартиру?", "Да. Бесплатное знакомство длится примерно 30 минут: вы увидите квартиру, а питомец успеет всё обнюхать и немного освоиться."],
    ["Можно сначала оставить питомца на несколько часов?", "Да. Пробная передержка для собаки или кошки стоит 1 000 RSD."],
    ["Будете присылать фото и видео?", "Да, часто. Нам самим спокойнее, когда мы видим, как живёт наш питомец, поэтому будем показывать прогулки, еду, сон, игры и обычные моменты дня."],
    ["Что если питомцу внезапно станет плохо?", "Таких экстренных случаев у нас пока не было. Если ждать ответа опасно, действуем в интересах животного, при необходимости обращаемся к ветеринару и сразу связываемся с хозяином."],
    ["Сколько животных вы принимаете одновременно?", "Максимум двух гостевых животных. Два питомца из одной семьи можно привезти вместе."],
    ["Можно оставить питомца надолго?", "Да. Долгие сроки обсуждаем отдельно; ориентировочный максимум — около двух месяцев."],
  ],
  dogs: [
    ["Как часто вы гуляете с собакой?", "Так часто и примерно в то же время, как она привыкла дома. До передержки вы расскажете её обычный график."],
    ["Если собака не умеет оставаться одна?", "Скажите заранее. Постараемся организовать дни так, чтобы кто-то из нас был дома и собаке не приходилось оставаться одной."],
    ["Моя собака любит гоняться за кошками. Вы её возьмёте?", "Зависит от того, что значит «гоняться». Любопытство и игру можно оценить на знакомстве. При серьёзной погоне, агрессии или сильном охотничьем поведении лучше выбрать ситтера без домашних кошек."],
    ["Можно собаке на диван или кровать?", "Да, если дома ей это разрешают. Не будем менять привычные правила только из-за передержки."],
    ["Можно сначала познакомить собаку с вашими котами?", "Да. Для этого и нужно бесплатное знакомство примерно на 30 минут. Дружба не обязательна — важно понять, смогут ли животные спокойно жить рядом или раздельно."],
    ["Можно оставить собаку на пробу?", "Да, на несколько часов без хозяина. Пробная передержка стоит 1 000 RSD."],
    ["Будете присылать видео с прогулок?", "Да. Будем присылать фото и видео прогулок, отдыха, еды и того, как собака чувствует себя дома."],
  ],
  cats: [
    ["Моя кошка не любит других кошек. Это проблема?", "Не обязательно. Для неё можно выделить отдельную комнату и не заставлять знакомиться с нашими котами."],
    ["Можно ли привезти свой лоток и наполнитель?", "Да, и это желательно, если так кошке будет привычнее. Привозите корм, лоток, наполнитель, миски, переноску и знакомые вещи."],
    ["Что если кошка будет всё время прятаться?", "Прятаться в новом месте нормально. Не будем вытаскивать её или заставлять общаться: дадим время и тихое место."],
    ["Какие прививки нужны кошке?", "Нужны действующие комплексная прививка и прививка от бешенства. Обе должны быть сделаны в течение последних 12 месяцев."],
    ["Ваших котов можно отделить?", "Да. В квартире три изолированные комнаты, поэтому животных можно держать раздельно столько, сколько нужно."],
    ["Нужно ли знакомить кошку с вашими котами?", "Нет. Если спокойнее жить отдельно, никакого принудительного знакомства не будет."],
    ["Можно сначала оставить кошку на несколько часов?", "Да. Пробная передержка стоит 1 000 RSD и помогает понять, как кошка ведёт себя без хозяина."],
  ],
};
const faq = faqByPage[kind];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: page.h1,
    description: page.description,
    url: `https://getmanov.com${page.path}`,
    areaServed: "Petrovaradin, Novi Sad",
    serviceType: "Домашняя передержка животных",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Главная", item: "https://getmanov.com/" },
      { "@type": "ListItem", position: 2, name: "Передержка животных", item: "https://getmanov.com/ru/novi-sad/pet-sitting/" },
      ...(isMain ? [] : [{ "@type": "ListItem", position: 3, name: page.focus, item: `https://getmanov.com${page.path}` }]),
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map(([question, answer]) => ({
      "@type": "Question",
      name: question,
      acceptedAnswer: { "@type": "Answer", text: answer },
    })),
  },
];
---

<BaseLayout title={page.title} description={page.description} canonical={page.path} lang="ru" structuredData={structuredData}>
  <div class:list={["pet-page", `pet-page--${kind}`]}>
    <section class="pet-hero">
      <div class="pet-hero__copy">
        <p class="eyebrow">Петроварадин · Нови-Сад</p>
        <h1>{page.h1}</h1>
        <p class="pet-hero__lead">{page.lead}</p>
        <p class="pet-hero__price"><strong>От 1 500 RSD/сутки</strong><span>Максимум два гостевых животных</span></p>
        <div class="pet-actions">
          <a class="pet-button pet-button--primary" href="#dates">Проверить даты</a>
          <a class="pet-button" href={telegram} target="_blank" rel="noreferrer">Написать Ане в Telegram</a>
        </div>
      </div>
      <div class="hero-media">
        {heroPhoto ? (
          <img src={heroPhoto} alt={isDogs ? "Собака на домашней передержке" : isCats ? "Кошка на домашней передержке" : "Питомец на домашней передержке"} width="1200" height="900" />
        ) : (
          <div class="media-placeholder">
            <span>Место для реальной фотографии</span>
            <small>{isDogs ? "собаки-гостя" : isCats ? "кошки-гостя" : "питомца или квартиры"}</small>
          </div>
        )}
      </div>
    </section>

    {isMain && (
      <>
        <section class="trust-summary" aria-label="Главное о передержке">
          <ul>
            <li>Питомец живёт в квартире с тремя изолированными комнатами.</li>
            <li>Прогулки, кормление и сон — примерно по домашнему графику.</li>
            <li>До первого проживания можно бесплатно познакомиться.</li>
            <li>Будем часто присылать фото и видео.</li>
          </ul>
        </section>

        <section class="early-media">
          <div>
            <p class="eyebrow">Настоящая передержка</p>
            <h2>Покажем, как питомец живёт у нас</h2>
            <p>Не ограничимся сообщением «всё хорошо». Будем снимать прогулки, сон, еду, игры и обычные домашние моменты.</p>
          </div>
          <PetMedia photos={photos} videos={videos} label="гостей" />
        </section>

        <PetSittingCalendar />

        <section class="routine-section">
          <div>
            <p class="eyebrow">Как проходит день</p>
            <h2>Пытаемся изменить жизнь питомца как можно меньше</h2>
          </div>
          <div class="routine-copy">
            <p>Заранее спросим, когда питомец ест, гуляет и спит, где любит лежать и какие правила знает дома. Если собака привыкла спать на кровати — пусть спит на кровати. Для кошки можно привезти её лоток, наполнитель и знакомые вещи.</p>
            <p>В квартире нет балкона и частного двора. Собак выгуливаем на улице по их обычному графику. Если животному нужно побыть одному, для него можно выделить отдельную комнату.</p>
          </div>
        </section>

        <ResidentCats />
        <PetPricing />

        <section class="intro-section">
          <div><p class="eyebrow">Сначала познакомиться</p><h2>30 минут дома — бесплатно</h2><p>Вы увидите квартиру, а питомец успеет всё обнюхать и посмотреть на наших котов. Точный адрес сообщим лично.</p></div>
          <div><p class="eyebrow">Пробная передержка</p><h2>Несколько часов — 1 000 RSD</h2><p>Можно оставить собаку или кошку без хозяина до основной даты и посмотреть, как проходит адаптация.</p></div>
        </section>
      </>
    )}

    {isDogs && (
      <>
        <section class="species-intro dog-routine">
          <div><p class="eyebrow">Обычный день собаки</p><h2>Гуляем, кормим и укладываем спать примерно как дома</h2></div>
          <ol>
            <li><strong>Прогулки.</strong> Спросим, сколько раз и в какое время собака привыкла выходить.</li>
            <li><strong>Еда.</strong> Кормите по привычному графику и привозите знакомый корм.</li>
            <li><strong>Сон и мебель.</strong> Если дома можно на диван или кровать, у нас тоже можно.</li>
            <li><strong>Одиночество.</strong> Если собака не умеет оставаться одна, скажите заранее — постараемся организовать так, чтобы кто-то был дома.</li>
          </ol>
        </section>

        <PetMedia photos={photos} videos={videos} label="собак-гостей" />
        <PetSittingCalendar />

        <section class="dog-cats-section">
          <div><p class="eyebrow">В квартире живут два кота</p><h2>Важно понять, как собака реагирует на кошек</h2><p>Любопытство, попытка познакомиться или поиграть — не автоматическая проблема. Серьёзная погоня, агрессия или сильное охотничье поведение означают, что передержка без домашних кошек будет безопаснее.</p></div>
          <div class="plain-note"><strong>Дружить не обязательно.</strong><p>В квартире три изолированные комнаты. Если животным спокойнее раздельно, так и организуем.</p></div>
        </section>

        <section class="dog-trial">
          <h2>До первой передержки</h2>
          <p><strong>Бесплатное знакомство:</strong> около 30 минут у нас дома вместе с хозяином.</p>
          <p><strong>Пробная передержка:</strong> несколько часов без хозяина за 1 000 RSD.</p>
          <p>Во время проживания будем часто присылать фото и видео — с прогулок и из дома.</p>
        </section>
        <PetPricing />
      </>
    )}

    {isCats && (
      <>
        <section class="cat-safe-space">
          <div class="cat-safe-space__copy"><p class="eyebrow">Своя комната, если нужно</p><h2>Кошку не придётся заставлять знакомиться</h2><p>В квартире три изолированные комнаты. Если кошка боится, прячется или не любит других животных, она может жить отдельно от наших котов. Прятаться в новом месте нормально.</p></div>
          <div class="cat-list"><p>Привозите её обычный корм.</p><p>Можно привезти свой лоток и привычный наполнитель.</p><p>Знакомые лежанка, плед и игрушки тоже помогают.</p><p>Комплексная прививка и бешенство должны быть сделаны за последние 12 месяцев.</p></div>
        </section>

        <ResidentCats compact={true} />
        <PetMedia photos={photos} videos={videos} label="кошек-гостей" />
        <PetSittingCalendar />

        <section class="cat-arrival">
          <div><p class="eyebrow">Перед проживанием</p><h2>Можно прийти с кошкой заранее</h2><p>Знакомство дома занимает около 30 минут и ничего не стоит. Пробная передержка на несколько часов без хозяина стоит 1 000 RSD.</p></div>
          <p class="cat-arrival__note">Будем часто присылать фото и видео. Даже если кошка в первые дни только прячется и осторожно выходит поесть — покажем именно это, без красивых отчётов ради отчётов.</p>
        </section>
        <PetPricing />
      </>
    )}

    <section class="faq-section" id="faq">
      <div><p class="eyebrow">Частые вопросы</p><h2>{isDogs ? "О передержке собак" : isCats ? "О передержке кошек" : "Что обычно спрашивают"}</h2></div>
      <div class="faq-list">{faq.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div>
    </section>

    <section class="related-section" aria-labelledby="related-title">
      <p class="eyebrow">Подробнее</p><h2 id="related-title">{isMain ? "Отдельно о собаках и кошках" : "Другие страницы передержки"}</h2>
      <nav>{related.map((item) => <a href={petSittingPages[item].path}>{petSittingPages[item].h1}<span>→</span></a>)}</nav>
    </section>

    <section class="final-cta">
      <div><p class="eyebrow">Петроварадин</p><h2>Напишите Ане и расскажите, на какие даты нужна передержка</h2></div>
      <a class="pet-button pet-button--primary" href={telegram} target="_blank" rel="noreferrer">Написать Ане в Telegram</a>
    </section>
  </div>
</BaseLayout>

<style is:inline>
  html[lang="ru"] { scroll-padding-top:84px; }
  .prose:has(.pet-page) { width:100%; max-width:none; padding:0; }
  .pet-page { --ink:#20332f; --muted:#687771; --line:#d9e2dc; --paper:#fbfaf6; --accent:#275f4b; --warm:#9d623c; overflow:hidden; margin:-34px 0; padding:0 24px 72px; background:#fbfaf6; color:var(--ink); }
  .pet-page * { min-width:0; }
  .pet-page a { color:inherit; }
  .pet-page h1,.pet-page h2,.pet-page h3 { overflow-wrap:normal; word-break:normal; hyphens:none; }
  .pet-hero,.trust-summary,.early-media,.availability,.routine-section,.resident-section,.pricing-section,.intro-section,.species-intro,.dog-cats-section,.dog-trial,.cat-safe-space,.cat-arrival,.pet-media,.faq-section,.related-section,.final-cta { width:min(1160px,100%); margin-inline:auto; }
  .eyebrow { margin:0 0 12px; color:var(--accent); font-size:12px; font-weight:800; letter-spacing:.11em; text-transform:uppercase; }
  .pet-hero { display:grid; grid-template-columns:minmax(0,1.05fr) minmax(360px,.95fr); gap:56px; align-items:center; min-height:610px; padding:70px 0 58px; }
  .pet-hero h1 { max-width:760px; margin:0; font-size:clamp(48px,4.7vw,64px); line-height:1.02; letter-spacing:-.045em; }
  .pet-hero__lead { max-width:690px; margin:22px 0 0; color:var(--muted); font-size:21px; line-height:1.43; }
  .pet-hero__price { display:flex; flex-wrap:wrap; gap:8px 18px; margin:22px 0 0; }.pet-hero__price strong { font-size:18px; }.pet-hero__price span { color:var(--muted); }
  .pet-actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:28px; }.pet-button { display:inline-flex; min-height:46px; align-items:center; justify-content:center; border:1px solid var(--ink); border-radius:8px; padding:10px 16px; font:inherit; font-weight:750; text-decoration:none; }.pet-page .pet-button--primary { border-color:var(--accent); background:var(--accent); color:#fff; }
  .hero-media { aspect-ratio:4/3; overflow:hidden; background:#edf0eb; }.hero-media img { width:100%; height:100%; object-fit:cover; }.media-placeholder { width:100%; height:100%; display:grid; place-content:center; gap:5px; color:var(--muted); text-align:center; }.media-placeholder span { color:var(--ink); font-weight:700; }.media-placeholder small { font-size:13px; }
  .trust-summary { border-block:1px solid var(--line); padding:20px 0; }.trust-summary ul { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:9px 56px; margin:0; padding-left:20px; }.trust-summary li { padding-left:3px; font-size:15px; line-height:1.45; }.trust-summary li::marker { color:var(--accent); }
  .early-media { display:grid; grid-template-columns:.7fr 1.3fr; gap:48px; align-items:center; padding:76px 0 24px; }.early-media h2,.routine-section h2,.resident-section h2,.pricing-section h2,.intro-section h2,.species-intro h2,.dog-cats-section h2,.dog-trial h2,.cat-safe-space h2,.cat-arrival h2,.faq-section h2,.related-section h2,.final-cta h2 { margin:0; font-size:clamp(30px,3.5vw,46px); line-height:1.08; letter-spacing:-.04em; }.early-media p:not(.eyebrow),.routine-copy,.resident-intro p:not(.eyebrow),.pricing-section>div:first-child p:not(.eyebrow),.species-intro p,.dog-cats-section p,.cat-safe-space p,.cat-arrival p { color:var(--muted); line-height:1.55; }
  .pet-media { padding:50px 0; }.early-media .pet-media { padding:0; }.media-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }.media-grid img,.media-grid iframe { width:100%; aspect-ratio:4/3; height:auto; border:0; object-fit:cover; background:#edf0eb; }.media-grid iframe { aspect-ratio:16/9; }.media-empty { min-height:250px; display:grid; place-content:center; gap:5px; border-block:1px solid var(--line); background:#f3f3ed; color:var(--muted); text-align:center; padding:30px; }.media-empty strong { color:var(--ink); }
  .availability { display:grid; grid-template-columns:260px 1fr; gap:38px; align-items:start; padding:72px 0; border-top:1px solid var(--line); }.availability__intro h2 { margin:0; font-size:38px; line-height:1.06; letter-spacing:-.04em; }.availability__intro>p:not(.eyebrow) { color:var(--muted); line-height:1.5; }.calendar-panel { display:grid; grid-template-columns:minmax(420px,1.15fr) minmax(260px,.85fr); gap:24px 30px; border-top:1px solid var(--ink); padding-top:18px; }.calendar-panel__header { grid-column:1; display:flex; justify-content:space-between; gap:12px; }.calendar-panel__header p { margin:4px 0 0; color:var(--muted); font-size:13px; }.calendar-controls { display:flex; gap:6px; }.calendar-nav { width:34px; height:34px; border:1px solid var(--line); border-radius:50%; background:transparent; color:var(--ink); font:inherit; cursor:pointer; }.calendar-nav:disabled { opacity:.3; }.calendar-months { grid-column:1; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; }.calendar-month h3 { margin:0 0 9px; font-size:15px; }.calendar-weekdays,.calendar-days { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); gap:2px; }.calendar-weekdays span { color:var(--muted); font-size:10px; text-align:center; }.calendar-days { margin-top:4px; }.calendar-days button { width:100%; aspect-ratio:1; border:0; border-radius:5px; background:transparent; color:var(--ink); font:inherit; font-size:12px; cursor:pointer; }.calendar-days button:hover:not(:disabled),.calendar-days button:focus-visible { outline:2px solid var(--accent); outline-offset:0; }.calendar-days button:disabled { color:#b5bdb8; cursor:not-allowed; }.calendar-days .is-unavailable { background:repeating-linear-gradient(-45deg,#efded9 0 3px,#faf6f1 3px 6px); color:#9d665d; text-decoration:line-through; }.calendar-days .is-selected { background:var(--accent); color:#fff; }.calendar-days .is-in-range { border-radius:0; background:#dbe9e0; }.inquiry-form { grid-column:2; grid-row:1 / span 2