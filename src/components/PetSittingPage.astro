---
import BaseLayout from "../layouts/BaseLayout.astro";
import PetMedia from "./PetMedia.astro";
import PetPricing from "./PetPricing.astro";
import PetSittingCalendar from "./PetSittingCalendar.astro";
import ResidentCats from "./ResidentCats.astro";
import {
  petSittingConfig,
  petSittingPages,
  telegramUrl,
  type PetSittingPageKind,
} from "../data/pet-sitting";

const { kind } = Astro.props as { kind: PetSittingPageKind };
const page = petSittingPages[kind];
const telegram = telegramUrl();
const isMain = kind === "main";
const isDogs = kind === "dogs";
const isCats = kind === "cats";
const priceLabel = isCats ? "от 1 500 RSD в сутки" : "От 1 500 RSD в сутки";
const heroPhoto = petSittingConfig.heroPhotos[kind];
const related = (["main", "dogs", "cats"] as PetSittingPageKind[]).filter(
  (item) => item !== kind,
);
const photos = petSittingConfig.guestPhotos.filter(
  (photo) => !photo.kind || photo.kind === kind || kind === "main",
);
const videos = (isMain
  ? petSittingConfig.guestVideos
  : petSittingConfig.guestVideos.filter((video) => video.animal === (isDogs ? "dog" : "cat"))
).sort((first, second) => Number(Boolean(second.featured)) - Number(Boolean(first.featured)));

const faqByPage: Record<PetSittingPageKind, string[][]> = {
  main: [
    ["А если мой питомец не подружится с вашими котами?", "Такое возможно, и ничего страшного в этом нет. Именно поэтому перед первой передержкой можно прийти познакомиться. А если дружбы всё равно не случится — у нас три изолированные комнаты, поэтому животных можно разделить. Ваш питомец всё равно получит от нас внимание и своё спокойное место. Дружить с нашими котами необязательно."],
    ["А нормально вообще оставлять животное там, где уже есть другие животные?", "Если всем хватает пространства и никого не заставляют общаться — да. Наши коты уже привыкли к гостям. Иногда животные знакомятся и начинают тусить вместе, иногда просто игнорируют друг друга. Нас устраивают оба варианта."],
    ["Сколько животных у вас бывает одновременно?", "Максимум два гостевых животных."],
    ["Можно сначала приехать познакомиться?", "Да. Можно бесплатно прийти к нам домой примерно на полчаса, посмотреть квартиру и познакомиться."],
    ["А можно оставить питомца на пробу?", "Да. Можно оставить собаку или кошку на несколько часов перед основной передержкой. Это стоит 1 000 RSD."],
    ["Будете присылать фото и видео?", "Да, регулярно. И не только одно дежурное фото :)."],
    ["Что если у моего питомца какой-то очень специфический режим?", "Расскажите нам. Мы не ждём, что все животные одинаковые. Если это что-то адекватное и выполнимое, постараемся сохранить его обычный режим."],
    ["А если что-нибудь пойдёт не так?", "Мы точно не будем молча ждать вашего возвращения. Попробуем разобраться в ситуации, сразу свяжемся с вами и вместе решим, что делать. Если вдруг случится срочная ситуация со здоровьем и ждать ответа будет опасно для животного, сделаем необходимое в моменте, при необходимости обратимся к ветеринару и сразу же сообщим вам."],
  ],
  dogs: [
    ["Моя собака любит гоняться за кошками. Вы её возьмёте?", "Смотря что именно значит «гоняться». Если ей просто интересно, хочется познакомиться или поиграть — это можно проверить на знакомстве. Если она действительно преследует кошек, не может переключиться или проявляет агрессию, лучше выбрать передержку без собственных котов."],
    ["А если собака не подружится с вашими котами?", "Это нормально. Дружить необязательно. В квартире три изолированные комнаты, поэтому животных при необходимости можно разделить."],
    ["Моя собака никогда не оставалась с чужими. Что делать?", "Для этого можно сначала прийти познакомиться, а потом при желании оставить её тестово на несколько часов. Не обязательно сразу начинать с недельной поездки."],
    ["Она вообще не умеет оставаться одна.", "Скажите нам заранее. Можно организовать передержку так, чтобы кто-то из нас оставался дома."],
    ["Сколько раз вы будете гулять?", "Столько, сколько собака привыкла гулять дома. Расскажите нам её обычный график."],
    ["Можно привезти свой корм?", "Да. Более того, лучше не менять привычный корм без необходимости."],
    ["Можно давать лекарства?", "Да, если вы объясните, что, когда и как нужно давать."],
    ["Можно собаке на диван или кровать?", "Можно, если для неё это привычно."],
    ["Будете присылать фото и видео?", "Да, регулярно. Это одна из тех вещей, на которых мы сами не хотим экономить."],
    ["Что если что-то неожиданное случится, пока меня нет?", "Сразу свяжемся с вами и будем решать проблему, а не ждать вашего возвращения. Если ситуация срочная и связана со здоровьем, действуем в интересах собаки, при необходимости обращаемся к ветеринару и сразу сообщаем вам."],
  ],
  cats: [
    ["А если моя кошка вообще не любит других кошек?", "Это не проблема само по себе. У неё может быть отдельная комната, а наших котов можно от неё отделить. Никто не будет заставлять их знакомиться."],
    ["А если она спрячется и не будет выходить?", "Пусть. Мы не будем её вытаскивать и заставлять общаться. Дадим ей время освоиться в своём темпе."],
    ["Можно привезти свой лоток и наполнитель?", "Да, и лучше так и сделать, если кошка к ним привыкла."],
    ["Что если она ест только определённый корм или по особому режиму?", "Расскажите нам, как всё устроено дома, и постараемся делать так же."],
    ["Можно ли ей на диван или кровать?", "Да, если дома ей это можно."],
    ["Какие нужны прививки?", "Нужна действующая core vaccine и прививка от бешенства, обе сделанные не более 12 месяцев назад."],
    ["А если что-то пойдёт не так?", "Не будем просто ждать вашего возвращения. Попробуем разобраться, сразу напишем или позвоним вам и вместе решим, что делать дальше."],
    ["А если кошке внезапно станет плохо?", "Такого у нас пока не было. Но если ситуация будет срочной, мы сначала сделаем то, что нужно животному в моменте, при необходимости обратимся к ветеринару и сразу же свяжемся с вами."],
    ["Будете присылать фото и видео?", "Да, регулярно. Это одна из вещей, которую мы сами считаем очень важной."],
  ],
};
const faq = faqByPage[kind];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: page.h1,
    description: page.description,
    url: `https://getmanov.com${page.path}`,
    areaServed: "Petrovaradin, Novi Sad",
    serviceType: "Домашняя передержка животных",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Главная", item: "https://getmanov.com/" },
      { "@type": "ListItem", position: 2, name: "Передержка животных", item: "https://getmanov.com/ru/novi-sad/pet-sitting/" },
      ...(isMain ? [] : [{ "@type": "ListItem", position: 3, name: page.focus, item: `https://getmanov.com${page.path}` }]),
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map(([question, answer]) => ({
      "@type": "Question",
      name: question,
      acceptedAnswer: { "@type": "Answer", text: answer },
    })),
  },
];
---

<BaseLayout title={page.title} description={page.description} canonical={page.path} lang="ru" structuredData={structuredData}>
  <div class:list={["pet-page", `pet-page--${kind}`]}>
    <section class="pet-hero">
      <div class="pet-hero__copy">
        <p class="eyebrow">Петроварадин · Нови-Сад</p>
        <h1>{page.h1}</h1>
        <p class="pet-hero__lead">{page.lead}</p>
        <p class="pet-hero__price"><strong>{priceLabel}</strong>{isMain && <span>Берём максимум двух гостевых животных одновременно.</span>}</p>
        <div class="pet-actions">
          <a class="pet-button pet-button--primary" href="#dates">Проверить даты</a>
          <a class="pet-button" href={telegram} target="_blank" rel="noreferrer">Написать Ане в Telegram</a>
        </div>
      </div>
      <div class="hero-media">
        {heroPhoto ? (
          <img src={heroPhoto} alt={isDogs ? "Собака на домашней передержке" : isCats ? "Кошка на домашней передержке" : "Питомец на домашней передержке"} width="1200" height="900" />
        ) : (
          <div class="media-placeholder">
            <span>Место для реальной фотографии</span>
            <small>{isDogs ? "собаки-гостя" : isCats ? "кошки-гостя" : "питомца или квартиры"}</small>
          </div>
        )}
      </div>
    </section>

    {isMain && (
      <>
        <section class="routine-section">
          <div><h2>Не гостиница с одним режимом для всех</h2></div>
          <div class="routine-copy">
            <p>У каждого животного свои привычки, и нам кажется странным ломать их только потому, что хозяин уехал.</p>
            <p>Если собака привыкла гулять три раза в день — гуляем три. Если привыкла спать на кровати — можно на кровать. Если кошке нужен определённый корм, лоток и наполнитель — используем их.</p>
            <p>Если питомцу нужно больше внимания или, наоборот, хочется сидеть отдельно и чтобы его никто не трогал — тоже нормально.</p>
            <p><strong>В общем, пытаемся подстроить передержку под животное, а не животное под передержку.</strong></p>
          </div>
        </section>

        <section class="routine-section">
          <div>
            <h2>Как всё устроено дома</h2>
          </div>
          <div class="routine-copy">
            <p>Мы живём в квартире в Петроварадине. В квартире три изолированные комнаты, поэтому животных можно разделить, если кому-то нужно своё пространство.</p>
            <p>Двора и балкона нет. С собакой гуляем на улице столько и тогда, сколько она привыкла.</p>
            <p>На диваны и кровати можно, если дома питомцу тоже можно.</p>
            <p>У нас живут свои кот и кошка, обоим по четыре года. Они уже жили рядом и с собаками, и с другими кошками.</p>
          </div>
        </section>

        <ResidentCats />
        <section class="early-media">
          <div>
            <h2>Как питомцы живут у нас</h2>
            <p>Для нас это вообще важная часть передержки.</p>
            <p>Когда оставляешь животное у других людей, сообщение «всё хорошо» — это одно. А когда видишь, как оно ест, спит, гуляет, валяется на диване или уже освоилось и занимается своими делами, — совсем другое.</p>
            <p>Поэтому будем регулярно присылать вам фото и видео.</p>
          </div>
          <PetMedia photos={photos} videos={videos} label="гостей" />
        </section>

        <section class="intro-section">
          <div><h2>Сначала можно познакомиться</h2><p>Перед первой передержкой можно бесплатно прийти к нам домой примерно на полчаса.</p><p>Вы познакомитесь с нами, посмотрите квартиру, питомец всё понюхает и осмотрится, а мы посмотрим, как все друг на друга реагируют.</p><p>Если хочется проверить чуть серьёзнее, можно оставить собаку или кошку <strong>тестово на несколько часов — 1 000 RSD</strong>.</p></div>
          <div><h2>Что взять с собой</h2><p>Всё, что помогает питомцу жить примерно так же, как дома.</p><p>Корм, миски, поводок, переноску, лекарства, игрушки, любимую лежанку — если она ему нужна. Для кошки можно привезти привычный лоток и наполнитель.</p><p>Если есть какой-нибудь особенный ритуал, режим или странная привычка — просто расскажите нам.</p></div>
        </section>
        <PetSittingCalendar />
        <PetPricing />
      </>
    )}

    {isDogs && (
      <>
        <section class="species-intro dog-routine">
          <div><h2>Не будем переучивать вашу собаку за неделю</h2></div>
          <div><p>Передержка — не самое подходящее время внезапно вводить новые правила.</p><p>Поэтому сначала мы спрашиваем, <strong>как собака живёт дома</strong>, и стараемся делать примерно так же.</p><p>Сколько прогулок? Когда еда? Где спит? Можно ли на диван? Нормально ли остаётся одна?</p><p>Если какой-то режим для неё важен — лучше просто рассказать нам заранее.</p></div>
        </section>

        <section class="dog-cats-section">
          <div><h2>А если она не остаётся одна?</h2><p>Такое тоже бывает.</p><p>Если собака не умеет спокойно оставаться дома без человека, скажите об этом до передержки. Мы можем договориться так, чтобы в период её проживания кто-то из нас был дома.</p></div>
          <div class="plain-note"><p>Это не универсальное обещание для любой брони — поэтому такую потребность важно обсудить заранее.</p></div>
        </section>

        <section class="dog-cats-section">
          <div><h2>У нас живут два кота</h2><p>И это лучше проверить заранее, если вы не знаете, как собака относится к кошкам.</p><p>Обычный интерес, желание понюхать, познакомиться или поиграть — не повод сразу отказываться от передержки.</p><p>Другое дело, если собака именно <strong>охотится за кошками, не может переключиться или проявляет серьёзную агрессию</strong>. В таком случае честнее будет выбрать ситтера без своих кошек.</p><p>Для этого у нас и есть бесплатное знакомство до передержки.</p></div>
          <div class="plain-note"><h2>А если они просто не понравятся друг другу?</h2><p>Ничего страшного.</p><p>У нас три изолированные комнаты, и никому не обязательно становиться лучшими друзьями.</p><p>Можно разделить животных и сделать так, чтобы у каждого оставалось своё пространство.</p><p>При этом собака всё равно будет общаться с нами, гулять и жить своей обычной жизнью.</p></div>
        </section>

        <section class="dog-trial">
          <h2>Можно сначала проверить, как всё пройдёт</h2>
          <p>Перед первой передержкой можно <strong>бесплатно прийти к нам примерно на 30 минут</strong>.</p>
          <p>Собака познакомится с нами, квартирой и котами, а вы сами увидите, где она будет жить.</p>
          <p>Если хочется проверить именно пребывание без хозяина, можно оставить её <strong>на несколько часов за 1 000 RSD</strong>.</p>
        </section>
        <section class="intro-section"><div><h2>Гуляем столько, сколько собака привыкла</h2><p>Не будет правила «всем собакам две прогулки по двадцать минут».</p><p>Если ваша собака привыкла к определённому графику — расскажите нам, и будем его соблюдать настолько близко, насколько можем.</p><p>То же самое с кормлением, лекарствами и другими привычными вещами.</p></div><div><h2>Можно на кровать?</h2><p>Да.</p><p>Если собака дома спит на лежанке — можно привезти её лежанку.</p><p>Если привыкла лежать на диване — пожалуйста.</p><p>Если привыкла спать с человеком на кровати — у нас нет принципиального запрета и на это.</p></div></section>
        <section class="early-media"><div><h2>Фото и видео каждый день</h2><p>Будем показывать вам не только парадное «всё хорошо», а нормальную жизнь собаки у нас.</p><p>Прогулки, сон, игры, валяние на диване, знакомство с котами — то, что реально происходит.</p></div><PetMedia photos={photos} videos={videos} label="собак-гостей" /></section>
        <PetSittingCalendar />
        <PetPricing />
      </>
    )}

    {isCats && (
      <>
        <section class="cat-safe-space">
          <div class="cat-safe-space__copy"><h2>Если кошка не любит других кошек — это нормально</h2><p>У нас живут свои кот и кошка, но вашей кошке совершенно не обязательно с ними дружить.</p><p>В квартире три изолированные комнаты. Если ей спокойнее жить отдельно, можно сделать ей своё пространство и вообще не заставлять знакомиться.</p></div>
          <div class="cat-list"><p>Наши коты уже привыкли к другим животным, а если гость хочет сидеть в своей комнате и никого не видеть — тоже ок.</p></div>
        </section>

        <section class="routine-section"><div><h2>Стараемся оставить всё как дома</h2></div><div class="routine-copy"><p>Не будем специально менять привычки кошки только потому, что она приехала на передержку.</p><p>Привозите её обычный корм, миски, лоток, привычный наполнитель, игрушки, лекарства — в общем всё, что помогает ей чувствовать себя нормально.</p><p>Если она первые дни хочет спрятаться и не выходить — пусть прячется. Если привыкла спать на кровати — можно на кровать. Если нужен отдельный тихий угол — сделаем.</p></div></section>
        <ResidentCats compact={true} note="Но дружить с ними вашей кошке вообще не обязательно." showSeparationNote={false} />
        <section class="early-media"><div><h2>Фото и видео</h2><p>Да, будем присылать много :)</p><p>Нам самим спокойнее, когда мы оставляем животное и можем видеть не просто сообщение «всё хорошо», а как оно ест, спит, ходит по квартире и постепенно осваивается.</p><p>Поэтому фото и видео во время передержки — это для нас обычная часть процесса.</p></div><PetMedia photos={photos} videos={videos} label="кошек-гостей" /></section>

        <section class="cat-arrival">
          <div><h2>Знакомство до передержки</h2><p>Если хочется, перед первой передержкой можно бесплатно прийти к нам примерно на полчаса.</p><p>Посмотрите квартиру, познакомитесь с нами, кошка сможет немного осмотреться, а мы посмотрим, как она реагирует на новое место и наших котов.</p></div>
          <p class="cat-arrival__note">Можно также оставить кошку тестово на несколько часов — это стоит <strong>1 000 RSD</strong>.</p>
        </section>
        <PetSittingCalendar />
        <PetPricing />
      </>
    )}

    <section class="faq-section" id="faq">
      <div><p class="eyebrow">Частые вопросы</p><h2>{isDogs ? "О передержке собак" : isCats ? "О передержке кошек" : "Что обычно спрашивают"}</h2></div>
      <div class="faq-list">{faq.map(([question, answer], index) => <details open={index === 0}><summary>{question}</summary><p>{answer}</p></details>)}</div>
    </section>

    <section class="related-section" aria-labelledby="related-title">
      <p class="eyebrow">Подробнее</p><h2 id="related-title">{isMain ? "Отдельно о собаках и кошках" : "Другие страницы передержки"}</h2>
      <nav>{related.map((item) => <a href={petSittingPages[item].path}>{petSittingPages[item].h1}<span>→</span></a>)}</nav>
    </section>

    <section class="final-cta">
      <div><p class="eyebrow">Петроварадин</p><h2>Напишите Ане и расскажите, на какие даты нужна передержка</h2></div>
      <a class="pet-button pet-button--primary" href={telegram} target="_blank" rel="noreferrer">Написать Ане в Telegram</a>
    </section>
  </div>
</BaseLayout>

<style is:inline>
  html[lang="ru"] { scroll-padding-top:84px; }
