---
import { petSittingConfig, type PetSittingPageKind } from "../data/pet-sitting";
import { petSittingBillingFaq } from "../data/pet-sitting-faq";
import { petSittingBusiness } from "../lib/pet-sitting-business.mjs";

const {
  locale = "ru",
  kind = "main",
  sourcePage,
  articleSlug = "",
  toolType = "full_enquiry",
} = Astro.props as {
  locale?: "ru" | "en";
  kind?: PetSittingPageKind;
  sourcePage?: string;
  articleSlug?: string;
  toolType?: string;
};
const isEnglish = locale === "en";
const defaultAnimal = kind === "cats" ? "cat" : "dog";
const billingFaq = petSittingBillingFaq[locale];
const phoneDigits = petSittingConfig.contactPhone.replace(/\D/g, "");
const telegramDirectUrl = `https://t.me/${petSittingConfig.telegramUsername}`;
const whatsappDirectUrl = `https://wa.me/${phoneDigits}`;
const viberDirectUrl = `viber://chat?number=${encodeURIComponent(petSittingConfig.contactPhone)}`;
const config = {
  initialMonth: petSittingConfig.initialMonth,
  unavailablePeriods: petSittingConfig.unavailablePeriods,
  telegramUsername: petSittingConfig.telegramUsername,
  contactPhone: petSittingConfig.contactPhone,
  locale,
  pageKind: kind,
  pageLabel: petSittingBusiness.pageLabels[locale][kind],
  sourcePage: sourcePage ?? petSittingBusiness.pagePaths[locale][kind],
  articleSlug,
  toolType,
};
---

<section id="dates" class="availability" aria-labelledby="availability-title" data-pet-calendar={JSON.stringify(config)}>
  <div class="availability__intro">
    <p class="eyebrow">{isEnglish ? "Availability" : "Календарь"}</p>
    <h2 id="availability-title">{isEnglish ? "Check available dates" : "Проверить даты"}</h2>
    <p>{isEnglish ? "Choose approximate dates for the stay. We update the calendar manually and will confirm availability in Telegram." : "Выберите примерные даты проживания. Календарь обновляем вручную: свободные даты окончательно подтвердим в Telegram."}</p>
  </div>

  <div class="calendar-panel">
    <div class="calendar-panel__header">
      <div>
        <strong>{isEnglish ? "Choose arrival and departure" : "Выберите заезд и выезд"}</strong>
        <p id="calendar-status" aria-live="polite">{isEnglish ? "First choose an arrival date." : "Сначала выберите дату заезда."}</p>
      </div>
      <div class="calendar-controls" aria-label={isEnglish ? "Month navigation" : "Навигация по месяцам"}>
        <button type="button" class="calendar-nav" data-calendar-prev aria-label={isEnglish ? "Previous month" : "Предыдущий месяц"}>←</button>
        <button type="button" class="calendar-nav" data-calendar-next aria-label={isEnglish ? "Next month" : "Следующий месяц"}>→</button>
      </div>
    </div>
    <div class="calendar-months" data-calendar-months></div>

    <form class="inquiry-form" data-inquiry-form novalidate>
      <div class="inquiry-summary" data-inquiry-summary>{isEnglish ? "No dates selected yet." : "Даты пока не выбраны."}</div>
      <div class="inquiry-price" data-inquiry-price hidden aria-live="polite"></div>
      <a class="inquiry-price-help" data-inquiry-price-help href="#boarding-days" hidden>
        {billingFaq.helpLabel}
      </a>
      <div class="inquiry-details" data-inquiry-details>
        <label class="checkbox-label">
          <input type="checkbox" name="flexible" />
          <span>{isEnglish ? "Approximate dates — we can move them slightly" : "Даты примерные, можем немного сдвинуть"}</span>
        </label>
        <div class="inquiry-fields">
          <label>{isEnglish ? "Pet" : "Питомец"}
            <select name="animal">
              <option value="dog" selected={defaultAnimal === "dog"}>{isEnglish ? "dog" : "собака"}</option>
              <option value="cat" selected={defaultAnimal === "cat"}>{isEnglish ? "cat" : "кошка"}</option>
            </select>
          </label>
          <label>{isEnglish ? "Number of pets" : "Количество"}
            <select name="quantity">
              <option value="1">1</option>
              <option value="2">2</option>
            </select>
          </label>
          <label>{isEnglish ? "Your Telegram" : "Ваш Telegram"}
            <input name="username" type="text" inputmode="text" autocomplete="username" placeholder="@username" pattern="@?[A-Za-z0-9_]{5,32}" required aria-describedby="telegram-help" />
            <small id="telegram-help">{isEnglish ? "Anna needs this to reply quickly." : "Нужен, чтобы Анна могла быстро ответить."}</small>
          </label>
        </div>
        <div class="inquiry-honeypot" aria-hidden="true">
          <label>Website<input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
        </div>
        <button class="enquiry-submit" type="submit" data-enquiry-submit disabled>{isEnglish ? "Send enquiry" : "Отправить заявку"}</button>
        <p class="form-note" data-form-note role="status" aria-live="polite">{isEnglish ? "Choose dates and enter your Telegram username." : "Выберите даты и укажите Telegram username."}</p>

        <div class="direct-contact" data-direct-contact-group>
          <p>{isEnglish ? "Or message us directly" : "Или написать напрямую"}</p>
          <div class="direct-contact__links">
            <a href={telegramDirectUrl} data-direct-contact data-channel="telegram" target="_blank" rel="noreferrer">Telegram · @{petSittingConfig.telegramUsername}</a>
            {isEnglish && <a href={whatsappDirectUrl} data-direct-contact data-channel="whatsapp" target="_blank" rel="noreferrer">WhatsApp</a>}
            {isEnglish && <a href={viberDirectUrl} data-direct-contact data-channel="viber">Viber</a>}
          </div>
        </div>
      </div>
    </form>
  </div>
</section>

<script>
  import { isDateUnavailable, rangeHasUnavailable } from "../lib/pet-sitting-calendar.mjs";
  import { calculatePetSittingQuote, formatRsd, formatRussianStayDuration } from "../lib/pet-sitting-business.mjs";

  const root = document.querySelector('[data-pet-calendar]');
  if (root) {
    const settings = JSON.parse(root.dataset.petCalendar || '{}');
    const isEnglish = settings.locale === 'en';
    const monthsNode = root.querySelector('[data-calendar-months]');
    const status = root.querySelector('#calendar-status');
    const summary = root.querySelector('[data-inquiry-summary]');
    const priceSummary = root.querySelector('[data-inquiry-price]');
    const priceHelp = root.querySelector('[data-inquiry-price-help]');
    const form = root.querySelector('[data-inquiry-form]');
    const formNote = root.querySelector('[data-form-note]');
    const submitButton = root.querySelector('[data-enquiry-submit]');
    const telegramLink = root.querySelector('[data-channel="telegram"]');
    const whatsappLink = root.querySelector('[data-channel="whatsapp"]');
    const today = new Date();
    const todayKey = toKey(today.getFullYear(), today.getMonth(), today.getDate());
    const unavailable = settings.unavailablePeriods || [];
    const monthNames = isEnglish
      ? ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']
      : ['Январь', 'Февраль', 'Март', 'Апрель', 'Май', 'Июнь', 'Июль', 'Август', 'Сентябрь', 'Октябрь', 'Ноябрь', 'Декабрь'];
    const weekdays = isEnglish ? ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'] : ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс'];
    const currentMonth = new Date(today.getFullYear(), today.getMonth(), 1);
    const initialMonthMatch = /^(\d{4})-(0[1-9]|1[0-2])$/.exec(settings.initialMonth || '');
    const configuredInitialMonth = initialMonthMatch
      ? new Date(Number(initialMonthMatch[1]), Number(initialMonthMatch[2]) - 1, 1)
      : currentMonth;
    let cursor = configuredInitialMonth > currentMonth ? configuredInitialMonth : currentMonth;
    let start = '';
    let end = '';
    let submitting = false;
    let feedbackState = 'idle';
    let availabilityTracked = false;
    let enquiryTracked = false;

    function toKey(year, month, day) {
      return `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
    }
    function fromKey(key) {
      const [year, month, day] = key.split('-').map(Number);
      return new Date(year, month - 1, day);
    }
    function isUnavailable(key) {
      return isDateUnavailable(key, unavailable);
    }
    function isPast(key) { return key < todayKey; }
    function formatDate(key) {
      return new Intl.DateTimeFormat(isEnglish ? 'en-GB' : 'ru-RU', { day: 'numeric', month: 'long' }).format(fromKey(key));
    }
    function normalizeUsername(value) {
      const trimmed = value.trim();
      return trimmed && !trimmed.startsWith('@') ? `@${trimmed}` : trimmed;
    }
    function currentQuote() {
      return calculatePetSittingQuote(start, end, form.querySelector('[name="quantity"]').value);
    }
    function createPriceLine(text, className = '') {
      const line = document.createElement('p');
      line.textContent = text;
      if (className) line.className = className;
      return line;
    }
    function renderPrice(quote) {
      priceSummary.replaceChildren();
      priceSummary.hidden = !quote;
      priceHelp.hidden = !quote;
      if (!quote) return;

      priceSummary.append(createPriceLine(
        isEnglish ? `${quote.billableDays} days of stay` : formatRussianStayDuration(quote.billableDays),
        'inquiry-price__duration',
      ));
      if (quote.individualPricing) {
        priceSummary.append(createPriceLine(
          isEnglish ? "For longer stays, we'll agree the price individually." : 'Для длительной передержки цену обсуждаем отдельно.',
        ));
        return;
      }

      const quantityLabel = isEnglish
        ? quote.quantity === 1 ? '1 pet' : '2 pets'
        : quote.quantity === 1 ? '1 животное' : '2 животных';
      const rate = `${formatRsd(quote.dailyRate, settings.locale)} RSD/${isEnglish ? 'day' : 'день'}`;
      priceSummary.append(createPriceLine(`${quantityLabel} · ${rate}`));
      priceSummary.append(createPriceLine(
        isEnglish ? `Estimated price: ${formatRsd(quote.total, 'en')} RSD` : `Предварительная стоимость: ${formatRsd(quote.total, 'ru')} RSD`,
        'inquiry-price__total',
      ));
    }
    function directMessage(quote, username) {
      const animalValue = form.querySelector('[name="animal"]').value;
      const animal = isEnglish ? animalValue : animalValue === 'dog' ? 'собака' : 'кошка';
      const flexible = form.querySelector('[name="flexible"]').checked ? (isEnglish ? 'yes' : 'да') : (isEnglish ? 'no' : 'нет');
      const price = quote.individualPricing
        ? isEnglish ? 'discuss individually' : 'обсуждается отдельно'
        : `${formatRsd(quote.total, settings.locale)} RSD`;
      return isEnglish
        ? `Hello! I'd like to ask about pet boarding.\n\nDates: ${formatDate(start)} — ${formatDate(end)}\nLength: ${quote.billableDays} days of stay\nPet: ${animal}\nNumber of pets: ${quote.quantity}\nDates flexible: ${flexible}\nEstimated price: ${price}\nMy Telegram: ${username}`
        : `Здравствуйте! Хочу уточнить передержку.\n\nДаты: ${formatDate(start)} — ${formatDate(end)}\nСрок: ${formatRussianStayDuration(quote.billableDays)}\nПитомец: ${animal}\nКоличество: ${quote.quantity}\nДаты примерные: ${flexible}\nРасчётная цена: ${price}\nМой Telegram: ${username}`;
    }
    function trackEvent(name, parameters = {}) {
      if (typeof window.gtag !== 'function') return;
      window.gtag('event', name, {
        source_page: settings.sourcePage,
        locale: settings.locale,
        article_slug: settings.articleSlug || undefined,
        tool_type: settings.toolType,
        ...parameters,
      });
    }
    function updateDirectLinks(quote, username) {
      const telegramBase = `https://t.me/${settings.telegramUsername}`;
      const whatsappBase = `https://wa.me/${String(settings.contactPhone).replace(/\D/g, '')}`;
      if (!quote) {
        telegramLink.href = telegramBase;
        if (whatsappLink) whatsappLink.href = whatsappBase;
        return;
      }
      const message = directMessage(quote, username);
      telegramLink.href = `${telegramBase}?text=${encodeURIComponent(message)}`;
      if (whatsappLink) whatsappLink.href = `${whatsappBase}?text=${encodeURIComponent(message)}`;
    }
    function renderFeedback(validUsername) {
      formNote.classList.toggle('is-success', feedbackState === 'success');
      formNote.classList.toggle('is-error', feedbackState === 'error');
      if (feedbackState === 'sending') {
        formNote.textContent = isEnglish ? 'Sending enquiry…' : 'Отправляем заявку…';
      } else if (feedbackState === 'success') {
        formNote.textContent = isEnglish ? "Sent! We'll reply to you on Telegram." : 'Готово! Заявка отправлена. Ответим вам в Telegram.';
      } else if (feedbackState === 'error') {
        formNote.textContent = isEnglish ? "Couldn't send the enquiry. You can message us directly instead." : 'Не получилось отправить заявку. Можно написать нам напрямую.';
      } else if (!start || !end) {
        formNote.textContent = isEnglish ? 'Choose arrival and departure dates.' : 'Выберите даты заезда и выезда.';
      } else if (!validUsername) {
        formNote.textContent = isEnglish ? 'Enter your Telegram username: @username.' : 'Укажите Telegram username: @username.';
      } else {
        formNote.textContent = isEnglish ? 'Ready to send. We will reply in Telegram.' : 'Можно отправлять. Ответим в Telegram.';
      }
    }
    function updateInquiry() {
      const quote = currentQuote();
      const usernameInput = form.querySelector('[name="username"]');
      const rawUsername = usernameInput.value.trim();
      const username = normalizeUsername(rawUsername);
      const validUsername = /^@[A-Za-z0-9_]{5,32}$/.test(username);
      usernameInput.setAttribute('aria-invalid', String(rawUsername.length > 0 && !validUsername));

      summary.textContent = quote
        ? isEnglish
          ? `Dates: ${formatDate(start)} — ${formatDate(end)} · ${quote.billableDays} days of stay`
          : `Даты: ${formatDate(start)} — ${formatDate(end)} · ${formatRussianStayDuration(quote.billableDays)}`
        : isEnglish ? 'No dates selected yet.' : 'Даты пока не выбраны.';
      status.textContent = quote
        ? isEnglish ? `Selected: ${formatDate(start)} — ${formatDate(end)}.` : `Выбрано: ${formatDate(start)} — ${formatDate(end)}.`
        : start
          ? isEnglish ? `Arrival: ${formatDate(start)}. Now choose a departure date.` : `Заезд: ${formatDate(start)}. Теперь выберите выезд.`
          : isEnglish ? 'First choose an arrival date.' : 'Сначала выберите дату заезда.';

      renderPrice(quote);
      updateDirectLinks(quote, username);
      renderFeedback(validUsername);
      const canSubmit = Boolean(quote && validUsername && !submitting && feedbackState !== 'success');
      submitButton.disabled = !canSubmit;
      submitButton.textContent = feedbackState === 'sending'
        ? isEnglish ? 'Sending…' : 'Отправляем…'
        : isEnglish ? 'Send enquiry' : 'Отправить заявку';
      return { quote, username, validUsername, canSubmit };
    }
    function choose(key) {
      if (isPast(key) || isUnavailable(key)) return;
      if (settings.articleSlug && !availabilityTracked) {
        availabilityTracked = true;
        trackEvent('pet_sitting_article_availability_open');
      }
      feedbackState = 'idle';
      if (!start || end || key < start) {
        start = key;
        end = '';
      } else if (key === start) {
        start = '';
      } else if (rangeHasUnavailable(start, key, unavailable)) {
        status.textContent = isEnglish ? 'The selected range contains an unavailable date. Choose different dates.' : 'В выбранном диапазоне есть недоступная дата. Выберите другие даты.';
        return;
      } else {
        end = key;
      }
      render();
      updateInquiry();
    }
    function renderMonth(monthDate) {
      const year = monthDate.getFullYear();
      const month = monthDate.getMonth();
      const firstWeekday = (new Date(year, month, 1).getDay() + 6) % 7;
      const days = new Date(year, month + 1, 0).getDate();
      const panel = document.createElement('section');
      panel.className = 'calendar-month';
      panel.setAttribute('aria-label', `${monthNames[month]} ${year}`);
      panel.innerHTML = `<h3>${monthNames[month]} ${year}</h3><div class="calendar-weekdays">${weekdays.map((day) => `<span>${day}</span>`).join('')}</div><div class="calendar-days"></div>`;
      const daysNode = panel.querySelector('.calendar-days');
      for (let blank = 0; blank < firstWeekday; blank += 1) daysNode.append(document.createElement('span'));
      for (let day = 1; day <= days; day += 1) {
        const key = toKey(year, month, day);
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = String(day);
        button.dataset.date = key;
        button.disabled = isPast(key) || isUnavailable(key);
        button.setAttribute('aria-label', `${formatDate(key)}${isUnavailable(key) ? (isEnglish ? ', unavailable' : ', недоступно') : ''}`);
        if (isUnavailable(key)) button.classList.add('is-unavailable');
        if (key === start || key === end) button.classList.add('is-selected');
        if (start && end && key > start && key < end) button.classList.add('is-in-range');
        button.addEventListener('click', () => choose(key));
        daysNode.append(button);
      }
      return panel;
    }
    function render() {
      monthsNode.replaceChildren(renderMonth(cursor), renderMonth(new Date(cursor.getFullYear(), cursor.getMonth() + 1, 1)));
      root.querySelector('[data-calendar-prev]').disabled = cursor.getFullYear() === today.getFullYear() && cursor.getMonth() === today.getMonth();
    }

    root.querySelector('[data-calendar-prev]').addEventListener('click', () => { cursor = new Date(cursor.getFullYear(), cursor.getMonth() - 1, 1); render(); });
    root.querySelector('[data-calendar-next]').addEventListener('click', () => { cursor = new Date(cursor.getFullYear(), cursor.getMonth() + 1, 1); render(); });
    form.addEventListener('input', () => {
      if (settings.articleSlug && !enquiryTracked) {
        enquiryTracked = true;
        trackEvent('pet_sitting_article_enquiry_start');
      }
      if (!submitting) feedbackState = 'idle';
      updateInquiry();
    });
    form.addEventListener('focusin', () => {
      if (!settings.articleSlug || enquiryTracked) return;
      enquiryTracked = true;
      trackEvent('pet_sitting_article_enquiry_start');
    });
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submitting) return;
      const current = updateInquiry();
      if (!current.canSubmit) return;

      submitting = true;
      feedbackState = 'sending';
      trackEvent('pet_sitting_enquiry_submit');
      updateInquiry();
      try {
        const response = await fetch('/.netlify/functions/pet-sitting-inquiry', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            arrival: start,
            departure: end,
            pet: form.querySelector('[name="animal"]').value,
            quantity: Number(form.querySelector('[name="quantity"]').value),
            flexible: form.querySelector('[name="flexible"]').checked,
            telegramUsername: current.username,
            website: form.querySelector('[name="website"]').value,
            locale: settings.locale,
            pageKind: settings.pageKind,
            sourcePage: settings.sourcePage,
          }),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !result.ok) throw new Error('submission_failed');
        feedbackState = 'success';
        trackEvent('pet_sitting_enquiry_success');
      } catch {
        feedbackState = 'error';
        trackEvent('pet_sitting_enquiry_error');
      } finally {
        submitting = false;
        updateInquiry();
      }
    });
    root.querySelectorAll('[data-direct-contact]').forEach((link) => {
      link.addEventListener('click', () => trackEvent('pet_sitting_direct_contact_click', { channel: link.dataset.channel }));
    });
    render();
    updateInquiry();
  }
</script>

<style is:global>
  .availability {
    --ink:#20332f;
    --muted:#52645d;
    --line:#d9e2dc;
    --accent:#275f4b;
    display:grid;
    width:min(1160px,100%);
    grid-template-columns:260px 1fr;
    gap:38px;
    align-items:start;
    margin-inline:auto;
    padding:72px 0;
    border-top:1px solid var(--line);
  }
  .availability * { box-sizing:border-box;min-width:0; }
  .availability .availability__intro h2 { margin:0;padding:0;border:0;font-size:38px;line-height:1.06;letter-spacing:-.04em; }
  .availability__intro>p:not(.eyebrow) { color:var(--muted);line-height:1.5; }
  .calendar-panel { display:grid;grid-template-columns:minmax(420px,1.15fr) minmax(260px,.85fr);gap:24px 30px;border-top:1px solid var(--ink);padding-top:18px; }
  .calendar-panel__header { grid-column:1;display:flex;justify-content:space-between;gap:12px; }
  .calendar-panel__header p { margin:4px 0 0;color:var(--muted);font-size:13px; }
  .calendar-controls { display:flex;gap:6px; }
  .calendar-nav { width:34px;height:34px;border:1px solid var(--line);border-radius:50%;background:transparent;color:var(--ink);font:inherit;cursor:pointer; }
  .calendar-nav:disabled { opacity:.3; }
  .calendar-months { grid-column:1;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px; }
  .calendar-month h3 { margin:0 0 9px;font-size:15px; }
  .calendar-weekdays,.calendar-days { display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:2px; }
  .calendar-weekdays span { color:var(--muted);font-size:10px;text-align:center; }
  .calendar-days { margin-top:4px; }
  .calendar-days button { width:100%;aspect-ratio:1;border:0;border-radius:5px;background:transparent;color:var(--ink);font:inherit;font-size:12px;cursor:pointer; }
  .calendar-days button:hover:not(:disabled),.calendar-days button:focus-visible { outline:2px solid var(--accent);outline-offset:0; }
  .calendar-days button:disabled { color:#b5bdb8;cursor:not-allowed; }
  .calendar-days .is-unavailable { background:repeating-linear-gradient(-45deg,#efded9 0 3px,#faf6f1 3px 6px);color:#9d665d;text-decoration:line-through; }
  .calendar-days .is-selected { background:var(--accent);color:#fff; }
  .calendar-days .is-in-range { border-radius:0;background:#dbe9e0; }
  .inquiry-form { position:relative;grid-column:2;grid-row:1 / span 2;display:grid;align-content:start;gap:13px;padding-left:28px;border-left:1px solid var(--line); }
  .inquiry-summary { font-weight:750; }
  .inquiry-price { display:grid;gap:3px;border:1px solid #cddcd3;border-radius:8px;padding:11px 12px;background:#f1f6f3; }
  .inquiry-price[hidden],.inquiry-price-help[hidden] { display:none; }
  .inquiry-price p { margin:0;color:var(--muted);font-size:12px;line-height:1.4; }
  .inquiry-price .inquiry-price__duration,.inquiry-price .inquiry-price__total { color:var(--ink);font-weight:800; }
  .inquiry-price-help { width:max-content;max-width:100%;margin-top:-7px;color:var(--accent);font-size:12px;font-weight:700;text-underline-offset:3px; }
  .inquiry-details { display:grid;gap:13px; }
  .checkbox-label { display:flex;align-items:flex-start;gap:8px;font-size:13px; }
  .checkbox-label input { margin-top:3px; }
  .inquiry-fields { display:grid;grid-template-columns:1fr 1fr;gap:10px; }
  .inquiry-fields label { display:grid;gap:4px;color:var(--muted);font-size:12px; }
  .inquiry-fields label:last-child { grid-column:1 / -1; }
  .inquiry-fields select,.inquiry-fields input { width:100%;min-height:39px;border:1px solid var(--line);border-radius:6px;background:#fff;color:var(--ink);padding:7px 9px;font:inherit; }
  .inquiry-fields small,.form-note { color:var(--muted);font-size:11px; }
