---
const { locale } = Astro.props as { locale: "en" | "sr" };
const copy = locale === "sr"
  ? { whatsapp: "Pošaljite Ani poruku na WhatsApp", viber: "Pošaljite Ani poruku na Viber" }
  : { whatsapp: "Message Anna on WhatsApp", viber: "Message Anna on Viber" };
---

<span class="pet-messaging-links" aria-label={locale === "sr" ? "Dodatne aplikacije za poruke" : "Additional messaging apps"}>
  <a href="https://wa.me/381628426881" target="_blank" rel="noopener noreferrer" aria-label={copy.whatsapp} title={copy.whatsapp}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.52 3.48A11.8 11.8 0 0 0 12.13 0C5.58 0 .25 5.32.25 11.87c0 2.09.55 4.13 1.59 5.93L.15 24l6.36-1.67a11.9 11.9 0 0 0 5.62 1.43h.01c6.55 0 11.88-5.33 11.88-11.88 0-3.17-1.24-6.15-3.5-8.4ZM12.14 21.7a9.85 9.85 0 0 1-5.02-1.37l-.36-.21-3.77.99 1.01-3.67-.24-.38a9.8 9.8 0 0 1-1.5-5.2c0-5.44 4.43-9.86 9.87-9.86a9.8 9.8 0 0 1 6.98 2.89A9.8 9.8 0 0 1 22 11.87c0 5.44-4.43 9.87-9.87 9.87Zm5.41-7.39c-.3-.15-1.77-.87-2.05-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.18.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.47-.89-.8-1.49-1.78-1.66-2.08-.18-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.08-.79.38-.28.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.2 5.09 4.49.71.3 1.26.49 1.7.62.71.23 1.36.2 1.87.12.57-.08 1.77-.72 2.02-1.42.25-.7.25-1.3.18-1.42-.08-.12-.28-.2-.58-.35Z"/></svg>
  </a>
  <a href="viber://chat?number=%2B381628426881" aria-label={copy.viber} title={copy.viber}>
    <img class="viber-logo" src="/images/viber-icon.svg" width="21" height="22" alt="" aria-hidden="true" />
  </a>
</span>

<style>
  .pet-messaging-links { display:inline-flex; align-items:center; gap:8px; margin-inline-start:2px; vertical-align:middle; }
  .pet-messaging-links a { display:inline-flex; width:38px; height:38px; align-items:center; justify-content:center; border:1px solid #cbd8d1; border-radius:50%; background:#fff; color:#20332f; text-decoration:none; }
  .pet-messaging-links a:first-child:hover { color:#168b55; border-color:#168b55; }
  .pet-messaging-links a:last-child:hover { color:#665cac; border-color:#665cac; }
  .pet-messaging-links svg { width:21px; height:21px; fill:currentColor; }
  .pet-messaging-links .viber-logo { width:21px; height:22px; object-fit:contain; }
</style>
